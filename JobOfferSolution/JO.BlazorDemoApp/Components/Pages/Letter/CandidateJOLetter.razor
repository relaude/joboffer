<div class="card shadow mb-4 small">
    <div class="card-header py-3">
        <h6 class="jo-title mb-1">
            <i class="fas fa-envelope fa-fw text-primary mr-2" aria-hidden="true"></i>Email Preview
        </h6>
        <small class="text-muted">Update the email, save a draft, or submit it for approval.</small>
    </div>

    <div class="card-body">
        @if (loadError is not null)
        {
            <div class="alert alert-danger" role="alert">@loadError</div>
        }
        <div class="form-group row align-items-center">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="@ElementId("email-preview-to")">To</label>
            <div class="col-sm-10">
                <input id="@ElementId("email-preview-to")" type="text" inputmode="email" class="form-control"
                       @bind="jobOfferEmail.ToRecipient" @bind:event="oninput" readonly="@IsReadOnly" disabled="@(isLoadingMessage || loadError is not null || isSaving || isSendingTestMail)" />
            </div>
        </div>

        <div class="form-group row align-items-center">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="@ElementId("email-preview-cc")">CC</label>
            <div class="col-sm-10">
                <input id="@ElementId("email-preview-cc")" type="text" inputmode="email" class="form-control"
                       @bind="jobOfferEmail.CCRecipient" @bind:event="oninput" readonly="@IsReadOnly" disabled="@(isLoadingMessage || loadError is not null || isSaving || isSendingTestMail)" />
            </div>
        </div>

        <div class="form-group row align-items-center border-bottom pb-4">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="@ElementId("email-preview-subject")">Subject</label>
            <div class="col-sm-10">
                <input id="@ElementId("email-preview-subject")" type="text" class="form-control"
                       @bind="jobOfferEmail.Subject" @bind:event="oninput" readonly="@IsReadOnly" disabled="@(isLoadingMessage || loadError is not null || isSaving || isSendingTestMail)" />
            </div>
        </div>

        <div class="form-group mb-4">
            <div id="@ElementId("email-preview-message-label")" class="font-weight-bold text-gray-700 mb-2">Message</div>
            @if (isLoadingMessage)
            {
                <div class="text-muted" role="status">Loading email message...</div>
            }
            else if (loadError is null && IsReadOnly)
            {
                <div class="border rounded p-3" role="region" aria-labelledby="@ElementId("email-preview-message-label")"
                     style="overflow-wrap: anywhere; overflow-x: auto;">@((MarkupString)(jobOfferEmail.EmailMessage ?? string.Empty))</div>
            }
            else if (loadError is null)
            {
                <div role="group" aria-labelledby="@ElementId("email-preview-message-label")"
                     @oninput="UpdateEmailMessageAsync" @onfocusout="UpdateEmailMessageAsync">
                    <TextEditor @ref="messageEditor" @key="jobOfferId"
                                Toolbar="new Toolbar { ShowFullToolbar = true }"
                                EditorContainerId="@ElementId("email-preview-message")"
                                Placeholder="Write the email message here..." />
                </div>
            }
        </div>

        <fieldset class="mb-0">
            <legend class="small font-weight-bold text-gray-700 mb-3">
                <i class="fas fa-paperclip fa-fw mr-1" aria-hidden="true"></i>Attachments
            </legend>
            @if (!IsReadOnly)
            {
            <button type="button" class="btn btn-outline-primary btn-sm mb-3" @onclick="ShowAttachOptionAsync"
                    disabled="@IsAttachOptionDisabled">Attach File</button>
            }
            <p class="text-muted">Saving requires exactly one option PDF. A benefits PDF is optional and can be added or removed. Remove the current option before attaching another.</p>
            @if (isLoadingMessage)
            {
                <p class="text-muted" role="status">Loading attachments...</p>
            }
            else if (loadError is not null)
            {
                <p class="text-muted">Attachments could not be loaded.</p>
            }
            else if (attachments.Count == 0)
            {
                <p class="text-muted">No attachments.</p>
            }
            else
            {
                @foreach (var attachment in attachments)
                {
                    <div class="border rounded bg-light p-3 mb-2" @key="attachment.Id">
                        <i class="fas fa-paperclip mr-2" aria-hidden="true"></i>
                        @if (IsPdfAttachment(attachment))
                        {
                            <a href="@(JORoutes.Private.ViewJOEmailAttachPdf + "/" + attachment.Id)"
                               target="_blank" rel="noopener noreferrer" title="View PDF in a new tab">@attachment.FileName</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link p-0 align-baseline" disabled="@isDownloadingAttachment"
                                    @onclick="() => DownloadAttachmentAsync(attachment)" title="Download attachment for review">@attachment.FileName</button>
                        }
                        @if (!IsReadOnly && (IsOptionAttachment(attachment) || IsPdfAttachmentOfType(attachment, 2)))
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm ml-2"
                                    disabled="@IsAttachOptionDisabled"
                                    aria-label="@($"Remove {attachment.FileName}")"
                                    @onclick="() => RemoveOptionAttachmentAsync(attachment)">
                                @(removingAttachmentId == attachment.Id ? "Removing..." : "Remove")
                            </button>
                        }
                    </div>
                }
            }
            @if (attachmentError is not null)
            {
                <div class="alert alert-danger" role="alert">@attachmentError</div>
            }
        </fieldset>
    </div>
    <div class="card-footer bg-white py-3">
        <div class="d-flex flex-wrap align-items-center" style="gap: .75rem;">
            @if (!IsReadOnly)
            {
            @* <label class="sr-only" for="@ElementId("job-offer-test-recipient")">Test Recipient Email Address</label>
            <input id="@ElementId("job-offer-test-recipient")" type="email" class="form-control"
                   style="flex: 1 1 260px; min-width: 0;"
                   @bind="testEmailRecipient" @bind:event="oninput" disabled="@IsActionDisabled"
                   placeholder="Enter test recipient email address" autocomplete="email" />
            <button type="button" class="btn btn-outline-primary text-nowrap" disabled="@IsActionDisabled" @onclick="TestMailAsync">
                @if (isSendingTestMail)
                {
                    <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>
                    <span role="status">Sending...</span>
                }
                else
                {
                    <i class="fas fa-envelope-open-text fa-fw mr-1" aria-hidden="true"></i><span>Test Email</span>
                }
            </button> *@

                <a href="@($"{JORoutes.TAPartner.CandidateEmailPreview}/{jobOfferEmail.Id}")" target="_blank"
                    class="btn btn-outline-primary">
                    Preview
                </a>
            }
            @if (jobOfferEmail.StatusId == (int)EnumJOEmailStatus.Draft)
            {
                <button type="button" class="btn btn-outline-secondary text-nowrap" disabled="@IsActionDisabled" @onclick="SaveAsync">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>
                        <span role="status">Saving...</span>
                    }
                    else
                    {
                        <i class="fas fa-save fa-fw mr-1" aria-hidden="true"></i><span>Save</span>
                    }
                </button>
                <button type="button" class="btn btn-primary text-nowrap" disabled="@IsActionDisabled" @onclick="SubmitForApprovalAsync">
                    <i class="fas fa-paper-plane fa-fw mr-1" aria-hidden="true"></i>Submit for Approval
                </button>
            }
            @if (IsReadOnly && jobOfferEmail.StatusId == (int)EnumJOEmailStatus.Approved)
            {
                <button type="button" class="btn btn-primary text-nowrap" disabled="@(!CanSend)" @onclick="SendAsync">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>
                        <span role="status">Sending...</span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            }
        </div>
    </div>
</div>

<JOModal @ref="attachOptionModal" Title="Attach File">
    <ChildContent>
        @if (isLoadingOptions)
        {
            <p class="text-muted" role="status">Loading files...</p>
        }
        else if (optionsLoadError is not null)
        {
            <div class="alert alert-danger" role="alert">
                @optionsLoadError
                <button type="button" class="btn btn-outline-danger btn-sm ml-2" @onclick="ShowAttachOptionAsync">Try again</button>
            </div>
        }
        else if (optionDocuments.Count == 0)
        {
            <p class="text-muted" role="status">No option or benefits PDFs are available for this job offer.</p>
        }
        else
        {
            <div class="form-group">
                <label for="@ElementId("email-attachment-option")">File</label>
                <select id="@ElementId("email-attachment-option")" class="custom-select custom-select-sm"
                        @bind="selectedOptionDocumentId" disabled="@isAttachingOption">
                    <option value="">Select a file</option>
                    @foreach (var document in optionDocuments)
                    {
                        <option value="@document.Id" disabled="@IsOptionAttached(document)">@document.FileName@(IsOptionAttached(document) ? " (Already attached)" : "")</option>
                    }
                </select>
            </div>
        }
        @if (attachOptionError is not null)
        {
            <div class="alert alert-danger" role="alert">@attachOptionError</div>
        }
    </ChildContent>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => attachOptionModal?.Close()">Close</button>
        <button type="button" class="btn btn-primary btn-sm" @onclick="AttachOptionAsync"
                disabled="@(IsAttachOptionDisabled || optionsLoadError is not null || !selectedOptionDocumentId.HasValue || optionDocuments.Any(document => document.Id == selectedOptionDocumentId && IsOptionAttached(document)))">
            @(isAttachingOption ? "Attaching..." : "Attach")
        </button>
    </FooterTemplate>
</JOModal>





