@attribute [Authorize(Roles = JOUserRole.BusinessAdmin)]
@attribute [Route(JORoutes.BA.SalaryMatrixDetails)]

<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Salary bands</h6>
    </div>

    <div class="card-body">
        <div class="row mb-4">
            <div class="col-sm-12 col-md-6">
                <select id="company"
                        class="custom-select"
                        value="@salaryMatrix.CompanyId"
                        @onchange="OnCompanyChanged">
                    <option value="">Select company</option>
                    @foreach (var option in companies)
                    {
                        <option value="@option.Id">@option.Value</option>
                    }
                </select>
            </div>

            <div class="col-sm-12 col-md-6 jo-actions">
                <div></div>
                <button class="btn btn-outline-primary"
                        @onclick="AddBand"
                        disabled="@(!salaryGrades.Any())">
                    + Add band
                </button>
            </div>
        </div>
    
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Grade</th>
                        <th>Minimum</th>
                        <th>Midpoint</th>
                        <th>Maximum</th>
                        <th>CompaRatio</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var band in salaryBands)
                    {
                        <tr @key="band">
                            <td>
                                <select class="custom-select custom-select-sm" @bind="band.CSGId">
                                    @foreach (var option in salaryGrades)
                                    {
                                        <option value="@option.Id">@option.GradeName</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <PesoInput TValue="decimal?"
                                           class="form-control text-right"
                                           min="10000"
                                           step="10000"
                                           @bind-Value="band.Minimum" />
                            </td>
                            <td>
                                <PesoInput TValue="decimal?"
                                           class="form-control text-right"
                                           min="10000"
                                           step="10000"
                                           @bind-Value="band.Midpoint" />
                            </td>
                            <td>
                                <PesoInput TValue="decimal?"
                                           class="form-control text-right"
                                           min="10000"
                                           step="10000"
                                           @bind-Value="band.Maximum" />
                            </td>
                            <td>
                                <PesoInput TValue="decimal?"
                                           class="form-control text-right"
                                           min="10000"
                                           step="10000"
                                           @bind-Value="band.CompaRatio" />
                            </td>
                            <td>
                                <button class="btn btn-outline-danger btn-circle btn-sm"
                                        title="Remove band"
                                        aria-label="Remove band"
                                        @onclick="() => RemoveBand(band)">
                                    <i class="fas fa-trash-alt fa-fw"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer jo-actions">
        <a href="@JORoutes.TR.SalaryMatrix" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-primary px-4" @onclick="SaveMatrix">Create matrix</button>
    </div>
</div>

