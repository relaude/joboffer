@attribute [Authorize(Roles = JOUserRole.BusinessAdmin)]
@attribute [Route(JORoutes.BA.SalaryMatrices)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="jo-title">Salary Matrix</h6>
        
        <a class="btn btn-primary" href="@JORoutes.BA.SalaryMatrixDetails"><i class="fas fa-plus mr-2"></i>New matrix</a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Bands</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (matrixList.Any())
                    {
                        @foreach (var matrix in matrixList)
                        {
                            <tr @key="matrix.Id">
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(matrix.CompanyName) ? "-" : matrix.CompanyName)</strong>
                                    <div class="jo-label">@(string.IsNullOrWhiteSpace(matrix.CompanyCode) ? "-" : matrix.CompanyCode)</div>
                                </td>
                                <td><strong>@(matrix.BandCount?.ToString() ?? "-")</strong></td>
                                <td>
                                    @if (matrix.IsActive == true)
                                    {
                                        <span class="text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(matrix.CreatedByName) ? "-" : matrix.CreatedByName)</div>
                                    <small class="text-muted">@(matrix.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(matrix.ModifiedByName) ? "-" : matrix.ModifiedByName)</div>
                                    <small class="text-muted">@(matrix.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                                </td>
                                <td class="text-right">
                                    <div class="dropdown">
                                        <button type="button"
                                                class="btn btn-sm btn-link text-dark font-weight-bold"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                aria-label="Actions for @matrix.CompanyName">
                                            •••
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.BA.SalaryMatrixDetails}/{matrix.Id}")">
                                                View
                                            </a>
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.BA.EditSalaryMatrix}/{matrix.Id}")">
                                                Edit
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">No salary matrices found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

