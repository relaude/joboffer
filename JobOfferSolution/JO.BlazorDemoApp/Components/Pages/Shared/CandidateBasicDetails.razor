<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h2 class="h6 m-0 font-weight-bold text-primary">Candidate</h2>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-lg-4 mb-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                        <div class="text-primary mb-2">
                            <i class="fas fa-user-circle fa-4x" aria-hidden="true"></i>
                        </div>
                        <h3 class="h6 font-weight-bold text-gray-900 mb-1">@Candidate.CandidateFullName</h3>
                        <div class="text-muted">@Candidate.PositionAppliedFor</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 mb-3">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Email Address</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.EmailAddress</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Employment Status</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.EmploymentStatus</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">DBox Reference Number</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.DboxRefNum</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Company</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.CompanyName</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Grade</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.GradeName</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Relevant Experience</small>
                        <span class="font-weight-bold text-gray-800">@Candidate.RelevantExperience</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public VwDboxCandidates Candidate { get; set; }
}
