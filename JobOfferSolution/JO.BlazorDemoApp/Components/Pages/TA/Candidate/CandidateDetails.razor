@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.Candidate + "/{candidateId:int}")]

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h2 class="h6 m-0 font-weight-bold text-primary">Candidate Summary</h2>

        <div class="ml-auto">
            <a href="@JORoutes.TA.Candidates" class="btn btn-outline-secondary btn-sm mr-2">Back</a>
            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateJobOffer">
                Create Job Offer
            </button>
        </div>
    </div>

    <CandidateSummary Candidate="candidate" />
</div>

<CandidateCompensation Candidate="candidate" />

<CandidateBenefits Candidate="candidate" />

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h2 class="h6 m-0 font-weight-bold text-primary">Documents</h2>
        <button type="button" class="btn btn-primary btn-sm">
            <i class="fas fa-upload fa-fw mr-1"></i>Upload
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>File Name</th>
                            <th>File Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><i class="fas fa-file-alt fa-fw text-primary mr-2"></i>Resume / Curriculum Vitae</td>
                            <td>candidate-resume.pdf</td>
                            <td>PDF</td>
                            <td><span class="badge badge-success">Submitted</span></td>
                        </tr>
                        <tr>
                            <td><i class="fas fa-file-alt fa-fw text-primary mr-2"></i>Application Form</td>
                            <td>application-form.pdf</td>
                            <td>PDF</td>
                            <td><span class="badge badge-success">Submitted</span></td>
                        </tr>
                        <tr>
                            <td><i class="fas fa-graduation-cap fa-fw text-primary mr-2"></i>College Diploma</td>
                            <td>college-diploma.pdf</td>
                            <td>PDF</td>
                            <td><span class="badge badge-success">Submitted</span></td>
                        </tr>
                        <tr>
                            <td><i class="fas fa-file-alt fa-fw text-primary mr-2"></i>Transcript of Records</td>
                            <td>transcript-of-records.pdf</td>
                            <td>PDF</td>
                            <td><span class="badge badge-success">Submitted</span></td>
                        </tr>
                        <tr>
                            <td><i class="fas fa-briefcase fa-fw text-primary mr-2"></i>Certificate of Employment</td>
                            <td>certificate-of-employment.pdf</td>
                            <td>PDF</td>
                            <td><span class="badge badge-success">Submitted</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@inject ICandidateService CandidateService
@inject IUtilitiesService UtilitiesService
@inject IAlertService AlertService
@inject IAccountService AccountService
@inject NavigationManager Navigation

@code {
    [Parameter] public int candidateId { get; set; }
    private VwDboxCandidates candidate = new();

    protected override async Task OnInitializedAsync()
    {
        candidate = await CandidateService.GetVwDboxCandidate(candidateId);
    }

    private async Task CreateJobOffer()
    {
        int numProposal = await AlertService.ConfirmProposalNumber();

        if (numProposal == 0) return;

        int createdBy = await AccountService.GetJobOfferUserId();
        int jobOfferId = await CandidateService.CreateJobOffer(candidate, numProposal, createdBy);

        Navigation.NavigateTo($"{JORoutes.TA.Analysis}/{jobOfferId}");
    }

}
