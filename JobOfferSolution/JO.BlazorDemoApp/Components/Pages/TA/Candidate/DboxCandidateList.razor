@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.DboxCandidates)]

@inject ICandidateService CandidateService

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Dbox Candidates</h6>
        <div>
            <button type="button" class="btn btn-outline-success btn-sm mr-2">
                <i class="fas fa-file-excel fa-fw mr-1"></i>Import from Excel
            </button>
            <button type="button" class="btn btn-primary btn-sm">
                <i class="fas fa-sync-alt fa-fw mr-1"></i>API Sync
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Company</th>
                        <th>Division</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                    </tr>
                </thead>
                <tbody>
                    @if (candidates.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No Dbox candidates found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var candidate in candidates)
                        {
                            <tr @key="candidate.Id">
                                <td><strong>@(candidate.DboxRefNum ?? "-")</strong></td>
                                <td>@(candidate.CandidateName ?? "-")</td>
                                <td>@(candidate.Company ?? "-")</td>
                                <td>@(candidate.Division ?? "-")</td>
                                <td>@(candidate.Department ?? "-")</td>
                                <td>@(candidate.JobPosition ?? "-")</td>
                                <td>@(candidate.EmailAddress ?? "-")</td>
                                <td>@(candidate.ContactNumber ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<DboxCandidates> candidates = new();

    protected override async Task OnInitializedAsync()
    {
        candidates = await CandidateService.GetDboxCandidates();
    }
}
