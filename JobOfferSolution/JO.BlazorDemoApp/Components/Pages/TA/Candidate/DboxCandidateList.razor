@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.DboxCandidates)]



<div class="row">
    <div class="col-xl-4 col-md-4 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@candidates.Count</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-4 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">New</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">0</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-plus fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-4 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Update</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">0</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-edit fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
        <div>
            <h6 class="m-0 font-weight-bold text-primary">Dbox Candidates</h6>
            <small class="text-muted">
                <i class="fas fa-clock fa-fw mr-1"></i>Last syncing: 20 Aug 2026
            </small>
        </div>
        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-success mr-2">
                <i class="fas fa-file-excel fa-fw mr-1"></i>Import from Excel
            </button>
            <button type="button" class="btn btn-primary">
                <i class="fas fa-sync-alt fa-fw mr-1"></i>API Sync
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Company</th>
                        <th>Division</th>
                        <th>Department</th>
                        <th>Cost Center</th>
                        <th>Job Level</th>
                        <th>Position</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                    </tr>
                </thead>
                <tbody>
                    @if (candidates.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No Dbox candidates found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var candidate in candidates)
                        {
                            <tr @key="candidate.Id">
                                <td><strong>@(candidate.DboxRefNum ?? "-")</strong></td>
                                <td>@(candidate.CandidateName ?? "-")</td>
                                <td>@(candidate.Company ?? "-")</td>
                                <td>@(candidate.Division ?? "-")</td>
                                <td>@(candidate.Department ?? "-")</td>
                                <td>@(candidate.CostCenter ?? "-")</td>
                                <td>@(candidate.JobLevel ?? "-")</td>
                                <td>@(candidate.JobPosition ?? "-")</td>
                                <td>@(candidate.EmailAddress ?? "-")</td>
                                <td>@(candidate.ContactNumber ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
