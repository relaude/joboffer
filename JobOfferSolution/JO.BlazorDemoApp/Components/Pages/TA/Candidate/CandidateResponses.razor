@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.MSFormResponse)]

@inject ICandidateService CandidateService

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Candidate Responses</h6>
        <div>
            <button type="button" class="btn btn-outline-success btn-sm mr-2">
                <i class="fas fa-file-excel fa-fw mr-1"></i>Import from Excel
            </button>
            <button type="button" class="btn btn-primary btn-sm">
                <i class="fas fa-sync-alt fa-fw mr-1"></i>MS-Forms Sync
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Candidate Response ID</th>
                        <th>Candidate</th>
                        <th>Position Applied For</th>
                        <th>Current Employer</th>
                    </tr>
                </thead>
                <tbody>
                    @if (candidateResponses.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No candidate responses found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var candidateResponse in candidateResponses)
                        {
                            <tr @key="candidateResponse.Id">
                                <td>@(candidateResponse.CandidateResponseId?.ToString() ?? "-")</td>
                                <td>@(candidateResponse.CandidateFullName ?? "-")</td>
                                <td>@(candidateResponse.PositionAppliedFor ?? "-")</td>
                                <td>@(candidateResponse.CurrentEmployerName ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<DataModel.Entity.CandidateResponses> candidateResponses = new();

    protected override async Task OnInitializedAsync()
    {
        candidateResponses = await CandidateService.GetCandidateResponses();
    }
}
