@attribute [Authorize(Roles = JOUserRole.TAPartner)]
@attribute [Route(JORoutes.TAPartner.Candidates)]

<h1 class="h3 mb-4 text-gray-800">TA Partner Candidates</h1>

<CandidateKpiBoxes Total="@total"
                   WithResponseCount="@withResponse"
                   NoResponseCount="@withOutResponse"
                   CreatedCount="@joCreated"
                   DraftCount="@joDraft"
                   ForCreationCount="@forJOCreation"
                   OnFilterChanged="FilterCandidates" />

<CandidateTableList Candidates="@pagedCandidates.Data"
                    RoleId="@JOUserRole.TAPartner">
    <FooterTemplate>
        <Pagination Result="@pagedCandidates"
                    PageChanged="ChangePage"
                    PageSizeChanged="ChangePageSize"
                    AriaLabel="Candidate pages" />
    </FooterTemplate>
</CandidateTableList>
