@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.Candidates)]

<div class="row">
    <!--Total-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-primary shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(null)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@total</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--With Responses-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(WithResponseFilter)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">With Response</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@withResponse</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Without Response-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(WithoutResponseFilter)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">No Response</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@withOutResponse</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Created-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(3)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Created</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@joCreated</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Draft-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(2)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Draft</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@joDraft</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--For Creation-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2"
             role="button" tabindex="0" @onclick="() => FilterCandidates(1)">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">For Creation</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@forJOCreation</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="jo-title">Candidates</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Response</th>
                            <th>Status</th>
                            <th>Candidate ID</th>
                            <th>Email</th>
                            <th>Job Position</th>
                            <th>Company</th>
                            <th>Division</th>
                            <th>Department</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in filteredCandidates)
                        {
                            <tr>
                                <td class="jo-title">
                                    <button type="button"
                                            class="btn btn-link p-0 btn-sm"
                                            role="link"
                                            @onclick="() => OpenCandidate(row)">
                                        @row.CandidateName
                                    </button>
                                </td>
                                <td>
                                    @if (row.ResponseId > 0)
                                    {
                                        <span class="badge badge-info">With Response</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">No Response</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(row.StatusName) ? "-" : row.StatusName)</td>
                                <td>@row.DboxRefNum</td>
                                <td>@row.EmailAddress</td>
                                <td>@row.JobPosition</td>
                                <td>@row.Company</td>
                                <td>@row.Division</td>
                                <td>@row.Department</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
