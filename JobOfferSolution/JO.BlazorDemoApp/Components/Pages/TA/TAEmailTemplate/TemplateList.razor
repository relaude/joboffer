@attribute [Authorize(Roles = JOUserRole.TAPartner)]
@attribute [Route(JORoutes.TAPartner.EmailTemplates)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="jo-title mb-0">Email Templates</h6>
        <a class="btn btn-sm btn-primary" href="@JORoutes.TAPartner.EmailTemplate">
            <i class="fas fa-plus fa-fw mr-1" aria-hidden="true"></i>New Template
        </a>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center text-muted py-4" role="status">Loading email templates...</div>
        }
        else if (templates.Count == 0)
        {
            <div class="text-center text-muted py-4">No email templates are available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th scope="col">Email Subject</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created At</th>
                            <th scope="col">Created By</th>
                            <th scope="col">Modified At</th>
                            <th scope="col">Modified By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in templates)
                        {
                            <tr @key="template.Id">
                                <td>
                                    <a href="@($"{JORoutes.TAPartner.EmailTemplate}/{template.Id}")">
                                        @(string.IsNullOrWhiteSpace(template.EmailSubject) ? "(No subject)" : template.EmailSubject)
                                    </a>
                                </td>
                                <td>@(template.IsActive == true ? "Active" : "Inactive")</td>
                                <td>@(template.CreatedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")</td>
                                <td>@template.CreatedByName</td>
                                <td>@(template.ModifiedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")</td>
                                <td>@template.ModifiedByName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
