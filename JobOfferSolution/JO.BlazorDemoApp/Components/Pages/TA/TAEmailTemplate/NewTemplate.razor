@attribute [Authorize(Roles = JOUserRole.TAPartner)]
@attribute [Route(JORoutes.TAPartner.EmailTemplate)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between">
        <div class="mb-2 mb-sm-0">
            <h6 class="jo-title mb-1"><i class="fas fa-envelope-open-text fa-fw text-primary mr-2"></i>New Email Template</h6>
            <small class="text-muted">Create a reusable message for a job offer workflow.</small>
        </div>
        <div>
            <a class="btn btn-outline-secondary mr-2" href="@JORoutes.TAPartner.EmailTemplates">
                <i class="fas fa-times fa-fw mr-1"></i>Cancel
            </a>
            <button type="button" class="btn btn-primary" disabled="@isProcessingSave" @onclick="SaveTemplateAsync">
                <i class="fas fa-save fa-fw mr-1"></i>Save Template
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="form-group mb-4">
            <label class="font-weight-bold text-gray-700" for="template-workflow">Job Offer WorkFlow</label>
            <select id="template-workflow" class="custom-select" @bind="emailTemplate.WorkFlowId">
                <option value="">Select a workflow</option>
                @foreach (var workflow in workFlowStatuses)
                {
                    <option value="@workflow.Id">@workflow.FlowName</option>
                }
            </select>
        </div>

        <div class="form-group mb-4">
            <label class="font-weight-bold text-gray-700" for="template-name">Email Subject</label>
            <input id="template-name" type="text" class="form-control" @bind="emailTemplate.EmailSubject" placeholder="Enter a descriptive email subject" />
        </div>

        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="card h-100 border">
                    <div class="card-header bg-light py-3">
                        <h6 class="m-0 font-weight-bold text-gray-800">Recipients</h6>
                        <small class="text-muted">Select one or more recipient roles.</small>
                    </div>
                    <div class="card-body">
                        @foreach (var role in recipientRoles)
                        {
                            <div class="custom-control custom-checkbox mb-2" @key="role.Id">
                                <input id="@($"recipient-role-{role.Id}")" type="checkbox" class="custom-control-input"
                                       checked="@selectedRecipientRoleIds.Contains(role.Id)"
                                       @onchange="args => UpdateRecipientRole(role.Id, args.Value is true)" />
                                <label class="custom-control-label" for="@($"recipient-role-{role.Id}")">@role.RoleName</label>
                            </div>
                        }

                        <div class="form-group mb-0 pt-3 border-top">
                            <label class="font-weight-bold text-gray-700" for="recipient-others">Others TO Recipients</label>
                            <input id="recipient-others" type="text" class="form-control form-control-sm" @bind="emailTemplate.OtherRecipient" placeholder="Enter email addresses" />
                            <small class="form-text text-muted">Separate multiple addresses with semicolons (;).</small>
                        </div>

                        <div class="form-group mb-0 mt-3 pt-3 border-top">
                            <label class="font-weight-bold text-gray-700" for="recipient-cc">CC Recipients</label>
                            <input id="recipient-cc" type="text" class="form-control form-control-sm"
                                   @bind="emailTemplate.CCRecipient"
                                   placeholder="Enter CC email addresses" aria-describedby="recipient-cc-help" />
                            <small id="recipient-cc-help" class="form-text text-muted">
                                Optional. Separate multiple addresses with semicolons (;).
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card h-100 border">
                    <div class="card-header bg-light py-3">
                        <h6 class="m-0 font-weight-bold text-gray-800">Message</h6>
                        <small class="text-muted">Compose the email content for this template.</small>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="form-group d-flex flex-column flex-grow-1 mb-0"
                             @oninput="UpdateEmailMessageAsync" @onfocusout="UpdateEmailMessageAsync">
                            <TextEditor @ref="messageEditor"
                                        Toolbar="new Toolbar { ShowFullToolbar = true }"
                                        EditorContainerId="email-message"
                                        Placeholder="Write the email message here...">
                            </TextEditor>
                        </div>

                        <fieldset class="border rounded p-3 mt-3 mb-0">
                            <legend class="w-auto px-2 mb-2 h6 font-weight-bold text-gray-800">Replacements</legend>
                            <p class="text-muted mb-2">Use these placeholders in the subject and message to include job offer and candidate details.</p>
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="mb-0">
                                        <dt><code>#JORefNum</code></dt>
                                        <dd>JO Reference Number</dd>

                                        <dt><code>#CandidateName</code></dt>
                                        <dd>Candidate name</dd>

                                        <dt><code>#Position</code></dt>
                                        <dd>Job position</dd>

                                        <dt><code>#SalaryGrade</code></dt>
                                        <dd class="mb-md-0">Salary grade name</dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="mb-0">
                                        <dt><code>#Department</code></dt>
                                        <dd>Department</dd>

                                        <dt><code>#Division</code></dt>
                                        <dd>Division</dd>

                                        <dt><code>#CandidateRemarks</code></dt>
                                        <dd>Candidate remarks</dd>

                                        <dt><code>#HtmlTableOffers</code></dt>
                                        <dd class="mb-0">Job Offer Proposed Options</dd>
                                    </dl>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <label class="font-weight-bold text-gray-700" for="template-test-recipient">Test Recipient Email Address</label>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center">
            <input id="template-test-recipient" type="email" class="form-control mr-sm-2 mb-2 mb-sm-0"
                   style="width: 100%; max-width: 320px;"
                   @bind="testEmailRecipient"
                   placeholder="Enter test recipient email address" autocomplete="email" />
            <button type="button" class="btn btn-outline-primary text-nowrap" disabled="@isSendingTestMail" @onclick="TestMailAsync">
                <i class="fas fa-envelope-open-text fa-fw mr-1" aria-hidden="true"></i>Test Mail
            </button>
        </div>
    </div>
</div>
