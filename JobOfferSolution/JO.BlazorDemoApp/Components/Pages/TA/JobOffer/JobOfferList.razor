@attribute [Authorize(Roles = JOUserRole.TAPartner)]
@attribute [Route(JORoutes.TAPartner.JobOfferTracker)]

<JobOfferKpiBoxes
                  Total="@total"
                  ForReviewCount="@countForReview"
                  ReviewedCount="@countReviewed"
                  SendBackCount="@countSendBack"
                  ForApprovalCount="@countForApproval"
                  ForDiscussionCount="@countForDiscussion"
                  ApprovedCount="@countApproved"
                  AcceptedCount="@countAcccepted"
                  ForNegotiationCount="@countForNegotiation"
                  DeclinedCount="@countDeclined"
                  ForReviewWorkFlowIds="@ForReviewWorkFlowIds"
                  ReviewedWorkFlowIds="@ReviewedWorkFlowIds"
                  SendBackWorkFlowIds="@SendBackWorkFlowIds"
                  ForApprovalWorkFlowIds="@ForApprovalWorkFlowIds"
                  ForDiscussionWorkFlowIds="@ForDiscussionWorkFlowIds"
                  ApprovedWorkFlowIds="@ApprovedWorkFlowIds"
                  AcceptedWorkFlowIds="@AcceptedWorkFlowIds"
                  ForNegotiationWorkFlowIds="@ForNegotiationWorkFlowIds"
                  DeclinedWorkFlowIds="@DeclinedWorkFlowIds"
