@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.JobOfferTracker)]

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Analysis</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @countAnalysis
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">For Review</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @countForReview
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Reviewed</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @countReviwed
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Approved</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @countApproved
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Job Offers</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Status</th>
                        <th>Work Flow</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var joDboxCandidate in joDboxCandidates)
                    {
                        <tr @key="joDboxCandidate.Id">
                            <td><strong>@(joDboxCandidate.RefNum)</strong></td>
                            <td>@joDboxCandidate.DboxRefNum</td>
                            <td>@joDboxCandidate.CandidateName</td>
                            <td>@joDboxCandidate.StatusName</td>
                            <td>@joDboxCandidate.FlowName</td>
                            <td>
                                <div>@joDboxCandidate.CreatedByName</div>
                                <small class="text-muted">@(joDboxCandidate.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td>
                                <div>@joDboxCandidate.ModifiedByName</div>
                                <small class="text-muted">@(joDboxCandidate.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td class="text-right">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-link text-dark font-weight-bold"
                                            data-toggle="dropdown"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            aria-label="Actions for @joDboxCandidate.RefNum">
                                        •••
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                        @if (joDboxCandidate.StatusId == 1)
                                        {
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.TA.Analysis}/{joDboxCandidate.Id}")">
                                                Analysis
                                            </a>
                                        }

                                        @if (joDboxCandidate.WorkFlowId == 4 
                                            && (joDboxCandidate.StatusId == 4 
                                                || joDboxCandidate.StatusId == 8))
                                        {
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.TA.EmailLetter}/{joDboxCandidate.Id}")">
                                                Letter
                                            </a>
                                            <a class="dropdown-item"
                                               href="#">
                                                Discussion
                                            </a>
                                        }

                                        <a class="dropdown-item"
                                           href="@($"{JORoutes.Transaction.JobOffer}/{joDboxCandidate.Id}")">
                                            Details
                                        </a>

                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
