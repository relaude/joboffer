@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.JobOfferTracker)]

<div class="row">
    <!--Total-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@total</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--For Review-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">For Review</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@countForReview</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Reviewed-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Reviewed</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--For Approval-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">For Approval</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@countForApproval</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Approved-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Approved</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@countApproved</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Accepted-->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Accepted</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Job Offers</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Status</th>
                        <th>Workflow</th>
                        <th>Created</th>
                        <th>Modified</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var joDboxCandidate in filteredJODboxCandidates)
                    {
                        <tr @key="joDboxCandidate.Id">
                            <td>
                                <a href="@SetJOlink(joDboxCandidate)">
                                    <strong>@(joDboxCandidate.RefNum)</strong>
                                </a>
                            </td>
                            <td>@joDboxCandidate.DboxRefNum</td>
                            <td>@joDboxCandidate.CandidateName</td>
                            <td>@joDboxCandidate.ActionByName</td>
                            <td>@joDboxCandidate.FlowName</td>
                            <td>
                                <div>@joDboxCandidate.CreatedByName</div>
                                <small class="text-muted">@(joDboxCandidate.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td>
                                <div>@joDboxCandidate.ModifiedByName</div>
                                <small class="text-muted">@(joDboxCandidate.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
