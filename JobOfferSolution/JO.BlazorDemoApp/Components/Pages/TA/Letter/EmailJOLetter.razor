@* @attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.EmailLetter + "/{jobOfferId:int}")] *@

<CardJOSummary JobOffer="@vwJODboxCandidates" />

<CardCandidateCompensation Candidate="@candidate" CompensationItems="@vwCompanyCompensationItems" />

<!--SHARED-->
<div class="card shadow mb-4">
   
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-md-6 mb-2 mb-md-0">
                <h6 class="jo-title">Letter</h6>
            </div>
            <div class="col-md-6">
                <label class="sr-only" for="compensation-option">Compensation option</label>
                <select id="compensation-option"
                        class="custom-select custom-select-sm"
                        @onchange="OnCompensationOptionChanged">
                    @foreach (var compensation in joCompanyCompensation
                        .Where(jo => jo.OptionNumber > 0)
                        .OrderBy(jo => jo.OptionNumber))
                    {
                        <option value="@compensation.ProposedSalary">@($"Option {compensation.OptionNumber} - {UtilitiesService.ToPeso(compensation.ProposedSalary)}")</option>
                    }
                </select>
            </div>
        </div>
    </div>
    
    <div class="card-body">
        
        <div class="form-row">
            <div class="form-group col-lg-6">
                <label for="email-recipient" class="font-weight-bold text-gray-700 mb-1">
                    Email Recipient
                </label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" aria-hidden="true">
                            <i class="fas fa-at"></i>
                        </span>
                    </div>
                    <input id="email-recipient"
                           name="emailRecipient"
                           type="email"
                           class="form-control"
                           value="@candidate.EmailAddress"
                           placeholder="candidate@example.com"
                           autocomplete="email" readonly />
                </div>
            </div>

            <div class="form-group col-lg-6">
                <label for="email-subject" class="font-weight-bold text-gray-700 mb-1">
                    Email Subject
                </label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" aria-hidden="true">
                            <i class="fas fa-heading"></i>
                        </span>
                    </div>
                    <input id="email-subject"
                           name="emailSubject"
                           type="text"
                           class="form-control"
                           @bind="emailSubject"
                           placeholder="Enter the email subject"
                           autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="test-email-recipient" class="font-weight-bold text-gray-700 mb-1">
                Test Email Recipient
            </label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" aria-hidden="true">
                        <i class="fas fa-envelope-open-text"></i>
                    </span>
                </div>
                <input id="test-email-recipient"
                       name="testEmailRecipient"
                       type="email"
                       class="form-control"
                       @bind="testEmailRecipient"
                       placeholder="Enter an email address for the test message"
                       autocomplete="email" />
            </div>
            <small class="form-text text-muted">
                Test emails will be sent to this address only.
            </small>
        </div>

        <div class="border-top pt-3">
            <label class="font-weight-bold text-gray-700 mb-2" for="job-offer-letter-editor">
                Email Message
            </label>
            @if (joItemLetters.Count == 0)
            {
                <div class="alert alert-info mb-0" role="alert">
                    No letter content is available for this job offer.
                </div>
            }
            else
            {
                <TextEditor @ref="letterEditor"
                            Toolbar="new Toolbar { ShowFullToolbar = true }"
                            EditorContainerId="job-offer-letter-editor"
                            Placeholder="Enter the job offer letter content...">
                </TextEditor>
            }
        </div>
        
    </div>

    <div class="card-footer jo-actions">
        <a href="@JORoutes.TA.JobOfferTracker" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i>
            Go Back
        </a>
        <button type="button" class="btn btn-outline-primary" @onclick="SendTestMail">
            <i class="fas fa-envelope-open-text mr-1" aria-hidden="true"></i>
            Test Email
        </button>
        <button type="button" class="btn btn-success" >
            <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i>
            Send Email
        </button>
    </div>
</div>
<!--SHARED-->
