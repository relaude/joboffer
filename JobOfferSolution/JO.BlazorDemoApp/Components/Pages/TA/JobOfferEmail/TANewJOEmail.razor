@attribute [Authorize(Roles = JOUserRole.TAPartner)]
@attribute [Route(JORoutes.TAPartner.JobOfferNewEmail + "/{jobOfferId:int}")]

<div class="card shadow mb-4 small">
    <div class="card-header py-3">
        <h6 class="jo-title mb-1">
            <i class="fas fa-envelope fa-fw text-primary mr-2" aria-hidden="true"></i>Send Email Preview
        </h6>
        <small class="text-muted">Compose your email and review the attachments before sending.</small>
    </div>

    <div class="card-body">
        <div class="form-group row align-items-center">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="email-preview-to">To</label>
            <div class="col-sm-10">
                <input id="email-preview-to" type="text" inputmode="email" class="form-control"
                       @bind="jobOfferEmail.ToRecipient" @bind:event="oninput" disabled="@isLoadingMessage" />
            </div>
        </div>

        <div class="form-group row align-items-center">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="email-preview-cc">CC</label>
            <div class="col-sm-10">
                <input id="email-preview-cc" type="text" inputmode="email" class="form-control"
                       @bind="jobOfferEmail.CCRecipient" @bind:event="oninput" disabled="@isLoadingMessage" />
            </div>
        </div>

        <div class="form-group row align-items-center border-bottom pb-4">
            <label class="col-sm-2 col-form-label font-weight-bold text-gray-700" for="email-preview-subject">Subject</label>
            <div class="col-sm-10">
                <input id="email-preview-subject" type="text" class="form-control"
                       @bind="jobOfferEmail.Subject" @bind:event="oninput" disabled="@isLoadingMessage" />
            </div>
        </div>

        <div class="form-group mb-4">
            <div id="email-preview-message-label" class="font-weight-bold text-gray-700 mb-2">Message</div>
            @if (isLoadingMessage)
            {
                <div class="text-muted" role="status">Loading email message...</div>
            }
            else
            {
                <div role="group" aria-labelledby="email-preview-message-label"
                     @oninput="UpdateEmailMessageAsync" @onfocusout="UpdateEmailMessageAsync">
                    <TextEditor @ref="messageEditor" @key="jobOfferId"
                                Toolbar="new Toolbar { ShowFullToolbar = true }"
                                EditorContainerId="email-preview-message"
                                Placeholder="Write the email message here..." />
                </div>
            }
        </div>

        <fieldset class="mb-0">
            <legend class="small font-weight-bold text-gray-700 mb-3">
                <i class="fas fa-paperclip fa-fw mr-1" aria-hidden="true"></i>Attachments
            </legend>
            <button type="button" class="btn btn-outline-primary btn-sm mb-3" @onclick="ShowAttachOptionAsync"
                    disabled="@(isLoadingMessage || isLoadingOptions || isSaving || isSendingTestMail || isAttachingOption)">Attach Option</button>
            @if (isLoadingAttachment)
            {
                <p class="text-muted" role="status">Loading benefits.pdf...</p>
            }
            else if (attachmentError is not null)
            {
                <div class="alert alert-danger" role="alert">
                    @attachmentError
                    <button type="button" class="btn btn-outline-danger btn-sm ml-2" @onclick="LoadBenefitsAttachmentAsync">Try again</button>
                </div>
            }
            else if (benefitsAttachment is not null)
            {
                <div class="border rounded bg-light p-3">
                    <i class="fas fa-file-pdf text-danger mr-2" aria-hidden="true"></i>
                    <a href="jofiles/benefits.pdf" target="_blank" rel="noopener noreferrer">@benefitsAttachment.Name</a>
                    <span class="text-muted ml-2">(@benefitsAttachment.SizeInKb KB)</span>
                    <span class="text-muted ml-2">Automatically attached</span>
                </div>
            }
            @foreach (var attachment in optionAttachments)
            {
                <div class="border rounded bg-light p-3 mt-2" @key="attachment.Name">
                    <i class="fas fa-file-pdf text-danger mr-2" aria-hidden="true"></i>
                    <button type="button" class="btn btn-link p-0 align-baseline" disabled="@isDownloadingAttachment"
                            @onclick="() => DownloadOptionAttachmentAsync(attachment)" title="Download PDF for review">@attachment.Name</button>
                    <span class="text-muted ml-2">(@attachment.SizeInKb KB)</span>
                    <button type="button" class="btn btn-outline-danger btn-sm ml-2"
                            disabled="@(isAttachingOption || isSendingTestMail || isSaving || isValidating)"
                            aria-label="@($"Remove {attachment.Name}")"
                            @onclick="() => RemoveOptionAttachment(attachment)">Remove</button>
                </div>
            }
            @if (attachmentDownloadError is not null)
            {
                <div class="alert alert-danger mt-2" role="alert">@attachmentDownloadError</div>
            }
        </fieldset>
    </div>

    <div class="card-footer bg-white py-3">
        <div class="d-flex flex-wrap align-items-center" style="gap: .75rem;">
            <label class="sr-only" for="job-offer-test-recipient">Test Recipient Email Address</label>
            <input id="job-offer-test-recipient" type="email" class="form-control"
                   style="flex: 1 1 260px; min-width: 0;"
                   @bind="testEmailRecipient" @bind:event="oninput" disabled="@IsActionDisabled"
                   placeholder="Enter test recipient email address" autocomplete="email" />
            <button type="button" class="btn btn-outline-primary text-nowrap" disabled="@IsActionDisabled" @onclick="TestMailAsync">
                @if (isSendingTestMail)
                {
                    <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>
                    <span role="status">Sending...</span>
                }
                else
                {
                    <i class="fas fa-envelope-open-text fa-fw mr-1" aria-hidden="true"></i><span>Test Mail</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary text-nowrap" disabled="@(IsActionDisabled || hasSavedDraft)" @onclick="SaveAsync">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>
                    <span role="status">Saving email and attachments...</span>
                }
                else
                {
                    <i class="fas fa-save fa-fw mr-1" aria-hidden="true"></i><span>@(hasSavedDraft ? "Draft Saved" : "Save")</span>
                }
            </button>
            @* <button type="button" class="btn btn-primary text-nowrap" disabled="@IsActionDisabled" @onclick="SubmitForApprovalAsync">
                <i class="fas fa-paper-plane fa-fw mr-1" aria-hidden="true"></i>Submit for Approval
            </button> *@
        </div>
    </div>
</div>

<JOModal @ref="attachOptionModal" Title="Attach Option">
    <ChildContent>
    @if (isLoadingOptions)
    {
        <p class="text-muted" role="status">Loading options...</p>
    }
    else if (optionsLoadError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @optionsLoadError
            <button type="button" class="btn btn-outline-danger btn-sm ml-2" @onclick="ShowAttachOptionAsync">Try again</button>
        </div>
    }
    else if (compensationOptions.Count == 0)
    {
        <p class="text-muted" role="status">No options are available for this job offer.</p>
    }
    else
    {
        <div class="form-group">
            <label for="email-attachment-option">Option</label>
            <select id="email-attachment-option" class="custom-select custom-select-sm" @ref="optionSelect"
                    @bind="selectedProposedSalary" disabled="@isAttachingOption">
                <option value="">Select an option</option>
                @foreach (var option in compensationOptions)
                {
                    <option value="@option.ProposedSalary" data-option-id="@option.Id">Option @option.OptionNumber - @UtilitiesService.ToPeso(option.ProposedSalary)</option>
                }
            </select>
        </div>
    }
    @if (attachOptionError is not null)
    {
        <div class="alert alert-danger" role="alert">@attachOptionError</div>
    }
    </ChildContent>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => attachOptionModal?.Close()">Close</button>
        <button type="button" class="btn btn-primary btn-sm" @onclick="AttachOptionAsync"
                disabled="@(isAttachingOption || isLoadingOptions || optionsLoadError is not null || !selectedProposedSalary.HasValue)">
            @(isAttachingOption ? "Generating PDF..." : "Attach")
        </button>
    </FooterTemplate>
</JOModal>
