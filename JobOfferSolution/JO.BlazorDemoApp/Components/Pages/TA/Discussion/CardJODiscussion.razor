
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h6 class="jo-title">
            <i class="fas fa-history fa-fw text-info mr-2"></i>@Title
        </h6>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <small class="text-muted">@Subtitle</small>
        }
    </div>
    <div class="card-body">
        @if (Discussions.Count == 0)
        {
            <div class="text-center text-muted py-4">@EmptyMessage</div>
        }
        else
        {
            @* @foreach (var item in Discussions)
            {
                <div class="d-flex pb-3 mb-3 border-bottom" @key="item.Id">
                    <div class="btn-circle btn-sm bg-info text-white mr-3">
