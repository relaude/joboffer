
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h6 class="jo-title">
            <i class="fas fa-history fa-fw text-info mr-2"></i>@Title
        </h6>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <small class="text-muted">@Subtitle</small>
        }
    </div>
    <div class="card-body">
        @if (Discussions.Count == 0)
        {
            <div class="text-center text-muted py-4">@EmptyMessage</div>
        }
        else
        {
            <div class="pr-2"
                 style="max-height: 650px; overflow-y: auto; overflow-x: hidden;"
                 role="region"
                 aria-label="Discussion history"
                 tabindex="0">
                @foreach (var item in Discussions)
                {
                    <div class="d-flex pb-3 mb-3 border-bottom" @key="item.Id">

                        <div class="flex-fill">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                <div class="d-flex align-items-center flex-wrap mb-2 mb-md-0">
                                    <span class="badge badge-info px-3 mr-2">Option @item.OptionNumber</span>
                                    <span class="font-weight-bold text-gray-900 py-2">@item.StatusName</span>
                                </div>
                                <small class="text-muted">@UtilitiesService.FormatDate(item.DiscussAt, CommonConstant.DefaultShortDateFormat)</small>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Comments)
                                || !string.IsNullOrWhiteSpace(item.FeedBack)
                                || !string.IsNullOrWhiteSpace(item.ReasonName)
                                || !string.IsNullOrWhiteSpace(item.DeclineRemarks))
                            {
                                <div class="row mt-3">
                                    @if (!string.IsNullOrWhiteSpace(item.Comments))
                                    {
                                        <div class="col-12 col-md-6 mb-3">
                                            <div class="border rounded bg-light p-3 h-100">
                                                <div class="small font-weight-bold text-gray-700 text-uppercase mb-1">Discussion Notes</div>
                                                <div class="text-gray-800 text-break">@item.Comments</div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.FeedBack))
                                    {
                                        <div class="col-12 col-md-6 mb-3">
                                            <div class="border rounded bg-light p-3 h-100">
                                                <div class="small font-weight-bold text-gray-700 text-uppercase mb-1">Candidate Feedback</div>
                                                <div class="text-gray-800 text-break">@item.FeedBack</div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.ReasonName))
                                    {
                                        <div class="col-12 col-md-6 mb-3">
                                            <div class="border rounded bg-light p-3 h-100">
                                                <div class="small font-weight-bold text-gray-700 text-uppercase mb-1">Decline Reason</div>
                                                <div class="text-gray-800 text-break">@item.ReasonName</div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.DeclineRemarks))
                                    {
                                        <div class="col-12 col-md-6 mb-3">
                                            <div class="border rounded bg-light p-3 h-100">
                                                <div class="small font-weight-bold text-gray-700 text-uppercase mb-1">Other Decline Details</div>
                                                <div class="text-gray-800 text-break">@item.DeclineRemarks</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
