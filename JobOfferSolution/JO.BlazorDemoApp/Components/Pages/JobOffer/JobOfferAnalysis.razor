@* Parent usage: <JOAnalysis @ref="analysis" jobOfferId="@jobOfferId" />
   Declare a JOAnalysis? analysis field in the parent, then read analysis?.JobOffer
   after this component has finished loading (for example, in a later button handler).
   The reference is unavailable before rendering, and JobOffer is initially empty. *@
<CardJOSummary JobOffer="@vwjobOffer" />

<CardCandidateCompensation Candidate="@candidate" CompensationItems="@vwCompanyCompensationItems" />

<!--Salary Structure Guidelines-->
<div class="card shadow mb-4 small">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="jo-title">Salary Structure Guidelines</h6>
    </div>

    <div class="card-body">
        <div class="card shadow-sm mb-2">
            <div class="card-header"></div>
            <div class="card-body">
                <div class="table-responsive mb-3">
                    <table class="jo-table">
                        <thead>
                            <tr>
                                <th scope="col">Salary Grade</th>
                                <th scope="col">Minimum</th>
                                <th scope="col">Midpoint</th>
                                <th scope="col">Maximum</th>
                                <th scope="col">Compa Ratio</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(vwSalaryBand.GradeName) ? "-" : vwSalaryBand.GradeName)</td>
                                <td class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(vwSalaryBand.Minimum)</td>
                                <td class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(vwSalaryBand.Midpoint)</td>
                                <td class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(vwSalaryBand.Maximum)</td>
                                <td class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(vwSalaryBand.CompaRatio)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-3 mb-lg-0">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header">
                        <h6 class="jo-title">Current</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label for="currentMonthlyBasic">Monthly Basic</label>
                            <input id="currentMonthlyBasic" type="text" class="form-control"
                                   value="@(UtilitiesService.ToPeso(candidate.CurrentMonthlyBasicSalary))" readonly />
                        </div>
                        <div class="form-group mb-0">
                            <label for="currentTotalMonthsPay">Total Months Pay</label>
                            <input id="currentTotalMonthsPay" type="text" class="form-control"
                                   value="@MonthPayToInt()" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header">
                        <h6 class="jo-title">UL Equivalent</h6>
                    </div>
                    <div class="card-body">

                        <div class="form-group">
                            <label for="ulEquivalentMonthlyBasic">Monthly Basic</label>
                            <input id="ulEquivalentMonthlyBasic"
                                   type="text"
                                   class="form-control"
                                   value="@UtilitiesService.ToPeso(ComputeUlEquivalentMonthlyBasic())"
                                   readonly />
                        </div>
                        <div class="form-group mb-0">
                            <label for="ulEquivalentTotalMonthsPay">Total Months Pay</label>
                            <select id="ulEquivalentTotalMonthsPay"
                                    class="custom-select"
                                    @bind="ulEquivalentTotalMonthsPay">
                                <option value="13">13</option>
                                <option value="14">14</option>
                                <option value="15">15</option>
                                <option value="16">16</option>
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!--Candidate Remarks-->
<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Candidate Remarks</h6>
    </div>
    <div class="card-body">
        <textarea rows="5" class="form-control" @bind="joAnalysis.CandidateReamrks" readonly></textarea>
    </div>
</div>

<!--Analysis-->
<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Analysis</h6>
    </div>

    <div class="card-body">
        <div class="jo-analysis-option-tabs" role="tablist">
            @foreach (var compensation in joCompanyCompensation.Where(item => item.OptionNumber > 0))
            {
                <div role="tab"
                     tabindex="0"
                     aria-selected="@(selectedOptionNumber == compensation.OptionNumber)"
                     class="jo-analysis-option-tab @(selectedOptionNumber == compensation.OptionNumber ? "active" : null)"
                     @onclick="() => ClickOptionTab(compensation)">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="jo-analysis-option-title">Option @compensation.OptionNumber</span>
                        <small class="text-muted text-right text-truncate ml-2"
                               title="@GetCompanyCompensationName(compensation.CmpnyCmpnstnId)">
                            @GetCompanyCompensationName(compensation.CmpnyCmpnstnId)
                        </small>
                    </div>

                    <div>
                        <div class="pb-2">
                            <div class="text-xs font-weight-bold text-uppercase text-gray-600">Amount</div>
                            <div class="font-weight-bold text-gray-800">
                                @UtilitiesService.ToPeso(compensation.ProposedSalary)
                            </div>
                        </div>
                        @* <div class="border-top py-2">
                            <div class="text-xs text-uppercase text-gray-500">% Increase Monthly</div>
                            <div class="font-weight-bold text-gray-800">@FormatPercent(compensation.Increase)</div>
                        </div> *@
                        <div class="border-top py-2">
                            <div class="text-xs text-uppercase text-gray-500">% Increase Monthly</div>
                            <div class="font-weight-bold text-gray-800">@FormatPercent(compensation.DiffTotalMonthly)</div>
                        </div>
                        <div class="border-top py-2">
                            <div class="text-xs text-uppercase text-gray-500">% Increase Annual</div>
                            <div class="font-weight-bold text-gray-800">@FormatPercent(compensation.DiffTotalAnnually)</div>
                        </div>
                        <div class="border-top py-2">
                            <div class="text-xs text-uppercase text-gray-500">Overtaken Incumbent</div>
                            <div class="font-weight-bold text-gray-800">@compensation.Incumbents</div>
                        </div>
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase text-gray-600 mb-1">Remarks</div>
                            <textarea rows="3" class="form-control form-control-sm" readonly>compensation.Remarks</textarea>
                        </div>
                        
                        @if (!string.IsNullOrWhiteSpace(compensation.BandStatus))
                        {
                            <div class="border-top pt-2">
                                <span class="badge @(compensation.OfferRangeId is 1 or 2
                                                                          ? "badge-success"
                                                                          : compensation.OfferRangeId == 3
                                                                              ? "badge-danger"
                                                                              : "badge-info")">
                                    @if (compensation.OfferRangeId is 1 or 2)
                                    {
                                        <i class="fas fa-check mr-1" aria-hidden="true"></i>
                                    }
                                    else if (compensation.OfferRangeId == 3)
                                    {
                                        <i class="fas fa-times mr-1" aria-hidden="true"></i>
                                    }
                                    @compensation.BandStatus
                                </span>
                            </div>
                        }

                        @if (compensation.Escalate == true)
                        {
                            <div class="pt-2">
                                <span class="badge badge-warning">
                                    <i class="fas fa-exclamation-triangle mr-1" aria-hidden="true"></i>
                                    Requires Escalation
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="table-responsive">
            <!--MIRROR-->
            <table class="jo-table">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="colgroup" colspan="2">Current</th>
                        <th scope="colgroup" colspan="3" class="is-highlighted">Option @selectedOptionNumber</th>
                    </tr>
                    <tr>
                        <th scope="col">Compensation</th>
                        <th scope="col">Monthly</th>
                        <th scope="col">Annual</th>
                        <th scope="col" class="is-highlighted">Compensation</th>
                        <th scope="col" class="is-highlighted">Monthly</th>
                        <th scope="col" class="is-highlighted">Annual</th>
                    </tr>
                </thead>
                
                <tbody>
                    @foreach (var category in compenItemCategoryDto)
                    {
                        var categoryItems = category.CompensationItemDtos
                            .Where(item => item.Id != 5
                                && !(item.Id == 14 && item.CategoryId == 4))
                            .OrderBy(item => item.DisplayOrder)
                            .Select(item => new
                            {
                                Item = item,
                                CurrentItem = joCompanyCompensationItems.FirstOrDefault(jo =>
                                    jo.JOCmpnyCmpnstnId == currentJOCmpnyCmpnstnId && jo.ItemId == item.Id),
                                SelectedItem = joCompanyCompensationItems.FirstOrDefault(jo =>
                                    jo.JOCmpnyCmpnstnId == selectedJOCmpnyCmpnstnId && jo.ItemId == item.Id)
                            })
                            .ToList();

                        @if (categoryItems.Count > 0)
                        {
                            <tr>
                                <td colspan="6" class="font-weight-bold text-primary">
                                    @category.CategoryName
                                </td>
                            </tr>

                            @foreach (var categoryItem in categoryItems)
                            {
                                var item = categoryItem.Item;
                                var currentItem = categoryItem.CurrentItem;
                                var selectedItem = categoryItem.SelectedItem;

                                <tr @key="item.Id">
                                    <td>
                                        @if (item.Id != 4
                                            && item.Id != 5
                                            && item.Id != 6
                                            && item.Id != 8
                                            && item.Id != 9
                                            && item.Id != 10
                                            && item.Id != 14)
                                        {
                                            @item.ItemName
                                        }
                                    </td>
                                    <td class="text-right">@UtilitiesService.ToPeso(currentItem?.MonthlyAmount)</td>
                                    <td class="text-right">@UtilitiesService.ToPeso(currentItem?.AnnualAmount)</td>
                                    <td class="is-highlighted">
                                        @if (item.Id != 3
                                            && item.Id != 7)
                                        {
                                            @item.ItemName
                                        }
                                    </td>
                                    <td class="is-highlighted text-right">@UtilitiesService.ToPeso(selectedItem?.MonthlyAmount)</td>
                                    <td class="is-highlighted text-right">@UtilitiesService.ToPeso(selectedItem?.AnnualAmount)</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
                
                <tfoot class="has-highlighted-total">
                    <tr>
                        <th scope="row">Total</th>
                        @{
                            var currentItems = joCompanyCompensationItems.Where(jo => jo.JOCmpnyCmpnstnId == currentJOCmpnyCmpnstnId);
                        }
                        <th class="text-right">
                            @UtilitiesService.ToPeso(currentItems.Sum(jo => jo.MonthlyAmount.GetValueOrDefault()))
                        </th>
                        <th class="text-right">
                            @UtilitiesService.ToPeso(currentItems.Sum(jo => jo.AnnualAmount.GetValueOrDefault()))
                        </th>
                        <th class="is-highlighted" scope="row">Total</th>
                        @{
                            var selectedItems = joCompanyCompensationItems.Where(jo => jo.JOCmpnyCmpnstnId == selectedJOCmpnyCmpnstnId);
                        }
                        <th class="is-highlighted text-right">
                            @UtilitiesService.ToPeso(selectedItems.Sum(jo => jo.MonthlyAmount.GetValueOrDefault()))
                        </th>
                        <th class="is-highlighted text-right">
                            @UtilitiesService.ToPeso(selectedItems.Sum(jo => jo.AnnualAmount.GetValueOrDefault()))
                        </th>
                    </tr>
                </tfoot>
            </table>
            <!--MIRROR-->
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <a href="#joAnalysisComparativeView"
       class="card-header text-decoration-none"
       data-toggle="collapse"
       role="button"
       aria-expanded="false"
       aria-controls="joAnalysisComparativeView">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th scope="col">Details</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <th scope="col" class="text-center">Option @compensation.OptionNumber</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">Compensation</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-center font-weight-bold">@GetCompanyCompensationName(compensation.CmpnyCmpnstnId)</td>
                        }
                    </tr>
                    <tr>
                        <th scope="row">Proposed Salary</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-right">@UtilitiesService.ToPeso(compensation.ProposedSalary)</td>
                        }
                    </tr>
                    <tr>
                        <th scope="row">Current Salary</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-right">@UtilitiesService.ToPeso(compensation.CurrentSalary)</td>
                        }
                    </tr>
                    <tr>
                        <th scope="row">Increase</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-right">@FormatPercent(compensation.Increase)</td>
                        }
                    </tr>
                    <tr>
                        <th scope="row">Monthly Difference</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-right">@FormatPercent(compensation.DiffTotalMonthly)</td>
                        }
                    </tr>
                    <tr>
                        <th scope="row">Annual Difference</th>
                        @foreach (var compensation in ComparativeCompensations.Where(item => item.OptionNumber > 0))
                        {
                            <td class="text-right">@FormatPercent(compensation.DiffTotalAnnually)</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </a>

    <div id="joAnalysisComparativeView" class="collapse">
        <div class="card-body">
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th scope="col" rowspan="2">Compensation</th>
                            @foreach (var compensation in ComparativeCompensations)
                            {
                                <th scope="colgroup" colspan="2" class="text-center @GetOptionHighlightClass(compensation)">
                                    @(compensation.OptionNumber == 0 ? "Current" : $"Option {compensation.OptionNumber}")
                                </th>
                            }
                        </tr>
                        <tr>
                            @foreach (var compensation in ComparativeCompensations)
                            {
                                <th scope="col" class="text-center @GetOptionHighlightClass(compensation)">Monthly</th>
                                <th scope="col" class="text-center @GetOptionHighlightClass(compensation)">Annual</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemId in ComparativeItemIds.Where(itemId =>
                            joCompanyCompensationItems.Any(compensationItem =>
                                compensationItem.ItemId == itemId
                                && ((compensationItem.MonthlyAmount ?? 0) > 0
                                    || (compensationItem.AnnualAmount ?? 0) > 0))))
                        {
                            <tr @key="itemId">
                                <td>@GetCompensationItemName(itemId)</td>
                                @foreach (var compensation in ComparativeCompensations)
                                {
                                    var item = joCompanyCompensationItems.FirstOrDefault(compensationItem =>
                                        compensationItem.JOCmpnyCmpnstnId == compensation.Id && compensationItem.ItemId == itemId);
                                    <td class="text-right @GetOptionHighlightClass(compensation)">@UtilitiesService.ToPeso(item?.MonthlyAmount)</td>
                                    <td class="text-right @GetOptionHighlightClass(compensation)">@UtilitiesService.ToPeso(item?.AnnualAmount)</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">Total</th>
                            @foreach (var compensation in ComparativeCompensations)
                            {
                                var items = joCompanyCompensationItems.Where(item => item.JOCmpnyCmpnstnId == compensation.Id);
                                <th class="text-right @GetOptionHighlightClass(compensation)">@UtilitiesService.ToPeso(items.Sum(item => item.MonthlyAmount.GetValueOrDefault()))</th>
                                <th class="text-right @GetOptionHighlightClass(compensation)">@UtilitiesService.ToPeso(items.Sum(item => item.AnnualAmount.GetValueOrDefault()))</th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<CardJOActionLogs JobOfferId="@jobOfferId"
    Title="Job Offer Activity"
    Subtitle="Complete workflow and decision history."
    EmptyMessage="No activity has been recorded." />


@if (ShowGoBackUrl)
{
    <div class="jo-actions mb-4">
        <a href="@GoBackUrl" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i>
            Go Back
        </a>
    </div>
}

