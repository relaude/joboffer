
<div class="card shadow mb-4 small jo-action-log-card">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <div>
            <h6 class="jo-title mb-1">
                <i class="fas fa-stream fa-fw text-primary mr-2" aria-hidden="true"></i>@Title
            </h6>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <small class="text-muted">@Subtitle</small>
            }
        </div>
        @if (!isLoading)
        {
            <span class="badge badge-light border">@actionLogs.Count action@(actionLogs.Count == 1 ? string.Empty : "s")</span>
        }
    </div>

    <div class="card-body">
        @if (!isLoading && approvalFlow.Count > 0)
        {
            <section class="jo-approval-flow" aria-label="Approval progress">
                <h6 class="jo-title mb-3">Approval Progress</h6>
                <ol class="jo-approval-flow-steps">
                    @for (var index = 0; index < approvalFlow.Count; index++)
                    {
                        var step = approvalFlow[index];
                        var approved = step.IsAproved == true;
                        <li class="jo-approval-flow-step @(approved ? "is-approved" : "is-pending")" @key="step.Id">
                            <span class="jo-approval-flow-marker" aria-hidden="true">
                                @if (approved)
                                {
                                    <i class="fas fa-check"></i>
                                }
                                else
                                {
                                    <i class="fas fa-clock"></i>
                                }
                            </span>
                            <span class="jo-approval-flow-number">Step @(index + 1)</span>
                            <span class="jo-approval-flow-role">@DisplayValue(step.RoleName, "Role unavailable")</span>
                            <!--EDIT-->
                            <span class="jo-approval-flow-status">@GetApprovalFlowStatus(step)</span>
                            <!--EDIT-->
                        </li>
                    }
                </ol>
            </section>
        }

        @if (isLoading)
        {
            <div class="jo-action-log-state text-muted" role="status">
                <span class="spinner-border spinner-border-sm text-primary mr-2" aria-hidden="true"></span>
                Loading action history...
            </div>
        }
        else if (actionLogs.Count == 0)
        {
            <div class="jo-action-log-state text-muted">
                <i class="fas fa-history fa-2x mb-2" aria-hidden="true"></i>
                <span>@EmptyMessage</span>
            </div>
        }
        else
        {
            <div class="jo-action-log-timeline">
                @foreach (var item in actionLogs)
                {
                    <article class="jo-action-log-item" @key="item.Id">
                        <div class="jo-action-log-marker @GetMarkerClass(item.ActionId)">
                            <i class="fas @GetActionIcon(item.ActionId)" aria-hidden="true"></i>
                        </div>
                        <div class="jo-action-log-content">
                            <div class="jo-action-log-heading">
                                <div>
                                    <span class="jo-action-log-name">@DisplayValue(item.ActionName, "Unknown action") by @DisplayValue(item.ActionByName, "Unknown user")</span>
                                    <small class="d-block text-muted">@DisplayValue(item.RoleName, "Role unavailable")</small>
                                </div>
                                <time class="jo-action-log-date" datetime="@item.ActionAt?.ToString("O")">
                                    Date: @(item.ActionAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Date unavailable")
                                </time>
                            </div>
                            <div class="jo-action-log-meta flex-column">
                                <div style="overflow-wrap: anywhere; white-space: pre-wrap;">@DisplayValue(item.Remarks)</div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
