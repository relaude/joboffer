<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="jo-title">Candidate and Compensation</h6>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="mb-3">
                    <small class="text-muted d-block">Candidate Name</small>
                    <span class="font-weight-bold text-gray-900">
                        @(string.IsNullOrWhiteSpace(Candidate.CandidateName) ? "-" : Candidate.CandidateName)
                    </span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Candidate Id</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.DboxRefNum) ? "-" : Candidate.DboxRefNum)</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Email</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.EmailAddress) ? "-" : Candidate.EmailAddress)</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Contact Number</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.ContactNumber) ? "-" : Candidate.ContactNumber)</span>
                </div>
                <div>
                    <small class="text-muted d-block">Job Level / Grade</small>
                    <span class="font-weight-bold text-gray-800">
                        @(string.IsNullOrWhiteSpace(Candidate.JobLevel) ? "-" : Candidate.JobLevel) /
                        @(string.IsNullOrWhiteSpace(Candidate.GradeName) ? "-" : Candidate.GradeName)
                    </span>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="mb-3">
                    <small class="text-muted d-block">Job Position</small>
                    <span class="font-weight-bold text-gray-900">
                        @(string.IsNullOrWhiteSpace(Candidate.JobPosition) ? "-" : Candidate.JobPosition)
                    </span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Company</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.Company) ? "-" : Candidate.Company)</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Division</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.Division) ? "-" : Candidate.Division)</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Department</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.Department) ? "-" : Candidate.Department)</span>
                </div>
                <div>
                    <small class="text-muted d-block">Cost Center</small>
                    <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(Candidate.CostCenter) ? "-" : Candidate.CostCenter)</span>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="mb-3">
                    <small class="text-muted d-block">Package Type</small>
                    <span class="font-weight-bold text-gray-800">
                        @(CompensationItems.FirstOrDefault()?.CmpnyCmpnstnName ?? string.Empty)
                    </span>
                </div>

                <small class="text-muted d-block mb-2">Package Items</small>
                @if (CompensationItems.Any())
                {
                    @foreach (var item in CompensationItems.OrderBy(item => item.DisplayOrder))
                    {
                        <div class="mb-2" @key="item.Id">
                            <span class="font-weight-bold text-gray-800">@(string.IsNullOrWhiteSpace(item.ItemName) ? "-" : item.ItemName)</span>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted">No compensation items configured.</span>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public VwDboxCandidates Candidate { get; set; }
    [Parameter] public List<VwCompanyCompensationItems> CompensationItems { get; set; }
}
