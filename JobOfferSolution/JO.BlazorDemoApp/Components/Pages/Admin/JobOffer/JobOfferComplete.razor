@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.JobOfferComplete + "/{jobOfferId:int}")]

<CardJOSummary JobOffer="@vwJODboxCandidates" />
<CardCandidateCompensation Candidate="@candidate" CompensationItems="@vwCompanyCompensationItems" />

<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <button type="button" class="nav-link px-4 @(activeTab == TabName.JODetails ? "active" : string.Empty)"
                role="tab" aria-selected="@(activeTab == TabName.JODetails)" @onclick="() => SelectTab(TabName.JODetails)">
            <i class="fas fa-briefcase fa-fw mr-1" aria-hidden="true"></i>JODetails
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button type="button" class="nav-link px-4 @(activeTab == TabName.Discussion ? "active" : string.Empty)"
                role="tab" aria-selected="@(activeTab == TabName.Discussion)" @onclick="() => SelectTab(TabName.Discussion)">
            <i class="fas fa-comments fa-fw mr-1" aria-hidden="true"></i>Discussion
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button type="button" class="nav-link px-4 @(activeTab == TabName.ActionLogs ? "active" : string.Empty)"
                role="tab" aria-selected="@(activeTab == TabName.ActionLogs)" @onclick="() => SelectTab(TabName.ActionLogs)">
            <i class="fas fa-history fa-fw mr-1" aria-hidden="true"></i>Activities
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button type="button" class="nav-link px-4 @(activeTab == TabName.Email ? "active" : string.Empty)"
                role="tab" aria-selected="@(activeTab == TabName.Email)" @onclick="() => SelectTab(TabName.Email)">
            <i class="fas fa-envelope fa-fw mr-1" aria-hidden="true"></i>Email
        </button>
    </li>
</ul>

<div class="tab-content">
    @switch (activeTab)
    {
        case TabName.Email:
            <div role="tabpanel">
                @if (isLoadingEmail)
                {
                    <p class="text-muted" role="status">Loading job offer email...</p>
                }
                else if (emailId is int id)
                {
                    <JOEmailDetails EmailId="@id" />
                }
                else
                {
                    <p class="text-muted" role="status">No email is available for this job offer.</p>
                }
            </div>
            break;

        case TabName.JODetails:
            <div role="tabpanel">
                <fieldset disabled class="border-0 p-0 m-0 w-100">
                    <SharedJOAnalysis Candidate="@candidate"
                                      SalaryBand="@vwSalaryBand"
                                      Analysis="@joAnalysis"
                                      CompanyCompensations="@companyCompensation"
                                      JOCompanyCompensations="@joCompanyCompensation"
                                      JOCompanyCompensationItems="@joCompanyCompensationItems"
                                      CompensationItemCategories="@compenItemCategoryDto"
                                      ComponentId="completed-job-offer-analysis" />
                </fieldset>
            </div>
            break;

        case TabName.Discussion:
            <div role="tabpanel">
                <CardJODiscussion Discussions="@vwDiscussions"
                                  Title="Discussion Timeline"
                                  Subtitle="Completed discussion history and candidate responses." />
            </div>
            break;

        case TabName.ActionLogs:
            <div role="tabpanel">
                <CardJOActionLogs JobOfferId="@jobOfferId"
                                  Title="Job Offer Activity"
                                  Subtitle="Complete workflow and decision history."
                                  EmptyMessage="No activity has been recorded." />
            </div>
            break;
    }
</div>

<div class="jo-actions mb-4">
    <a href="@JORoutes.Admin.JobOfferTracker" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i>Go Back
    </a>
</div>
