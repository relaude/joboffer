@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.Companies)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="jo-title">Companies</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Company Code</th>
                        <th>Company Name</th>
                        <th class="text-center">Divisions</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (companies.Count > 0)
                    {
                        @foreach (var company in companies)
                        {
                            <tr @key="company.Id">
                                <td>@(string.IsNullOrWhiteSpace(company.CompanyCode) ? "-" : company.CompanyCode)</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(company.CompanyName) ? "-" : company.CompanyName)</strong></td>
                                <td class="text-center">@company.CountDivision</td>
                                <td class="text-right">
                                    <div class="dropdown">
                                        <button type="button"
                                                class="btn btn-link text-dark font-weight-bold"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                aria-label="Actions for @company.CompanyName">
                                            •••
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.Admin.CompanyDetails}/{company.Id}")">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No companies found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
