@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.CompanyDetails + "/{companyId:int}")]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="jo-title">Company Details</h6>
        <div class="jo-actions">
            <a href="@JORoutes.Admin.Companies" class="btn btn-outline-secondary">← Back</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-4 mb-3">
                <h4 class="jo-title mb-1">@(string.IsNullOrWhiteSpace(company.CompanyName) ? "-" : company.CompanyName)</h4>
                <div class="jo-code">@(string.IsNullOrWhiteSpace(company.CompanyCode) ? "-" : company.CompanyCode)</div>
            </div>

            <div class="col-lg-8">
                <div class="row">
                    <div class="col-sm-4 mb-3">
                        <div class="jo-meta-label">Divisions</div>
                        <div class="jo-meta-value">@company.CountDivision</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Divisions</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Division Code</th>
                        <th>Division Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (divisions.Any())
                    {
                        @foreach (var division in divisions)
                        {
                            <tr @key="division.Id">
                                <td>@(string.IsNullOrWhiteSpace(division.DivisionCode) ? "-" : division.DivisionCode)</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(division.DivisionName) ? "-" : division.DivisionName)</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-3">No divisions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
