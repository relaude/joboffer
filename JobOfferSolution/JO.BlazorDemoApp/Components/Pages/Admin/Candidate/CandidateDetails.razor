@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.Candidate + "/{candidateId:int}")]

<div class="card shadow mb-4" aria-busy="@(isLoading ? "true" : "false")">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h2 class="h6 m-0 font-weight-bold text-primary">Candidate Summary</h2>
        <a href="@JORoutes.Admin.Candidates" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (isLoading)
    {
        <div class="card-body"><p class="text-muted mb-0" role="status">Loading candidate...</p></div>
    }
    else if (loadError is not null)
    {
        <div class="card-body">
            <div class="alert alert-danger mb-0" role="alert">
                @loadError
                <button type="button" class="btn btn-outline-danger btn-sm ml-2" @onclick="LoadCandidateAsync">Try again</button>
            </div>
        </div>
    }
    else if (candidate is null)
    {
        <div class="card-body"><p class="text-muted mb-0" role="status">Candidate not found.</p></div>
    }
    else
    {
        <CandidateSummary Candidate="candidate" />
    }
</div>

@if (!isLoading && loadError is null && candidate is not null)
{
    <CandidateCompensation Candidate="candidate" FormatAmounts="true" />
    <CandidateBenefits Candidate="candidate" FormatAmounts="true" />
}
