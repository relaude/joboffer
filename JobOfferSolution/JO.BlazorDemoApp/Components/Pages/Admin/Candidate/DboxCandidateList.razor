@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.DboxCandidates)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3">
        <h6 class="jo-title mb-1">Search DBox candidates</h6>
        <small class="text-muted">Search any part of a candidate ID, candidate name, or email.</small>
    </div>
    <div class="card-body">
        <form @onsubmit="SearchResponses" @onsubmit:preventDefault>
            <fieldset disabled="@(isLoading || isImporting || loadError is not null)">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="dbox-candidate-id">Candidate ID</label>
                        <input id="dbox-candidate-id" class="form-control form-control-sm" @bind="candidateDBoxIdSearch" @bind:event="oninput" />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="dbox-name">Candidate name</label>
                        <input id="dbox-name" class="form-control form-control-sm" @bind="candidateNameSearch" @bind:event="oninput" />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="dbox-email">Email address</label>
                        <input id="dbox-email" type="text" class="form-control form-control-sm" @bind="emailSearch" @bind:event="oninput" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm mr-2">Search</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">Clear</button>
            </fieldset>
        </form>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
        <div>
            <h6 class="jo-title mb-1">DBox Candidate Raw Data</h6>
        </div>
        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-primary mr-2" @onclick="OpenImportModal" disabled="@(isImporting || isLoading)">
                <i class="fas fa-file-excel fa-fw mr-1" aria-hidden="true"></i>Import from Excel
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (loadError is not null)
        {
            <div class="alert alert-danger" role="alert">
                @loadError
                <button type="button" class="btn btn-outline-danger btn-sm ml-2" @onclick="LoadResponsesAsync" disabled="@(isLoading || isImporting)">Try again</button>
            </div>
        }
        <div class="table-responsive" aria-busy="@(isLoading ? "true" : "false")">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th scope="col">Candidate ID</th>
                        <th scope="col">Candidate</th>
                        <th scope="col">Email address</th>
                        <th scope="col">Job position</th>
                        <th scope="col">Company code</th>
                        <th scope="col">Division code</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4" role="status">Loading DBox candidates...</td></tr>
                    }
                    else if (loadError is not null)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">DBox candidates could not be loaded.</td></tr>
                    }
                    else if (responses.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No candidates found. Import an Excel workbook to populate this list.</td></tr>
                    }
                    else if (pagedResponses.TotalCount == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4" role="status">No candidates match your search. Change or clear the filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var response in pagedResponses.Data)
                        {
                            <tr @key="response.Id">
                                <td>@DisplayValue(response.CandidateId)</td>
                                <td class="jo-title">@DisplayValue(response.CandidateName)</td>
                                <td>@DisplayValue(response.EmailAddress)</td>
                                <td>@DisplayValue(response.JobPosition)</td>
                                <td>@DisplayValue(response.Company)</td>
                                <td>@DisplayValue(response.Division)</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6">
                            <Pagination Result="@pagedResponses" PageChanged="ChangePage" PageSizeChanged="ChangePageSize" Disabled="@(isLoading || isImporting || loadError is not null)" AriaLabel="DBox candidate pages" />
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<JOModal @ref="importModal" Title="Import from Excel" ModalSize="modal-lg">
    <ChildContent>
        <div class="form-group mb-0">
            <label for="dbox-excel-file">Excel file</label>
            <InputFile id="dbox-excel-file" class="form-control-file" accept=".xlsx" OnChange="SelectImportFile" disabled="@isImporting" />
        </div>
    </ChildContent>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseImportModal" disabled="@isImporting">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" @onclick="ImportExcelAsync" disabled="@isImporting">@(isImporting ? "Importing..." : "Import")</button>
    </FooterTemplate>
</JOModal>
