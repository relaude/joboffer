@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.UserDetails)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="jo-title">User Information</h6>

        <div>
            <a class="btn btn-outline-secondary mr-2" href="@JORoutes.Admin.Users">
                <i class="fas fa-times fa-fw mr-1"></i>Cancel
            </a>
            <button type="button" class="btn btn-primary" disabled="@isSaving" @onclick="SaveUser">
                <i class="fas fa-save fa-fw mr-1"></i>Save
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="form-group">
            <label for="user-name" class="font-weight-bold text-gray-700">User Name</label>
            <input id="user-name"
                   type="text"
                   class="form-control"
                   @bind="newUser.Name" />
        </div>

        <div class="form-group mb-0">
            <label for="user-email" class="font-weight-bold text-gray-700">Email</label>
            <input id="user-email"
                   type="email"
                   class="form-control"
                   @bind="newUser.Email" />
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3">
        <h6 class="jo-title">Roles</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead class="thead-light">
                    <tr>
                        <th scope="col" class="text-center">
                            <input type="checkbox"
                                   checked="@AreAllRolesSelected"
                                   @onchange="ToggleAllRoles"
                                   aria-label="Check or uncheck all roles" />
                        </th>
                        <th scope="col">Role Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (roles.Count > 0)
                    {
                        @foreach (var role in roles.Where(jo => jo.IsActive == true).OrderBy(jo => jo.OrderBy))
                        {
                            <tr @key="role.Id">
                                <td class="text-center">
                                    <input type="checkbox"
                                           checked="@IsRoleSelected(role.RoleName)"
                                           disabled="@string.IsNullOrWhiteSpace(role.RoleName)"
                                           @onchange="@(eventArgs => ToggleRole(role.RoleName, eventArgs))"
                                           aria-label="Select @role.RoleName" />
                                </td>
                                <td><strong>@(string.IsNullOrWhiteSpace(role.RoleName) ? "-" : role.RoleName)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(role.Description) ? "-" : role.Description)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">No roles found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Division Access</h6>
    </div>
    <div class="card-body">
        <p class="text-muted">
            @(IsDivisionAccessRequired
                ? "Select at least one division for the Division Head Approver L1 or Division Head Approver L2 role."
                : "Optional. Select the divisions this user can access.")
        </p>
        <p class="text-muted">Selected divisions across all companies: @selectedDivisionIds.Count</p>
        <div class="form-group row mb-4">
            <div class="col-sm-10 col-md-6">
                <label for="company" class="font-weight-bold text-gray-700">Company</label>
                <select id="company"
                        class="custom-select"
                        value="@selectedCompanyId"
                        @onchange="OnCompanyChanged">
                    <option value="">Select company</option>
                    @foreach (var company in companies)
                    {
                        <option value="@company.Id">
                            @(string.IsNullOrWhiteSpace(company.CompanyName) ? company.CompanyCode : company.CompanyName)
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 90px;">
                            <input type="checkbox"
                                   checked="@AreAllDivisionsSelected"
                                   disabled="@(!divisions.Any())"
                                   @onchange="ToggleAllDivisions"
                                   aria-label="Select all divisions" />
                        </th>
                        <th>Division Code</th>
                        <th>Division Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (divisions.Any())
                    {
                        @foreach (var division in divisions)
                        {
                            <tr @key="division.Id">
                                <td class="text-center">
                                    <input type="checkbox"
                                           checked="@selectedDivisionIds.Contains(division.Id)"
                                           @onchange="eventArgs => ToggleDivision(division.Id, eventArgs)"
                                           aria-label="Select @division.DivisionName" />
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(division.DivisionCode) ? "-" : division.DivisionCode)</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(division.DivisionName) ? "-" : division.DivisionName)</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">
                                @(selectedCompanyId.HasValue ? "No divisions found." : "Select a company to display its divisions.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
