@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.EditUser + "/{joUserId:int}")]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-user-edit fa-fw mr-2"></i>User Information
        </h6>

        <div>
            <a class="btn btn-outline-secondary mr-2"
               href="@($"{JORoutes.Admin.UserDetails}/{joUserId}")">
                <i class="fas fa-times fa-fw mr-1"></i>Cancel
            </a>
            <button type="button" class="btn btn-primary" @onclick="SaveUser">
                <i class="fas fa-save fa-fw mr-1"></i>Save
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="form-group">
            <label for="user-name" class="font-weight-bold text-gray-700">User Name</label>
            <input id="user-name" type="text" class="form-control" @bind="jobOfferUser.Name" />
        </div>

        <div class="form-group">
            <label for="user-email" class="font-weight-bold text-gray-700">Email</label>
            <input id="user-email" type="email" class="form-control" @bind="jobOfferUser.Email" />
        </div>

        <div class="form-group mb-0">
            <div class="custom-control custom-switch">
                <input id="user-active"
                       type="checkbox"
                       class="custom-control-input"
                       checked="@(jobOfferUser.IsActive == true)"
                       @onchange="ToggleIsActive" />
                <label class="custom-control-label font-weight-bold text-gray-700" for="user-active">
                    @(jobOfferUser.IsActive == true ? "Active" : "Inactive")
                </label>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-user-tag fa-fw mr-2"></i>Roles
        </h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead class="thead-light">
                    <tr>
                        <th scope="col" class="text-center">
                            <input type="checkbox"
                                   checked="@AreAllRolesSelected"
                                   @onchange="ToggleAllRoles"
                                   aria-label="Check or uncheck all roles" />
                        </th>
                        <th scope="col">Role Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (roles.Count > 0)
                    {
                        @foreach (var role in roles.Where(item => item.IsActive == true).OrderBy(item => item.OrderBy))
                        {
                            <tr @key="role.Id">
                                <td class="text-center">
                                    <input type="checkbox"
                                           checked="@IsRoleSelected(role.RoleName)"
                                           disabled="@string.IsNullOrWhiteSpace(role.RoleName)"
                                           @onchange="@(eventArgs => ToggleRole(role.RoleName, eventArgs))"
                                           aria-label="Select @role.RoleName" />
                                </td>
                                <td><strong>@(string.IsNullOrWhiteSpace(role.RoleName) ? "-" : role.RoleName)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(role.Description) ? "-" : role.Description)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">No roles found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
