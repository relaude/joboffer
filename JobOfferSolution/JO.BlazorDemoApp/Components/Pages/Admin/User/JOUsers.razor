@attribute [Authorize(Roles = JOUserRole.Admin)]
@attribute [Route(JORoutes.Admin.Users)]

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-users fa-fw mr-2"></i>Job Offer Users
        </h6>

        <a class="btn btn-primary" href="@JORoutes.Admin.UserDetails">
            <i class="fas fa-user-plus fa-fw mr-1"></i>New User
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th class="text-center">Roles</th>
                        <th class="text-center">Status</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (jobOfferUsers.Count > 0)
                    {
                        @foreach (var user in jobOfferUsers)
                        {
                            <tr @key="user.Id">
                                <td><strong>@(string.IsNullOrWhiteSpace(user.Name) ? "-" : user.Name)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)</td>
                                <td class="text-center">@user.CountRoles</td>
                                <td class="text-center">
                                    @if (user.IsActive == true)
                                    {
                                        <span class="text-success">
                                            <i class="fas fa-check-circle fa-fw mr-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-times-circle fa-fw mr-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(user.CreatedByName) ? "-" : user.CreatedByName)</div>
                                    <small class="text-muted">@(user.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(user.ModifiedByName) ? "-" : user.ModifiedByName)</div>
                                    <small class="text-muted">@(user.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                                </td>
                                <td class="text-right">
                                    <div class="dropdown">
                                        <button type="button"
                                                class="btn btn-link text-dark font-weight-bold"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                aria-label="Actions for @user.Name">
                                            •••
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.Admin.UserDetails}/{user.Id}")">
                                                View
                                            </a>
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.Admin.EditUser}/{user.Id}")">
                                                Edit
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
