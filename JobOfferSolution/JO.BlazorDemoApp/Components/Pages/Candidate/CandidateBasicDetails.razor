<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="jo-title">Candidate</h6>
    </div>

    <div class="card-body">
        <!--EDIT-->
        <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
                <small class="text-muted d-block">Candidate Name</small>
                <span class="font-weight-bold text-gray-900">@Candidate.CandidateName</span>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Job Position</small>
                <span class="font-weight-bold text-gray-900">@Candidate.JobPosition</span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="mb-3">
                    <small class="text-muted d-block">Candidate Id</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.DboxRefNum</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Email</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.EmailAddress</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Contact Number</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.ContactNumber</span>
                </div>
                <div>
                    <small class="text-muted d-block">Job Level / Grade</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.JobLevel / @Candidate.GradeName</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="mb-3">
                    <small class="text-muted d-block">Company</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.Company</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Division</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.Division</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Department</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.Department</span>
                </div>
                <div>
                    <small class="text-muted d-block">Cost Center</small>
                    <span class="font-weight-bold text-gray-800">@Candidate.CostCenter</span>
                </div>
            </div>
        </div>
        <!--EDIT-->
    </div>
</div>

@code {
    [Parameter] public VwDboxCandidates Candidate { get; set; }
}
