<div class="card shadow small mb-4">
    <div class="card-header">
        <h2 class="h6 m-0 font-weight-bold text-primary">
            @(Items.FirstOrDefault()?.CmpnyCmpnstnName ?? string.Empty)
        </h2>

    </div>
    <div class="card-body">
        @foreach (var item in Items.OrderBy(item => item.DisplayOrder))
        {
            <div class="custom-control">
                <span class="font-weight-bold text-gray-800">@item.ItemName</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<VwCompanyCompensationItems> Items { get; set; }
}
