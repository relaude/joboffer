<div class="card-body small">
    <div class="row">
        <div class="col-lg-6 mb-4 border-bottom pb-4">
            <h3 class="h6 font-weight-bold text-gray-800 mb-2">Candidate Information</h3>
        <div class="table-responsive">
            <table class="jo-table">
                <tbody>
                    <tr><td>Candidate ID</td><td class="font-weight-bold text-gray-800">@Candidate.DboxRefNum</td></tr>
                    <tr><td>Candidate Name</td><td class="font-weight-bold text-gray-800">@Candidate.CandidateName</td></tr>
                    <tr><td>Email Address</td><td class="font-weight-bold text-gray-800">@Candidate.EmailAddress</td></tr>
                    <tr><td>Position Applied For</td><td class="font-weight-bold text-gray-800">@Candidate.JobPosition</td></tr>
                    <tr><td>Company</td><td class="font-weight-bold text-gray-800">@Candidate.CompanyName</td></tr>
                    <tr><td>Division</td><td class="font-weight-bold text-gray-800">@Candidate.Division</td></tr>
                    <tr><td>Department</td><td class="font-weight-bold text-gray-800">@Candidate.Department</td></tr>
                    <tr><td>Job Level</td><td class="font-weight-bold text-gray-800">@Candidate.JobLevel</td></tr>
                    <tr><td>Cost Center</td><td class="font-weight-bold text-gray-800">@Candidate.CostCenter</td></tr>
                    <tr><td>Grade</td><td class="font-weight-bold text-gray-800">@Candidate.GradeName</td></tr>
                </tbody>
            </table>
        </div>
        </div>

        <div class="col-lg-6 mb-4 border-bottom pb-4">
            <h3 class="h6 font-weight-bold text-gray-800 mb-2">Work Experience</h3>
        <div class="table-responsive">
            <table class="jo-table">
                <tbody>
                    <tr><td>Employment Status</td><td class="font-weight-bold text-gray-800">@Candidate.EmploymentStatus</td></tr>
                    <tr><td>Relevant Experience</td><td class="font-weight-bold text-gray-800">@Candidate.RelevantExperience</td></tr>
                    <tr><td>Current Employer</td><td class="font-weight-bold text-gray-800">@Candidate.CurrentEmployerName</td></tr>
                    <tr><td>Last Employer Industry</td><td class="font-weight-bold text-gray-800">@Candidate.LastEmployerIndustry</td></tr>
                    <tr><td>Last Position Held</td><td class="font-weight-bold text-gray-800">@Candidate.LastPositionHeld</td></tr>
                </tbody>
            </table>
        </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public VwDboxCandidates Candidate { get; set; }
}
