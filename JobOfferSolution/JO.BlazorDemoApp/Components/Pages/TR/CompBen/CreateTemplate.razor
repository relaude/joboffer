@attribute [Authorize(Roles = JOUserRole.TR)]
@attribute [Route(JORoutes.TR.TemplateNew)]

<div class="jo-content-page">
    <main class="jo-main">

        <header class="jo-header">
            <div>
                <span class="jo-eyebrow">TOTAL REWARDS</span>
                <h1>Create Package</h1>
                <p>Define a reusable package for regular, project-hire, or consultant offers.</p>
            </div>
        </header>

        <section class="jo-section">
            <div class="jo-section-heading">
                <h2>Package information</h2>
            </div>

            <div class="jo-grid">
                <label class="jo-col-4">
                    Name <span class="text-danger">*</span>
                    <input class="form-control"
                           placeholder="e.g. Regular Hire — Standard"
                           @bind="compBenPckgs.PckgName" />
                </label>

                <label class="jo-col-4">
                    Company <span class="text-danger">*</span>
                    <select class="custom-select" value="@compBenPckgs.CompId">
                        @foreach (var option in companies)
                        {
                            <option value="@option.Id">@option.CompanyName</option>
                        }
                    </select>
                </label>

                <label class="jo-col-4">
                    Template
                    <select class="custom-select" value="@templateId" @onchange="OnTemplateChanged">
                        <option value="0">None</option>
                        @foreach (var option in templates)
                        {
                            <option value="@option.Id">@option.PlanName</option>
                        }
                    </select>
                </label>
            </div>
        </section>

        <div class="jo-grid">
            <div class="jo-col-6">
                <section class="jo-section">
                    <div class="jo-section-heading">
                        <h2>Employment setup</h2>
                    </div>

                    <div class="jo-form-grid">
                        <label>
                            Status <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.TypeId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in empTypes)
                                {
                                    <option value="@option.Id">@option.TypeName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Work Area <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.AreaId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in workArea)
                                {
                                    <option value="@option.Id">@option.AreaName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Shift Code <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.ShiftId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in shiftCode)
                                {
                                    <option value="@option.Id">@option.ShiftName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Work Schedule <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.SchedId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in workSched)
                                {
                                    <option value="@option.Id">@option.SchedName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Job Class <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.ClassId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in jobClass)
                                {
                                    <option value="@option.Id">@option.ClassName</option>
                                }
                            </select>
                        </label>
                        <label>
                            MRI <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.MRIId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in compBenMRI)
                                {
                                    <option value="@option.Id">@option.MRIName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Frequency <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.FreqId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in compBenFreq)
                                {
                                    <option value="@option.Id">@option.FreqName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Salaray Grade <span class="text-danger">*</span>
                            <select class="custom-select" value="@compBenPckgs.SGId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in salaryGrades)
                                {
                                    <option value="@option.Id">@option.GradeName</option>
                                }
                            </select>
                        </label>
                    </div>
                </section>
            </div>
            
            <div class="jo-col-6">
                <section class="jo-section">
                    <div class="jo-section-heading">
                        <h2>Eligibility rules</h2>
                    </div>
                    <div class="jo-toggle-grid">
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Swipe" /><span class="jo-toggle-control"></span>Swiping</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.AllowTrans" /><span class="jo-toggle-control"></span>Transpo Allowance</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Motorized" /><span class="jo-toggle-control"></span>Motorized</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Incentive" /><span class="jo-toggle-control"></span>Incentivized</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Annual" /><span class="jo-toggle-control"></span>Annual Bonus</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.AllowSpec" /><span class="jo-toggle-control"></span>Special Allowance</label>
                    </div>
                </section>
            </div>
        </div>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <h2>Benefit items</h2>
                </div>
                <button class="btn btn-outline-primary" @onclick="AddItem">+&nbsp; Add benefit item</button>
            </div>
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in compBenItemsDto)
                        {
                            <tr @key="item">
                                <td>
                                    <select class="custom-select form-control-sm"
                                        @bind="item.CatId"
                                        disabled="@(item.Id > 0)">
                                        @foreach (var option in itemCat)
                                        {
                                            <option value="@option.Id">@option.CatName</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" 
                                        rows="3"
                                        @bind="item.ItmName" readonly="@(item.Id > 0)" />
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" 
                                        rows="3"
                                        @bind="item.ItmDesc" readonly="@(item.Id > 0)" />
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="1000"
                                           step="1000"
                                           readonly="@(item.Id > 0)"
                                           @bind="item.Amount" />
                                </td>
                                <td>
                                    <button class="btn btn-outline-danger btn-circle btn-sm"
                                            title="Remove Item"
                                            aria-label="Remove Item"
                                            @onclick="() => RemoveItem(item)">
                                        <i class="fas fa-trash-alt fa-fw"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

@inject IBenefitsService BenefitsService

@code {
    private CompBenPckgs compBenPckgs = new();

    private List<Companies> companies = new();
    private List<VwCompBenPlans> templates = new();

    private List<CompBenEmpType> empTypes = new();
    private List<CompBenArea> workArea = new();
    private List<CompBenShift> shiftCode = new();
    private List<CompBenSched> workSched = new();
    private List<CompBenClass> jobClass = new();
    private List<CompBenMRI> compBenMRI = new();
    private List<CompBenFreq> compBenFreq = new();
    private List<SalaryGrades> salaryGrades = new();

    private List<CompBenItemsDto> compBenItemsDto = new();
    private List<CompBenItems> compBenItems = new();
    private List<CompBenItmCat> itemCat = new();

    private int templateId = 0;

    protected override async Task OnInitializedAsync()
    {
        companies = await BenefitsService.GetCompanies();
        templates = await BenefitsService.GetVwCompBenPlans();

        empTypes = await BenefitsService.GetCompBenEmpType();
        workArea = await BenefitsService.GetCompBenArea();
        shiftCode = await BenefitsService.GetCompBenShift();
        workSched = await BenefitsService.GetCompBenSched();
        jobClass = await BenefitsService.GetCompBenClass();
        compBenMRI = await BenefitsService.GetCompBenMRI();
        compBenFreq = await BenefitsService.GetCompBenFreq();
        salaryGrades = await BenefitsService.GetSalaryGrades();

        itemCat = await BenefitsService.GetCompBenItmCat();
        compBenItems = await BenefitsService.GetCompBenItems();

        templateId = templates.FirstOrDefault().Id;
        await OnTemplateChanged(new ChangeEventArgs
        {
            Value = templateId
        });

        FillCompBenItemsDto();
    }

    private void FillCompBenItemsDto()
    {
        compBenItemsDto.Clear();
        foreach (var item in compBenItems)
        {
            compBenItemsDto.Add(new CompBenItemsDto
            {
                Id = item.Id,
                Amount = item.Amount.GetValueOrDefault(),
                CatId = item.CatId.GetValueOrDefault(),
                ItmDesc = item.ItmDesc,
                ItmName = item.ItmName
            });
        }
    }

    private void AddItem()
    {
        compBenItemsDto.Add(new CompBenItemsDto
        {
            Id = 0,
            Amount = 0,
            CatId = 1,
            ItmDesc = "",
            ItmName = ""
        });
    }

    private void RemoveItem(CompBenItemsDto item)
    {
        compBenItemsDto.Remove(item);
    }

    private async Task OnTemplateChanged(ChangeEventArgs e)
    {
        templateId = int.TryParse(e.Value?.ToString(), out var tmplId)
            ? tmplId
            : 0;

        if (templateId == 0)
        {
            ZeroCompBenPckgs();
            compBenItemsDto.Clear();
            return;
        }

        var plan = templates.FirstOrDefault(jo=>jo.Id==templateId);

        compBenPckgs.TypeId = plan.TypeId;
        compBenPckgs.AreaId = plan.AreaId;
        compBenPckgs.ShiftId = plan.ShiftId;
        compBenPckgs.SchedId = plan.SchedId;
        compBenPckgs.ClassId = plan.ClassId;
        compBenPckgs.MRIId = plan.MRIId;
        compBenPckgs.FreqId = plan.FreqId;
        compBenPckgs.SGId = plan.SGId;

        compBenPckgs.Swipe = plan.Swipe;
        compBenPckgs.AllowTrans = plan.AllowTrans;
        compBenPckgs.Motorized = plan.Motorized;
        compBenPckgs.Incentive = plan.Incentive;
        compBenPckgs.Annual = plan.Annual;
        compBenPckgs.AllowSpec = plan.AllowSpec;

        FillCompBenItemsDto();
    }

    private void ZeroCompBenPckgs()
    {
        compBenPckgs.TypeId = 0;
        compBenPckgs.AreaId = 0;
        compBenPckgs.ShiftId = 0;
        compBenPckgs.SchedId = 0;
        compBenPckgs.ClassId = 0;
        compBenPckgs.MRIId = 0;
        compBenPckgs.FreqId = 0;
        compBenPckgs.SGId = 0;

        compBenPckgs.Swipe = false;
        compBenPckgs.AllowTrans = false;
        compBenPckgs.Motorized = false;
        compBenPckgs.Incentive = false;
        compBenPckgs.Annual = false;
        compBenPckgs.AllowSpec = false;
    }
}
