@attribute [Authorize(Roles = JOUserRole.TR)]
@attribute [Route(JORoutes.TR.CompBenNew)]

<div class="jo-content-page">
    <main class="jo-main">

        <header class="jo-header">
            <div>
                <span class="jo-eyebrow">TOTAL REWARDS</span>
                <h1>Create Package</h1>
                <p>Define a reusable package for regular, project-hire, or consultant offers.</p>
            </div>
        </header>

        <section class="jo-section">
            <div class="jo-section-heading">
                <h2>Package information</h2>
            </div>

            <div class="jo-grid">
                <label class="jo-col-4">
                    Name <span class="text-danger">*</span>
                    <input class="form-control"
                           placeholder="e.g. Regular Hire — Standard"
                           @bind="compBenPckgs.PckgName" />
                </label>

                <label class="jo-col-4">
                    Company <span class="text-danger">*</span>
                    <select class="custom-select" 
                        @bind="compBenPckgs.CompId">
                        <option value="0">- Please select -</option>
                        @foreach (var option in companies)
                        {
                            <option value="@option.Id">@option.CompanyName</option>
                        }
                    </select>
                </label>

                <label class="jo-col-4">
                    Employment Setup Template
                    <select class="custom-select" 
                        value="@templateId" 
                        @onchange="OnTemplateChanged">
                        <option value="0">- Please select -</option>
                        @foreach (var option in templates)
                        {
                            <option value="@option.Id">@option.PlanName</option>
                        }
                    </select>
                </label>
            </div>
        </section>

        <div class="jo-grid">
            <div class="jo-col-6">
                <section class="jo-section">
                    <div class="jo-section-heading">
                        <h2>Employment setup</h2>
                    </div>

                    <div class="jo-form-grid">
                        <label>
                            Status <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.TypeId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in empTypes)
                                {
                                    <option value="@option.Id">@option.TypeName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Work Area <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.AreaId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in workArea)
                                {
                                    <option value="@option.Id">@option.AreaName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Shift Code <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.ShiftId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in shiftCode)
                                {
                                    <option value="@option.Id">@option.ShiftName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Work Schedule <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.SchedId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in workSched)
                                {
                                    <option value="@option.Id">@option.SchedName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Job Class <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.ClassId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in jobClass)
                                {
                                    <option value="@option.Id">@option.ClassName</option>
                                }
                            </select>
                        </label>
                        <label>
                            MRI <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.MRIId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in compBenMRI)
                                {
                                    <option value="@option.Id">@option.MRIName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Frequency <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.FreqId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in compBenFreq)
                                {
                                    <option value="@option.Id">@option.FreqName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Salaray Grade <span class="text-danger">*</span>
                            <select class="custom-select" @bind="compBenPckgs.SGId">
                                <option value="0">- Please select -</option>
                                @foreach (var option in salaryGrades)
                                {
                                    <option value="@option.Id">@option.GradeName</option>
                                }
                            </select>
                        </label>
                    </div>
                </section>
            </div>
            
            <div class="jo-col-6">
                <section class="jo-section">
                    <div class="jo-section-heading">
                        <h2>Eligibility rules</h2>
                    </div>
                    <div class="jo-toggle-grid">
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Swipe" /><span class="jo-toggle-control"></span>Swiping</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.AllowTrans" /><span class="jo-toggle-control"></span>Transpo Allowance</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Motorized" /><span class="jo-toggle-control"></span>Motorized</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Incentive" /><span class="jo-toggle-control"></span>Incentivized</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.Annual" /><span class="jo-toggle-control"></span>Annual Bonus</label>
                        <label class="jo-toggle"><input type="checkbox" @bind="compBenPckgs.AllowSpec" /><span class="jo-toggle-control"></span>Special Allowance</label>
                    </div>
                </section>
            </div>
        </div>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <h2>Benefit items</h2>
                </div>
                <div class="jo-actions">
                    <button class="btn btn-outline-primary" @onclick="AddItem">+&nbsp; Add new item</button>
                    <button class="btn btn-outline-primary" @onclick="() => ShowItemsModal()">+&nbsp; Add existing item</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in compBenItemsDto)
                        {
                            <tr @key="item">
                                <td>
                                    <select class="custom-select form-control-sm"
                                        @bind="item.CatId"
                                        disabled="@(item.Id > 0)">
                                        @foreach (var option in itemCat)
                                        {
                                            <option value="@option.Id">@option.CatName</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" 
                                        rows="3"
                                        @bind="item.ItmName" readonly="@(item.Id > 0)" />
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" 
                                        rows="3"
                                        @bind="item.ItmDesc" readonly="@(item.Id > 0)" />
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="1000"
                                           step="1000"
                                           @bind="item.Amount" />
                                </td>
                                <td>
                                    <button class="btn btn-outline-danger btn-circle btn-sm"
                                            title="Remove Item"
                                            aria-label="Remove Item"
                                            @onclick="() => RemoveItem(item)">
                                        <i class="fas fa-trash-alt fa-fw"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="jo-actions">
            <a href="@JORoutes.TR.CompBen" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-primary" @onclick="SavePackage">Save As Template</button>
            <button type="button" class="btn btn-primary" @onclick="SavePackage">Save</button>
        </div>

    </main>
</div>

<JOModal @ref="modalExistItem" Title="Items">
    <ChildContent>
        <div class="jo-modal-sections">
            <section class="jo-modal-section" aria-labelledby="item-filter-heading">
                <div class="jo-filter-field">
                    <label for="item-category-filter">Category</label>
                    <select id="item-category-filter" 
                        class="custom-select form-control"
                        value="@modalCatId"
                        @onchange="OnModalCategoryChanged">
                        @foreach (var option in itemCat)
                        {
                            <option value="@option.Id">@option.CatName</option>
                        }
                    </select>
                </div>
            </section>

            <div class="table-responsive jo-table-frame">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th class="jo-select-column">Select</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="jo-text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (modalCompBenItems.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="jo-empty-state">No benefit items are available.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in modalCompBenItems)
                            {
                                <tr>
                                    <td class="jo-select-column">
                                        <input type="checkbox"
                                               class="jo-table-checkbox"
                                               aria-label="Select @item.ItmName" 
                                               checked="@selectedModalItems.Contains(item.Id)" 
                                               @onchange="e => UpdateItemSelection(item.Id, (bool)e.Value!)" />
                                    </td>
                                    <td class="jo-title">@item.ItmName</td>
                                    <td>@item.ItmDesc</td>
                                    <td class="jo-text-end">@UtilitiesService.ToPeso(item.Amount.GetValueOrDefault())</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </ChildContent>
    <FooterTemplate>
        <div class="jo-actions">
            <button class="btn btn-outline-primary btn-sm"
                    @onclick="AddSelected"
                    disabled="@(!selectedModalItems.Any())">
                Add Selected
            </button>
        </div>
    </FooterTemplate>
</JOModal>

@inject IBenefitsService BenefitsService
@inject IUtilitiesService UtilitiesService
@inject IAlertService AlertService
@inject IAccountService AccountService
@inject NavigationManager Navigation

@code {
    private CompBenPckgs compBenPckgs = new();

    private List<Companies> companies = new();
    private List<VwCompBenPlans> templates = new();

    private List<CompBenEmpType> empTypes = new();
    private List<CompBenArea> workArea = new();
    private List<CompBenShift> shiftCode = new();
    private List<CompBenSched> workSched = new();
    private List<CompBenClass> jobClass = new();
    private List<CompBenMRI> compBenMRI = new();
    private List<CompBenFreq> compBenFreq = new();
    private List<SalaryGrades> salaryGrades = new();
    private List<VwSalaryBands> salaryBands = new();

    private List<CompBenItemsDto> compBenItemsDto = new();
    private List<CompBenItems> compBenItems = new();
    private List<CompBenItmCat> itemCat = new();
    private List<CBPlnHasItem> cbPlnHasItem = new();
    private int templateId = 0;

    private JOModal modalExistItem = default!;
    private List<CompBenItems> modalCompBenItems = new();
    private int modalCatId = 0;
    private List<int> selectedModalItems = new();

    protected override async Task OnInitializedAsync()
    {
        companies = await BenefitsService.GetCompanies();
        templates = await BenefitsService.GetVwCompBenPlans();

        empTypes = await BenefitsService.GetCompBenEmpType();
        workArea = await BenefitsService.GetCompBenArea();
        shiftCode = await BenefitsService.GetCompBenShift();
        workSched = await BenefitsService.GetCompBenSched();
        jobClass = await BenefitsService.GetCompBenClass();
        compBenMRI = await BenefitsService.GetCompBenMRI();
        compBenFreq = await BenefitsService.GetCompBenFreq();
        salaryGrades = await BenefitsService.GetSalaryGrades();

        itemCat = await BenefitsService.GetCompBenItmCat();
        compBenItems = await BenefitsService.GetCompBenItems();
        cbPlnHasItem = await BenefitsService.GetCBPlnHasItem();

        compBenPckgs.CompId = 0;
        templateId = 0;

        FillCompBenItemsDto();
    }

    #region Validation
    public async Task SavePackage()
    {
        var errors = await CollectErrors(new List<string>());

        if (errors.Any())
        {
            await AlertService.Errors(errors);
            return;
        }

        if (!await AlertService.Confirm()) return;

        compBenPckgs.CreatedBy = await AccountService.GetJobOfferUserId();
        int newId = await BenefitsService.SavePackage(compBenPckgs, compBenItemsDto);

        Navigation.NavigateTo($"{JORoutes.TR.CompBen}/{newId}");
    }

    private async Task<List<string>> CollectErrors(List<string> errors)
    {
        if (string.IsNullOrEmpty(compBenPckgs.PckgName))
            errors.Add("Package Name is required.");

        if (compBenPckgs.CompId == 0)
            errors.Add("Company is required.");

        if (compBenPckgs.TypeId == 0)
            errors.Add("Employment setup Status is required.");

        if (compBenPckgs.AreaId == 0)
            errors.Add("Employment setup Work Area is required.");

        if (compBenPckgs.ShiftId == 0)
            errors.Add("Employment setup Shift Code is required.");

        if (compBenPckgs.SchedId == 0)
            errors.Add("Employment setup Work Schedule is required.");

        if (compBenPckgs.ClassId == 0)
            errors.Add("Employment setup Job Class is required.");

        if (compBenPckgs.MRIId == 0)
            errors.Add("Employment setup MRI is required.");

        if (compBenPckgs.FreqId == 0)
            errors.Add("Employment setup Frequency is required.");

        if (compBenPckgs.SGId == 0)
            errors.Add("Employment setup Salaray Grade is required.");

        if (!compBenItemsDto.Any())
            errors.Add("Benefit Items is required.");

        if (compBenPckgs.CompId > 0 && compBenPckgs.SGId > 0)
        {
            bool hasSalaryGrade = await BenefitsService
                .HasSalaryGrade(compBenPckgs.CompId.GetValueOrDefault(), 
                    compBenPckgs.SGId.GetValueOrDefault());

            if (hasSalaryGrade == false)
                errors.Add("The selected salary grade does not have an assigned salary matrix.");
        }

        else CollectItemsErrors(errors);
        
        return errors;
    }

    private void CollectItemsErrors(List<string> errors)
    {
        for (var index = 0; index < compBenItemsDto.Count; index++)
        {
            var compBenItem = compBenItemsDto[index];
            var rowNumber = index + 1;

            if (string.IsNullOrEmpty(compBenItem.ItmName))
                errors.Add($"Benefit Item Row {rowNumber}: Name is required.");

            if (string.IsNullOrEmpty(compBenItem.ItmDesc))
                errors.Add($"Benefit Item Row {rowNumber}: Description is required.");

            if (compBenItem.Amount < 0)
                errors.Add($"Benefit Item Row {rowNumber}: Invalid Amount.");
        }
    }
    #endregion

    #region Submit Form
    private void FillCompBenItemsDto()
    {
        // var itemIds = cbPlnHasItem
        //     .Where(x => x.PlanId == templateId && x.ItemId.HasValue)
        //     .Select(x => x.ItemId!.Value)
        //     .ToHashSet();

        // compBenItemsDto.Clear();

        foreach (var item in compBenItems)
        {
            compBenItemsDto.Add(new CompBenItemsDto
            {
                Id = item.Id,
                Amount = item.Amount ?? 0m,
                CatId = item.CatId ?? 0,
                ItmDesc = item.ItmDesc,
                ItmName = item.ItmName
            });
        }
    }

    private void AddItem()
    {
        compBenItemsDto.Add(new CompBenItemsDto
        {
            Id = 0,
            Amount = 0,
            CatId = 1,
            ItmDesc = "",
            ItmName = ""
        });
    }

    private void RemoveItem(CompBenItemsDto item)
    {
        compBenItemsDto.Remove(item);
    }

    private async Task OnTemplateChanged(ChangeEventArgs e)
    {
        templateId = int.TryParse(e.Value?.ToString(), out var tmplId)
            ? tmplId
            : 0;

        if (templateId == 0)
        {
            ZeroCompBenPckgs();
            compBenItemsDto.Clear();
            return;
        }

        var plan = templates.FirstOrDefault(jo=>jo.Id==templateId);

        compBenPckgs.TypeId = plan.TypeId;
        compBenPckgs.AreaId = plan.AreaId;
        compBenPckgs.ShiftId = plan.ShiftId;
        compBenPckgs.SchedId = plan.SchedId;
        compBenPckgs.ClassId = plan.ClassId;
        compBenPckgs.MRIId = plan.MRIId;
        compBenPckgs.FreqId = plan.FreqId;
        compBenPckgs.SGId = plan.SGId;

        compBenPckgs.Swipe = plan.Swipe;
        compBenPckgs.AllowTrans = plan.AllowTrans;
        compBenPckgs.Motorized = plan.Motorized;
        compBenPckgs.Incentive = plan.Incentive;
        compBenPckgs.Annual = plan.Annual;
        compBenPckgs.AllowSpec = plan.AllowSpec;

        //FillCompBenItemsDto();
    }

    private void ZeroCompBenPckgs()
    {
        compBenPckgs.TypeId = 0;
        compBenPckgs.AreaId = 0;
        compBenPckgs.ShiftId = 0;
        compBenPckgs.SchedId = 0;
        compBenPckgs.ClassId = 0;
        compBenPckgs.MRIId = 0;
        compBenPckgs.FreqId = 0;
        compBenPckgs.SGId = 0;

        compBenPckgs.Swipe = false;
        compBenPckgs.AllowTrans = false;
        compBenPckgs.Motorized = false;
        compBenPckgs.Incentive = false;
        compBenPckgs.Annual = false;
        compBenPckgs.AllowSpec = false;
    }
    #endregion

    #region Modal
    private void AddSelected()
    {
        var selectedItems = modalCompBenItems
            .Where(jo => selectedModalItems.Contains(jo.Id))
            .ToList();

        foreach (var item in selectedItems)
        {
            compBenItemsDto.Add(new CompBenItemsDto
            {
                Id = item.Id,
                Amount = item.Amount.GetValueOrDefault(),
                CatId = item.CatId.GetValueOrDefault(),
                ItmDesc = item.ItmDesc,
                ItmName = item.ItmName
            });
        }

        modalExistItem.Close();
    }

    private async Task ShowItemsModal()
    {
        modalCatId = itemCat.FirstOrDefault().Id;
        await OnModalCategoryChanged(new ChangeEventArgs { Value = modalCatId });
        selectedModalItems.Clear();

        modalExistItem.Show();
    }

    private async Task OnModalCategoryChanged(ChangeEventArgs e)
    {
        modalCatId = int.TryParse(e.Value?.ToString(), out var mdlCatId)
            ? mdlCatId
            : 0;

        modalCompBenItems.Clear();

        var excludeIds = compBenItemsDto.Select(jo => jo.Id).ToHashSet();
        modalCompBenItems = compBenItems.Where(jo => jo.CatId == modalCatId 
            && !excludeIds.Contains(jo.Id)).ToList();
    }

    private async Task UpdateItemSelection(int itemId, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedModalItems.Contains(itemId))
            { selectedModalItems.Add(itemId); }
        }
        else
        { selectedModalItems.Remove(itemId); }
    }
    #endregion
}
