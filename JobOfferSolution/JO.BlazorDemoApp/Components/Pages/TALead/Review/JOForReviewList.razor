@attribute [Authorize(Roles = JOUserRole.TALead)]
@attribute [Route(JORoutes.TALead.JOForReview)]

<div class="row">

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">For Review</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @joDboxCandidates.Where(jo => jo.StatusId == 2).Count()
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Job Offers</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var joDboxCandidate in joDboxCandidates.Where(jo=>jo.StatusId==2))
                    {
                        <tr @key="joDboxCandidate.Id">
                            <td><strong>@(joDboxCandidate.RefNum)</strong></td>
                            <td>@joDboxCandidate.DboxRefNum</td>
                            <td>@joDboxCandidate.CandidateName</td>
                            <td>
                                <span class="badge badge-info">
                                    @joDboxCandidate.StatusName
                                </span>
                            </td>
                            <td>
                                <div>@joDboxCandidate.CreatedByName</div>
                                <small class="text-muted">@(joDboxCandidate.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td>
                                <div>@joDboxCandidate.ModifiedByName</div>
                                <small class="text-muted">@(joDboxCandidate.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td class="text-right">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-link text-dark font-weight-bold"
                                            data-toggle="dropdown"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            aria-label="Actions for @joDboxCandidate.RefNum">
                                        •••
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                        @if (joDboxCandidate.StatusId == 2)
                                        {
                                            <a class="dropdown-item"
                                               href="@($"{JORoutes.TALead.JOForReview}/{joDboxCandidate.Id}")">
                                                Review
                                            </a>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>