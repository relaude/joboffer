@attribute [Authorize(Roles = JOUserRole.TALead)]
@attribute [Route(JORoutes.TALead.JOForReview)]

<ReviewerKpiBoxes Total="@total"
                  ForReviewCount="@countForReview"
                  SendBackCount="@countSendBack"
                  ReviewedCount="@countReviewed"
                  OnFilterChanged="FilterByWorkFlow" />

<div class="card shadow mb-4 small">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Job Offers</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="jo-table">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Candidate ID</th>
                        <th>Candidate</th>
                        <th>Status</th>
                        <th>Workflow</th>
                        <th>Created</th>
                        <th>Modified</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var joDboxCandidate in filteredJODboxCandidates)
                    {
                        <tr @key="joDboxCandidate.Id">
                            <td>
                                <a href="@($"{(joDboxCandidate.WorkFlowId == 3 ? JORoutes.TALead.JOForReview : JORoutes.TALead.JobOfferDetails)}/{joDboxCandidate.Id}")">
                                    <strong>@(joDboxCandidate.RefNum)</strong>
                                </a>
                            </td>
                            <td>@joDboxCandidate.DboxRefNum</td>
                            <td>@joDboxCandidate.CandidateName</td>
                            <td>@joDboxCandidate.ActionByName</td>
                            <td>@joDboxCandidate.FlowName</td>
                            <td>
                                <div>@joDboxCandidate.CreatedByName</div>
                                <small class="text-muted">@(joDboxCandidate.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                            <td>
                                <div>@joDboxCandidate.ModifiedByName</div>
                                <small class="text-muted">@(joDboxCandidate.ModifiedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
