@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TALead.Analysis + "/{jobOfferId:int}")]

<Analysis @ref="analysis" jobOfferId="jobOfferId" />

<div class="jo-actions mb-4">
    <button class="btn btn-outline-secondary" @onclick="HandleGoBack">
        <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i>
        Go Back
    </button>

    <button type="button" class="btn btn-primary" @onclick="SaveAnalysis">
        <i class="fas fa-save mr-1" aria-hidden="true"></i>
        Save
    </button>

    <button type="button" class="btn btn-success" @onclick="SubmitForApproval">
        <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i>
        Submit for Approval
    </button>
</div>

