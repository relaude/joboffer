@attribute [Authorize(Roles = JOUserRole.PEHead)]
@attribute [Route(JORoutes.PEH.JOForReview + "/{jobOfferId:int}")]

@inject IApprovalService ApprovalService
@inject IAccountService AccountService
@inject IAlertService AlertService
@inject NavigationManager Navigation

<JobOfferAnalysis @ref="analysis" jobOfferId="jobOfferId" ShowGoBackUrl="false" />

<!--Remarks-->
<div class="card shadow mb-4 small">
    <div class="card-header">
        <h6 class="jo-title">Remarks <span class="text-danger" aria-label="required">*</span></h6>
    </div>
    <div class="card-body">
        <textarea rows="5" class="form-control" @bind="approverRemarks"></textarea>
    </div>
</div>

<div class="jo-actions mb-4">
    <a href="@JORoutes.PEH.JOForReview" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i>
        Go Back
    </a>
    <button type="button" class="btn btn-outline-primary" @onclick="SendBackJobOffer">
        <i class="fas fa-reply mr-1" aria-hidden="true"></i>
        Send Back
    </button>
    <button type="button" class="btn btn-success" @onclick="ApproveJobOffer">
        <i class="fas fa-check-circle mr-1" aria-hidden="true"></i>
        Approve
    </button>
</div>

@code {
    [Parameter] public int jobOfferId { get; set; }
    private string approverRemarks = string.Empty;
    private JobOfferAnalysis? analysis;

    private async Task SendBackJobOffer()
    {
        if (string.IsNullOrWhiteSpace(approverRemarks))
        {
            await AlertService.Error("Remarks is required."); return;
        }

        if (!await AlertService.Confirm(
            title: "Send back this job offer?",
            confirmText: "Send Back"))
        {
            return;
        }

        int userId = await AccountService.GetJobOfferUserId();
        await ApprovalService.JobOfferActionSendBack(jobOfferId, 3, userId, approverRemarks);

        await AlertService.Success(
            message: "The job offer has been send back successfully.",
            title: "Send Back Complete");

        Navigation.NavigateTo(JORoutes.PEH.JOForReview);
    }

    private async Task ApproveJobOffer()
    {
        if (string.IsNullOrWhiteSpace(approverRemarks))
        {
            await AlertService.Error("Remarks is required."); return;
        }

        if (!await AlertService.Confirm(
            title: "Approve this job offer?",
            confirmText: "Approve"))
        {
            return;
        }

        int userId = await AccountService.GetJobOfferUserId();
        //int nextRoleId = await ApprovalService.GetNextApproverRoleId(jobOfferId, 3);
        int workFlowId = 0;

        if (analysis.JobOffer.IsAM == true || analysis.JobOffer.IsHROD == true)
        {
            if (analysis.JobOffer.OfferRangeId == 2 || analysis.JobOffer.OfferRangeId == 3)
            {
                workFlowId = 6; //For HROD Head Approval
            }
        }

        await ApprovalService.JobOfferActionFlowStatus(jobOfferId, workFlowId, 3, 3, userId, approverRemarks);
        await AlertService.Success(
            message: "The job offer has been approved successfully.",
            title: "Approve Complete");

        Navigation.NavigateTo(JORoutes.PEH.JOForReview);
    }
}
