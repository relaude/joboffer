@using JO.BlazorDemoApp.Components.Layout.SideMenu
@inject AuthenticationStateProvider AuthenticationStateProvider

<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@JORoutes.Private.Home">
        <div class="sidebar-brand-text mx-3">Job Offer</div>
    </a>
    <hr class="sidebar-divider my-0">

    @if (user.Identity?.IsAuthenticated == true)
    {
        @if (user.IsInRole(JOUserRole.TAPartner) == true)
        {
            <TAPartner />
        }

        @if (user.IsInRole(JOUserRole.TALead) == true)
        {
            <TALead />
        }

        @if (user.IsInRole(JOUserRole.PEHead) == true)
        {
            <PEHead />
        }

        @if (user.IsInRole(JOUserRole.HRODHeadApprover) == true)
        {
            <HRODHead />
        }

        @if (user.IsInRole(JOUserRole.DivisionHeadApproverL1) == true)
        {
            <DHL1 />
        }

        @if (user.IsInRole(JOUserRole.President) == true)
        {
            <PresMenu />
        }

        @if (user.IsInRole(JOUserRole.BusinessAdmin) == true)
        {
            <BAdmin />
        }

        @if (user.IsInRole(JOUserRole.OnboardingPartner) == true)
        {
            <Onboard />
        }

        @if (user.IsInRole(JOUserRole.Admin) == true)
        {
            <AdminMenu />
        }
    }

</ul>

@code{

    private ClaimsPrincipal user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
    }
}
