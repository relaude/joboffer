@attribute [Authorize(Roles = JOUserRole.TR)]
@attribute [Route(JORoutes.TR.SalaryMatrix + "/new")]

<div class="salary-mockup">
    <main class="sm-page">
        <header class="sm-page-header d-md-flex justify-content-between mb-4">
            <div>
                <h2 class="sm-title mb-1">
                    Create Salary Matrix
                </h2>
                <p class="sm-subtitle">Set ownership, effective dates and compensation ranges.</p>
            </div>
        </header>
    
        <section class="sm-panel p-4 mb-4">
            <h5 class="sm-title mb-1">Matrix details</h5>
            <p class="sm-subtitle mb-4">Company and validity information.</p>
            <div class="form-row">
                <div class="col-lg-4 mb-3">
                    <label>Company <span class="text-danger">*</span></label>
                    <select id="company"
                            class="custom-select"
                            value="@salaryMatrix.CompanyId"
                            @onchange="OnCompanyChanged">
                        <option value="">Select company</option>
                        @foreach (var option in companies)
                        {
                            <option value="@option.Id">@option.Value</option>
                        }
                    </select>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Effective from <span class="text-danger">*</span></label>
                    <input type="date"
                           class="form-control"
                           @bind="salaryMatrix.EffectiveFrom"
                           @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Effective to <span class="text-danger">*</span></label>
                    <input type="date"
                           class="form-control"
                           @bind="salaryMatrix.EffectiveTo"
                           @bind:format="yyyy-MM-dd" />
                </div>
            </div>
        </section>

        <section class="sm-panel overflow-hidden mb-4">
            <div class="d-flex justify-content-between p-4">
                <div>
                    <h5 class="sm-title mb-1">Salary bands</h5>
                    <p class="sm-subtitle mb-0">Minimum ≤ Midpoint ≤ Maximum</p>
                </div>
                <button class="btn btn-outline-primary" 
                    @onclick="AddBand"
                    disabled="@(!salaryGrades.Any())">
                    + Add band
                </button>
            </div>

            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Grade</th>
                            <th>Minimum</th>
                            <th>Midpoint</th>
                            <th>Maximum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var band in salaryBands)
                        {
                            <tr @key="band">
                                <td>
                                    <select class="form-control form-control-sm" @bind="band.CSGId">
                                        @foreach (var option in salaryGrades)
                                        {
                                            <option value="@option.Id">@($"{option.TypeName} - {option.GradeName}")</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm text-right"
                                           min="10000"
                                           step="10000"
                                           @bind="band.Minimum" />
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm text-right"
                                           min="10000"
                                           step="10000"
                                           @bind="band.Midpoint" />
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm text-right"
                                           min="10000"
                                           step="10000"
                                           @bind="band.Maximum" />
                                </td>
                                <td>
                                    <button class="btn btn-outline-danger btn-circle btn-sm" 
                                        title="Remove band" 
                                        aria-label="Remove band"
                                        @onclick="() => RemoveBand(band)">
                                        <i class="fas fa-trash-alt fa-fw"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="sm-sticky-actions text-right">
            <a href="@JORoutes.TR.SalaryMatrix" class="btn btn-outline-secondary mr-2">Cancel</a>
            <button class="btn btn-primary px-4" @onclick="SaveMatrix">Create matrix</button>
        </div>
    </main>
</div>

@inject IDropDownListService DropDownListService
@inject IAccountService AccountService
@inject IAlertService AlertService
@inject ISalaryMatrixService SalaryMatrixService

@inject NavigationManager Navigation

@code {
    private readonly SalaryMatrix salaryMatrix = new()
    {
        CompanyId = 1,
        EffectiveFrom = DateTime.Now,
        EffectiveTo = DateTime.Now.AddYears(1),
        IsActive = true
    };

    private List<DropdownDto> companies = new();
    private List<VwCompanySalaryGrades> salaryGrades = new();
    private List<SalaryBandsDto> salaryBands = new();

    protected override async Task OnInitializedAsync()
    {
        companies = await DropDownListService.GetCompanies();

        salaryMatrix.CompanyId = companies.FirstOrDefault().Id;
        salaryMatrix.CreatedBy = await AccountService.GetJobOfferUserId();

        await OnCompanyChanged(new ChangeEventArgs
        {
            Value = salaryMatrix.CompanyId
        });
    }

    private async Task SaveMatrix()
    {
        var errors = CollectErrors(new List<string>());

        if (errors.Any())
        {
            await AlertService.Errors(errors);
            return;
        }

        if (!await AlertService.Confirm()) return;

        int matrixId = await SalaryMatrixService.CreateMatrix(salaryMatrix, salaryBands);
        Navigation.NavigateTo($"{JORoutes.TR.SalaryMatrix}/{matrixId}");
    }

    private List<string> CollectErrors(List<string> errors)
    {
        if (!salaryMatrix.CompanyId.HasValue || salaryMatrix.CompanyId <= 0)
            errors.Add("Company is required.");

        if (!salaryMatrix.EffectiveFrom.HasValue)
            errors.Add("Effective Date From is required.");

        if (!salaryMatrix.EffectiveTo.HasValue)
            errors.Add("Effective Date To is required.");

        if (salaryMatrix.EffectiveFrom.HasValue
            && salaryMatrix.EffectiveTo.HasValue
            && salaryMatrix.EffectiveFrom > salaryMatrix.EffectiveTo)
        {
            errors.Add("Effective Date From cannot be later than Effective Date To.");
        }

        if (!salaryBands.Any())
            errors.Add("Please add at least one salary band.");

        else
            CollectSalaryBandErrors(errors);

        return errors;
    }

    private void CollectSalaryBandErrors(List<string> errors)
    {
        var csgIds = new HashSet<int>();

        for (var index = 0; index < salaryBands.Count; index++)
        {
            var band = salaryBands[index];
            var rowNumber = index + 1;

            if (!band.CSGId.HasValue || band.CSGId <= 0)
                errors.Add($"Salary Band Row {rowNumber}: Salary Grade is required.");
            else if (!csgIds.Add(band.CSGId.Value))
                errors.Add($"Salary Band Row {rowNumber}: Salary Grade is duplicated.");

            if (!band.Minimum.HasValue || band.Minimum <= 0)
                errors.Add($"Salary Band Row {rowNumber}: Minimum amount is required.");

            if (!band.Midpoint.HasValue || band.Midpoint <= 0)
                errors.Add($"Salary Band Row {rowNumber}: Midpoint amount is required.");

            if (!band.Maximum.HasValue || band.Maximum <= 0)
                errors.Add($"Salary Band Row {rowNumber}: Maximum amount is required.");

            if (band.Minimum.HasValue
                && band.Midpoint.HasValue
                && band.Maximum.HasValue
                && band.Maximum > 0
                && band.Midpoint > 0
                && band.Maximum > 0
                && !(band.Minimum < band.Midpoint && band.Midpoint < band.Maximum))
            {
                errors.Add($"Salary Band Row {rowNumber}: Minimum, Midpoint, and Maximum must be in ascending order.");
            }
        }
    }

    private void AddBand()
    {
        var assignedGradeIds = salaryBands
            .Where(band => band.CSGId.HasValue)
            .Select(band => band.CSGId.Value)
            .ToHashSet();

        var nextSalaryGrade = salaryGrades
            .FirstOrDefault(grade => !assignedGradeIds.Contains(grade.Id));

        if (nextSalaryGrade is null)
            return;

        salaryBands.Add(new SalaryBandsDto
        {
            CSGId = nextSalaryGrade.Id,
            Minimum = 30000,
            Midpoint = 50000,
            Maximum = 70000
        });
    }

    private void RemoveBand(SalaryBandsDto band)
    {
        salaryBands.Remove(band);
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        salaryMatrix.CompanyId = int.TryParse(e.Value?.ToString(), out var companyId)
            ? companyId
            : null;

        salaryGrades.Clear();
        salaryBands.Clear();

        if (salaryMatrix.CompanyId.HasValue)
        {
            salaryGrades = await SalaryMatrixService
                .GetCompanySalaryGrades(salaryMatrix.CompanyId.GetValueOrDefault());
        }
        
    }
}
