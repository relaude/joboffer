@inject IJODetailsService JODetailsService
@inject IUtilitiesService UtilitiesService

@if (approvals.Count == 0)
{
    <div class="card border-left-secondary shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-user-check fa-3x text-gray-300 mb-3"></i>
            <h6 class="font-weight-bold text-gray-800 mb-1">No approval records</h6>
            <p class="text-muted mb-0">Approval decisions will appear here once they are available.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var optionGroup in approvals
            .GroupBy(approval => approval.OptionNum)
            .OrderBy(group => group.Key))
        {
            var proposal = optionGroup.First();

            <div class="col-xl-4 col-lg-6 mb-3">
                <div class="card shadow-sm h-100 @(proposal.Recommend.GetValueOrDefault() ? "border-primary" : "border")">
                    <div class="card-header px-3 py-3 @(proposal.Recommend.GetValueOrDefault() ? "bg-primary text-white" : "bg-light")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center font-weight-bold">
                                    @if (proposal.Recommend.GetValueOrDefault())
                                    {
                                        <i class="fas fa-star mr-1"></i>
                                    }

                                    <span>@($"Option {proposal.OptionNum}")</span>
                                </div>

                                @if (proposal.Recommend.GetValueOrDefault())
                                {
                                    <small class="text-white-50">TA Recommended</small>
                                }
                                else
                                {
                                    <small class="text-muted">Other Offer</small>
                                }
                            </div>

                            <span class="badge @(proposal.Recommend.GetValueOrDefault() ? "badge-light" : "badge-secondary")">
                                @proposal.SalaryBand
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-end mb-3">
                            <div>
                                <div class="text-xs text-muted text-uppercase">Monthly base</div>
                                <div class="h5 font-weight-bold text-gray-900 mb-0">
                                    @UtilitiesService.ToPeso(proposal.ProposeSalary)
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-xs text-muted">Annual + Packages</div>
                                <strong>@UtilitiesService.ToPeso(proposal.Annual)</strong>
                            </div>
                        </div>

                        <div class="row text-center no-gutters border rounded mb-3">
                            <div class="col-6 py-2 border-right">
                                <small class="text-muted d-block">Increase</small>
                                <strong class="text-success">@proposal.Increase%</strong>
                            </div>
                            <div class="col-6 py-2">
                                <small class="text-muted d-block">Compa-ratio</small>
                                <strong>@proposal.CompaRatio</strong>
                            </div>
                        </div>

                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase">
                                    <i class="fas fa-users fa-fw mr-1"></i>
                                    Approval details
                                </div>
                                <span class="badge badge-primary badge-pill">
                                    @($"{optionGroup.Count()} approvers")
                                </span>
                            </div>

                            @foreach (var approval in optionGroup.OrderBy(item => item.Id))
                            {
                                <div class="border rounded bg-light p-2 mb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="pr-2">
                                            <div class="font-weight-bold text-gray-900">
                                                <i class="fas fa-user-check fa-fw text-primary mr-1"></i>
                                                @(string.IsNullOrWhiteSpace(approval.ApproverName) ? "Not yet assigned" : approval.ApproverName)
                                            </div>
                                            <small class="text-muted">@approval.ApproverType</small>
                                        </div>
                                        <span class="@($"badge badge-{(string.IsNullOrWhiteSpace(approval.BootstrapClass) ? "secondary" : approval.BootstrapClass)}")">
                                            <i class="fas fa-clipboard-check mr-1"></i>
                                            @(string.IsNullOrWhiteSpace(approval.StatusName) ? "Pending" : approval.StatusName)
                                        </span>
                                    </div>

                                    <div class="small text-muted mt-2">
                                        <i class="fas fa-calendar-check fa-fw mr-1"></i>
                                        @(approval.ApproveAt.HasValue
                                            ? UtilitiesService.FormatDate(approval.ApproveAt)
                                            : "Awaiting decision")
                                    </div>

                                    <div class="border-top mt-2 pt-2">
                                        <div class="text-xs text-muted text-uppercase mb-1">
                                            <i class="fas fa-comment-alt fa-fw mr-1"></i>
                                            Comments
                                        </div>
                                        <div class="text-gray-800">
                                            @(string.IsNullOrWhiteSpace(approval.Comments)
                                                ? "No comments provided."
                                                : approval.Comments)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int JobOfferId { get; set; }
    private List<VwApprovals> approvals = new();

    protected override async Task OnParametersSetAsync()
    {
        approvals = await JODetailsService.GetVwApprovals(JobOfferId);
    }
}
