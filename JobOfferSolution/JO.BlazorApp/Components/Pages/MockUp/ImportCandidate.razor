    ];

    private MockCandidate selectedCandidate = default!;

    protected override void OnInitialized()
    {
        selectedCandidate = candidates[0];
    }

    private void SelectCandidate(MockCandidate candidate)
    {
        selectedCandidate = candidate;
    }

    private sealed record MockSource(
        string Name,
        string Description,
        string Icon,
        string Color,
        int RecordCount,
        string LastSync);

    private sealed record MockCandidate(
        string CandidateReference,
        string FullName,
        string Email,
        string MobileNumber,
        string Location,
        string Source,
        string SourceBadgeClass,
        string SourceIcon,
        string Position,
        string RequisitionNumber,
        string CurrentEmployer,
        string ExpectedSalary,
        string Availability,
        string DateReceived,
        string TimeReceived,
        string ImportStatus,
        string ImportStatusBadgeClass,
        string ValidationNote,
        string ConsentStatus,
        List<MockDocument> Documents);

    private sealed record MockDocument(
        string FileName,
        string DocumentType,
        string FileSize,
        string UploadedOn,
        string Status,
        string StatusBadgeClass);
}
