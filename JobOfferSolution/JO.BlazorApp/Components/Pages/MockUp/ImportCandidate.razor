@attribute [Route(JORoutes.MockUp.ImportCandidate)]

<PageTitle>Import Candidate</PageTitle>

<div class="card shadow mb-4 border-left-primary small">
    <div class="card-header py-3 bg-white">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between">
            <div>
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-file-import fa-fw mr-2"></i>
                    Import Candidate
                </h6>
                <small class="text-muted">
                    Review and import candidate records received from DBox and Microsoft Forms.
                </small>
            </div>

            <div class="mt-2 mt-lg-0">
                <span class="badge badge-light border mr-1">
                    <i class="fas fa-database fa-fw text-primary mr-1"></i>
                    Mock Data
                </span>
                <span class="badge badge-success">
                    <i class="fas fa-link fa-fw mr-1"></i>
                    Sources Connected
                </span>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="alert alert-light border-left-info py-2 mb-4" role="alert">
            <div class="d-flex align-items-start">
                <i class="fas fa-info-circle fa-fw text-info mr-2 mt-1"></i>
                <div>
                    <span class="font-weight-bold">Mock-up workflow:</span>
                    DBox supplies candidate and application records, while Microsoft Forms supplies candidate-submitted details and supporting documents.
                    Matching uses the candidate email address and requisition number.
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Available Records</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@candidates.Count</div>
                                <small class="text-muted">Across both sources</small>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Imported</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@candidates.Count(candidate => candidate.ImportStatus == "Imported")</div>
                                <small class="text-muted">Candidate records created</small>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Needs Review</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@candidates.Count(candidate => candidate.ImportStatus == "Needs Review")</div>
                                <small class="text-muted">Missing or unmatched data</small>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Documents</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@candidates.Sum(candidate => candidate.Documents.Count)</div>
                                <small class="text-muted">Files received</small>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-paperclip fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var source in sources)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm border-left-@source.Color h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex align-items-center">
                                    <span class="btn btn-@source.Color btn-circle mr-3">
                                        <i class="@source.Icon"></i>
                                    </span>
                                    <div>
                                        <div class="font-weight-bold text-gray-900">@source.Name</div>
                                        <div class="text-muted">@source.Description</div>
                                    </div>
                                </div>
                                <span class="badge badge-success badge-pill">
                                    <i class="fas fa-check-circle mr-1"></i>Connected
                                </span>
                            </div>
                            <hr class="my-3" />
                            <div class="row">
                                <div class="col-4">
                                    <div class="text-xs text-uppercase text-gray-500">Records</div>
                                    <div class="font-weight-bold text-gray-800">@source.RecordCount</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-xs text-uppercase text-gray-500">Last Sync</div>
                                    <div class="font-weight-bold text-gray-800">@source.LastSync</div>
                                </div>
                                <div class="col-4 text-right">
                                    <button type="button" class="btn btn-outline-@source.Color btn-sm" disabled>
                                        <i class="fas fa-sync-alt fa-fw mr-1"></i>Sync
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header py-2 bg-light">
                <h6 class="m-0 font-weight-bold text-gray-800">
                    <i class="fas fa-filter fa-fw text-primary mr-2"></i>
                    Search and Filter
                </h6>
            </div>
            <div class="card-body py-3">
                <div class="row align-items-end">
                    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
                        <label class="font-weight-bold text-gray-700 mb-1">Candidate</label>
                        <div class="input-group input-group-sm">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                            </div>
                            <input type="text" class="form-control" placeholder="Name, email, or reference" />
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="font-weight-bold text-gray-700 mb-1">Source</label>
                        <select class="form-control form-control-sm">
                            <option>All Sources</option>
                            <option>DBox</option>
                            <option>Microsoft Forms</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="font-weight-bold text-gray-700 mb-1">Import Status</label>
                        <select class="form-control form-control-sm">
                            <option>All Statuses</option>
                            <option>Imported</option>
                            <option>Needs Review</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="font-weight-bold text-gray-700 mb-1">Date Received</label>
                        <input type="date" class="form-control form-control-sm" value="2026-07-27" />
                    </div>
                    <div class="col-lg-2">
                        <button type="button" class="btn btn-primary btn-sm btn-block" disabled>
                            <i class="fas fa-search fa-fw mr-1"></i>Apply Filters
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header py-3 bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-users fa-fw mr-2"></i>
                        Imported Candidate Records
                    </h6>
                    <small class="text-muted">Select View to inspect the full details and received documents.</small>
                </div>
                <div class="mt-2 mt-md-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1" disabled>
                        <i class="fas fa-file-export fa-fw mr-1"></i>Export
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" disabled>
                        <i class="fas fa-file-import fa-fw mr-1"></i>Import Selected
                    </button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm text-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center"><input type="checkbox" aria-label="Select all candidates" /></th>
                                <th>Candidate</th>
                                <th>Position / Requisition</th>
                                <th>Contact</th>
                                <th>Received</th>
                                <th class="text-center">Documents</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in candidates)
                            {
                                <tr class="@(candidate == selectedCandidate ? "table-primary" : string.Empty)">
                                    <td class="text-center align-middle">
                                        <input type="checkbox"
                                               checked="@(candidate.ImportStatus == "Needs Review")"
                                               aria-label="Select @candidate.FullName" />
                                    </td>
                                    <td class="align-middle">
                                        <div class="font-weight-bold text-gray-900">@candidate.FullName</div>
                                        <div class="text-muted">@candidate.CandidateReference</div>
                                    </td>
                                    <td class="align-middle">
                                        <div>@candidate.Position</div>
                                        <div class="text-muted">@candidate.RequisitionNumber</div>
                                    </td>
                                    <td class="align-middle">
                                        <div>@candidate.Email</div>
                                        <div class="text-muted">@candidate.MobileNumber</div>
                                    </td>
                                    <td class="align-middle">
                                        <div>@candidate.DateReceived</div>
                                        <div class="text-muted">@candidate.TimeReceived</div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="badge badge-light border">
                                            <i class="fas fa-paperclip fa-fw mr-1"></i>@candidate.Documents.Count
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge @candidate.ImportStatusBadgeClass">@candidate.ImportStatus</span>
                                        <div class="text-muted mt-1">@candidate.ValidationNote</div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                title="View candidate details"
                                                @onclick="() => SelectCandidate(candidate)">
                                            <i class="fas fa-eye fa-fw"></i>
                                            <span class="sr-only">View @candidate.FullName</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <small class="text-muted">Showing 1 to @candidates.Count of @candidates.Count mock candidate records</small>
                <nav class="mt-2 mt-md-0" aria-label="Candidate list pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><span class="page-link">Previous</span></li>
                        <li class="page-item active"><span class="page-link">1</span></li>
                        <li class="page-item disabled"><span class="page-link">Next</span></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="card shadow-sm border-left-info">
            <div class="card-header py-3 bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-address-card fa-fw mr-2"></i>
                        Candidate Details
                    </h6>
                    <small class="text-muted">@selectedCandidate.FullName · @selectedCandidate.CandidateReference</small>
                </div>
                <span class="badge @selectedCandidate.ImportStatusBadgeClass mt-2 mt-md-0 align-self-start align-self-md-center">
                    @selectedCandidate.ImportStatus
                </span>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <div class="border rounded h-100">
                            <div class="px-3 py-2 border-bottom bg-light">
                                <h6 class="m-0 font-weight-bold text-gray-800">Personal and Application Details</h6>
                            </div>
                            <div class="p-3">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Full Name</div>
                                        <div class="text-gray-900">@selectedCandidate.FullName</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Email Address</div>
                                        <div class="text-gray-900">@selectedCandidate.Email</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Mobile Number</div>
                                        <div class="text-gray-900">@selectedCandidate.MobileNumber</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Current Location</div>
                                        <div class="text-gray-900">@selectedCandidate.Location</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Position Applied</div>
                                        <div class="text-gray-900">@selectedCandidate.Position</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Requisition Number</div>
                                        <div class="text-gray-900">@selectedCandidate.RequisitionNumber</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Current Employer</div>
                                        <div class="text-gray-900">@selectedCandidate.CurrentEmployer</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Expected Salary</div>
                                        <div class="font-weight-bold text-success">@selectedCandidate.ExpectedSalary</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Availability</div>
                                        <div class="text-gray-900">@selectedCandidate.Availability</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="text-xs font-weight-bold text-uppercase text-gray-500">Consent to Process Data</div>
                                        <span class="badge badge-success">
                                            <i class="fas fa-check fa-fw mr-1"></i>@selectedCandidate.ConsentStatus
                                        </span>
                                    </div>
                                </div>

                                <div class="alert alert-light border mb-0 py-2">
                                    <span class="font-weight-bold">Import note:</span>
                                    @selectedCandidate.ValidationNote
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="border rounded h-100">
                            <div class="px-3 py-2 border-bottom bg-light d-flex justify-content-between align-items-center">
                                <h6 class="m-0 font-weight-bold text-gray-800">Submitted Documents</h6>
                                <span class="badge badge-light border">@selectedCandidate.Documents.Count file(s)</span>
                            </div>
                            <div class="p-3">
                                @if (selectedCandidate.Documents.Count == 0)
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="fas fa-exclamation-triangle fa-fw mr-1"></i>
                                        No documents were received for this candidate.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var document in selectedCandidate.Documents)
                                    {
                                        <div class="border rounded p-2 mb-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="d-flex align-items-start">
                                                    <i class="fas fa-file-alt fa-2x text-primary mr-2"></i>
                                                    <div>
                                                        <div class="font-weight-bold text-gray-900 text-break">@document.FileName</div>
                                                        <div class="text-muted">@document.DocumentType · @document.FileSize</div>
                                                        <div class="text-muted">Uploaded @document.UploadedOn</div>
                                                    </div>
                                                </div>
                                                <span class="badge @document.StatusBadgeClass">@document.Status</span>
                                            </div>
                                            <div class="text-right mt-2">
                                                <button type="button" class="btn btn-outline-primary btn-sm mr-1" disabled>
                                                    <i class="fas fa-eye fa-fw"></i>
                                                    <span class="sr-only">Preview @document.FileName</span>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                                                    <i class="fas fa-download fa-fw"></i>
                                                    <span class="sr-only">Download @document.FileName</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <small class="text-muted">
                    Source record: @selectedCandidate.Source · Received @selectedCandidate.DateReceived at @selectedCandidate.TimeReceived
                </small>
                <div class="mt-2 mt-md-0">
                    
                </div>
            </div>
        </div>
    </div>
</div>

