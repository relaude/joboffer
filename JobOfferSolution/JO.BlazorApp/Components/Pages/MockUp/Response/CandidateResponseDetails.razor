@page "/mockup/candidate-responses/details"

<div class="jo-content-page jo-response-page">
    <main class="jo-main">
        <header class="jo-section jo-response-header">
            <div>
                <a class="jo-response-back" href="/mockup/candidate-responses">← &nbsp;BACK TO CANDIDATE RESPONSES</a>
                <h1>Alyssa Mae Navarro</h1>
                <p>Candidate Response #1 &nbsp;•&nbsp; Completed 12 August 2026</p>
            </div>
            <div class="jo-actions">
                <a href="/mockup/analysis/jo-analysis-version-2" class="btn btn-primary">Create Offer</a>
            </div>
        </header>

        <section class="jo-section jo-response-summary">
            <div class="jo-response-identity">
                <div class="jo-response-avatar" aria-hidden="true">AN</div>
                <div>
                    <h2>Alyssa Mae Navarro</h2>
                    <p>alyssa.navarro@example.com</p>
                    <span class="jo-pill jo-pill-green">DATA PRIVACY CONSENTED</span>
                </div>
            </div>
            <div class="jo-response-summary-details">
                <dl class="jo-response-meta-grid">
                    <div><dt>POSITION APPLIED FOR</dt><dd>R&amp;D</dd></div>
                    <div><dt>EMPLOYMENT STATUS</dt><dd>Currently unemployed</dd></div>
                    <div><dt>RELEVANT EXPERIENCE</dt><dd>More than 10 years</dd></div>
                    <div><dt>FORM COMPLETED</dt><dd>12 Aug 2026</dd></div>
                </dl>
                <dl class="jo-response-employment-grid">
                    <div><dt>CURRENT EMPLOYER</dt><dd>Metadiagnostics Inc.</dd></div>
                    <div><dt>LAST EMPLOYER INDUSTRY</dt><dd>Pharmaceutical &amp; Healthcare</dd></div>
                    <div><dt>LAST POSITION HELD</dt><dd>Laboratory Manager</dd></div>
                </dl>
            </div>
        </section>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">COMPENSATION</span>
                    <h2>Salary and variable pay</h2>
                    <p>Current and expected compensation reported by the candidate.</p>
                </div>
            </div>

            <div class="jo-response-compensation">
                <div><span>CURRENT MONTHLY BASIC</span><strong>₱83,530</strong></div>
                <div><span>EXPECTED MONTHLY BASIC</span><strong>₱120,000</strong></div>
                <div><span>GUARANTEED PAY</span><strong>13th Month</strong></div>
                <div><span>ANNUAL INCENTIVES</span><strong>₱144,000</strong></div>
                <div><span>OTHER VARIABLE PAY</span><strong>₱167,060</strong></div>
            </div>

            <dl class="jo-response-compensation-meta jo-response-compensation-meta-balanced">
                <div><dt>MONTHLY ALLOWANCES</dt><dd>₱5,640 — transport, meal, hazard</dd></div>
                <div><dt>ANNUAL GUARANTEED BONUS</dt><dd>₱83,530</dd></div>
            </dl>
        </section>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">BENEFITS &amp; LEAVE</span>
                    <h2>Health, leave, and company benefits</h2>
                    <p>Reported employee coverage and non-cash benefits.</p>
                </div>
            </div>

            <div class="jo-response-benefit-grid">
                <article class="jo-response-benefit-card">
                    <h3>HEALTH COVERAGE</h3>
                    <dl>
                        <div><dt>Employee HMO</dt><dd>₱150,000 maximum limit</dd></div>
                        <div><dt>Dependents</dt><dd>No dependent coverage</dd></div>
                        <div><dt>Dental</dt><dd>Employee dental services</dd></div>
                        <div><dt>Medicine</dt><dd>₱5,000 per year</dd></div>
                        <div><dt>Optical</dt><dd>Included in HMO limit</dd></div>
                    </dl>
                </article>
                <article class="jo-response-benefit-card">
                    <h3>LEAVE BENEFITS</h3>
                    <dl>
                        <div><dt>Vacation leave</dt><dd>7 days</dd></div>
                        <div><dt>Sick leave</dt><dd>7 days, convertible</dd></div>
                        <div><dt>Other leave</dt><dd>Not applicable</dd></div>
                        <div><dt>Life insurance</dt><dd>₱500,000 company-paid</dd></div>
                    </dl>
                </article>
                <article class="jo-response-benefit-card">
                    <h3>OTHER BENEFITS</h3>
                    <dl>
                        <div><dt>Profit sharing</dt><dd>None</dd></div>
                        <div><dt>Vehicle benefit</dt><dd>Not provided</dd></div>
                        <div><dt>Mobile phone</dt><dd>Not provided</dd></div>
                        <div><dt>Additional benefits</dt><dd>SSS, PhilHealth, Pag-IBIG</dd></div>
                    </dl>
                </article>
            </div>
        </section>
    </main>
</div>
