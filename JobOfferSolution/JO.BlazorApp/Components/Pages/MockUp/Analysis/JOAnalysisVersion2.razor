                    @* <select class="custom-select"><option>Senior Product Manager</option><option>Product Manager</option></select> *@
                    <input class="form-control" value="@candidate.PositionAppliedFor" />
                </label>
                <label>SALARY GRADE
                    <select class="custom-select"><option>SG 14</option><option>SG 13</option></select>
                </label>
                <label>COMPANY
                    <select class="custom-select"><option>Unilab, Inc.</option><option>UL Skin Sciences, Inc.</option></select>
                </label>
                <label>IMMEDIATE SUPERIOR<input class="form-control" value="Maria Santos" /></label>
