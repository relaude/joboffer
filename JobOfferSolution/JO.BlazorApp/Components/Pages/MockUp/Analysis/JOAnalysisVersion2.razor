        <section class="jo-section jo-analysis-compensation">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">CASH COMPENSATION</span>
                    <h2>Compensation comparison</h2>
                    <p>Monthly and annual values across the current package and proposed options.</p>
                </div>
                <label>
                    Compensation Template
                    <select class="custom-select">
                        @foreach (var item in pckgTemp)
                        {
                            <option value="@item.Id">@item.TempName</option>
                        }
                    </select>
                </label>
            </div>

            <div class="jo-analysis-option-tabs" role="tablist" aria-label="Compensation options">
                @foreach (var option in CompensationOptions)
                {
                    <button type="button" role="tab" aria-selected="@(selectedOption == option.Number)"
                            class="jo-analysis-option-tab @(selectedOption == option.Number ? "active" : null) @(option.IsRecommended ? "is-recommended" : null)"
                            @onclick="() => selectedOption = option.Number">
                        <span>Option @option.Number</span>
                        <small>@option.Summary</small>
                    </button>
                }
            </div>

            <div class="jo-analysis-option-toolbar @(SelectedOption.IsRecommended ? "is-recommended" : null)">
                <div><span class="jo-label">OPTION @SelectedOption.Number</span><strong>@SelectedOption.Title</strong></div>
                <label class="jo-analysis-option-recommended"><input type="checkbox" checked="@SelectedOption.IsRecommended" /> Mark as recommended</label>
            </div>

            <div class="table-responsive jo-table-frame" role="tabpanel">
                <table class="jo-table jo-analysis-option-table @(SelectedOption.IsRecommended ? "is-recommended" : null)">
                    <thead>
                        <tr>
                            <th scope="col" rowspan="2">Component</th>
                            <th scope="colgroup" colspan="3">Current</th>
                            <th scope="colgroup" colspan="3" class="is-option">Option @SelectedOption.Number</th>
                        </tr>
                        <tr>
                            <th scope="col">Monthly</th><th scope="col">Annual</th>
                            <th scope="col">Remarks</th><th scope="col" class="is-option">Monthly</th>
                            <th scope="col" class="is-option">Annual</th>
                            <th scope="col" class="is-option">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in SelectedOption.Rows)
                        {
                            <tr class="@(row.IsDifference ? "is-difference" : null)">
                                <td>@row.Component</td>
                                <td class="jo-text-end">@row.CurrentMonthly</td>
                                <td class="jo-text-end">@row.CurrentAnnual</td>
                                <td class="jo-analysis-remarks">@row.CurrentRemarks</td>
                                <td class="jo-text-end is-option">
                                    @if (row.Component == "% Difference in Pay")
                                    { @row.OptionMonthly }
                                    else
                                    {
                                        <a href="javascript:void(0)" @onclick="() => ShowModal(row.Component, row.OptionMonthly, row.OptionRemarks)">@row.OptionMonthly</a>
                                        @* <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => ShowModal(row.Component,row.OptionMonthly,row.OptionRemarks)">
                                            @row.OptionMonthly
                                        </button> *@
                                    }
                                </td>
                                <td class="jo-text-end is-option">@row.OptionAnnual</td>
                                <td class="jo-analysis-remarks is-option">@row.OptionRemarks</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Gross compensation</td>
                            <td class="jo-text-end">₱40,000</td>
                            <td class="jo-text-end">₱705,000</td>
                            <td></td>
                            <td class="jo-text-end is-option">@SelectedOption.GrossMonthly</td>
                            <td class="jo-text-end is-option">@SelectedOption.GrossAnnual</td>
                            <td class="is-option"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </section>
        

        @* <footer class="jo-analysis-card jo-analysis-footer">
            <small>Last saved today at 2:14 PM &nbsp;•&nbsp; Option 2 is recommended</small>
