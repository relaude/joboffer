                <button type="button" class="btn btn-primary">Submit for approval</button>
            </div>
        </footer> *@
    </main>
</div>

<JOModal @ref="joModal">
    <ChildContent>
        <div class="jo-grid">
            <label class="jo-col-12">
                Amount
                <input class="form-control" value="@joModalAmount">
            </label>

            <label class="jo-col-12">
                Remarks
                <textarea class="form-control" rows="3">@joModalRemarks</textarea>
            </label>
        </div>
    </ChildContent>
    <FooterTemplate>
        <div class="jo-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="joModal.Close">Close</button>
            <button type="button" class="btn btn-primary btn-sm">Save</button>
        </div>
    </FooterTemplate>
</JOModal>

@inject ICandidateService CandidateService
@inject IBenefitsService BenefitsService

@code {
    [Parameter] public int responseId { get; set; }
    [Parameter] public int numProposal { get; set; }

    private CandidateResponses candidate = new();
    private List<VwPckgTemp> pckgTemp = new();

    protected override async Task OnInitializedAsync()
    {
        candidate = await CandidateService.GetCandidateResponse(responseId);
        pckgTemp = await BenefitsService.GetVwPckgTemp();
    }

    #region Modal
    private JOModal joModal = default!;
    private string joModalAmount = "";
    private string joModalRemarks = "";

    private void ShowModal(string title, string amount, string remarks)
    {
        joModal.Title = title;
        joModalAmount = amount;
        joModalRemarks = remarks;

        joModal.Show();
    }
    #endregion
    
    private int selectedOption = 1;
    private CompensationOption SelectedOption => CompensationOptions.First(option => option.Number == selectedOption);

    private readonly CompensationOption[] CompensationOptions =
    [
        CreateOption(1, "Base proposal", "₱873,750 annual", "₱55,000", "₱660,000", "₱55,000", "₱110,000", "₱4,062.50", "₱48,750", "48%", "24%", "₱59,062.50", "₱873,750", false),
        CreateOption(2, "Market-aligned proposal", "₱1,023,750 annual", "₱65,000", "₱780,000", "₱65,000", "₱130,000", "₱4,062.50", "₱48,750", "63%", "45%", "₱69,062.50", "₱1,023,750", true),
        CreateOption(3, "Premium proposal", "₱1,203,750 annual", "₱77,000", "₱924,000", "₱77,000", "₱154,000", "₱4,062.50", "₱48,750", "93%", "71%", "₱81,062.50", "₱1,203,750", false),
        CreateOption(4, "Alternative premium", "₱1,203,750 annual", "₱77,000", "₱924,000", "₱77,000", "₱154,000", "₱4,062.50", "₱48,750", "93%", "71%", "₱81,062.50", "₱1,203,750", false)
    ];

    private static CompensationOption CreateOption(int number, string title, string summary, string monthlyBasic, string annualBasic, string guaranteedPay, string otherBonus, string allowanceMonthly, string allowanceAnnual, string monthlyDifference, string annualDifference, string grossMonthly, string grossAnnual, bool isRecommended) =>
        new(number, title, summary, grossMonthly, grossAnnual, isRecommended,
        [
            new("Monthly Basic Salary (MBS)", "₱40,000", "₱480,000", "", monthlyBasic, annualBasic, ""),
            new("13th Month Pay (1.00 x MBS)", "—", "₱40,000", "", "—", guaranteedPay, ""),
            new("Other Guaranteed Bonus/es", "—", "—", "", "—", otherBonus, ""),
            new("Allowances", "—", "₱25,000", "Non Tax Allowance, Transpo Allowance and Other Allowance", allowanceMonthly, allowanceAnnual, ""),
            new("Profit Share", "—", "₱60,000", "", "—", "—", ""),
            new("Incentives/Commission", "—", "₱80,000", "", "—", "—", ""),
            new("Performance-Based Bonuses", "—", "₱20,000", "", "—", "—", ""),
            new("% Difference in Pay", "—", "—", "", monthlyDifference, annualDifference, "", true)
        ]);

    private readonly CompensationRow[] CompensationRows =
    [
        new("Monthly Basic Salary (MBS)", "₱40,000", "₱55,000", "₱65,000", "₱77,000", "₱77,000"),
        new("Annual basic salary", "₱480,000", "₱660,000", "₱780,000", "₱924,000", "₱924,000"),
        new("13th month pay", "₱40,000", "₱55,000", "₱65,000", "₱77,000", "₱77,000"),
        new("Other guaranteed bonuses", "—", "₱110,000", "₱130,000", "₱154,000", "₱154,000"),
        new("Allowances", "₱25,000", "₱48,750", "₱48,750", "₱48,750", "₱48,750"),
        new("Profit share", "₱60,000", "—", "₱55,000", "₱65,000", "₱77,000"),
        new("Incentives / Commission", "₱80,000", "—", "—", "—", "—"),
        new("Performance-Based Bonuses", "₱20,000", "—", "—", "—", "—"),
        new("Difference in pay", "—", "+23.9%", "+45.2%", "+70.7%", "+70.7%")
    ];

    private sealed record CompensationRow(string Component, string Current, string Option1, string Option2, string Option3, string Option4);
    private sealed record CompensationOption(int Number, string Title, string Summary, string GrossMonthly, string GrossAnnual, bool IsRecommended, CompensationOptionRow[] Rows);
    private sealed record CompensationOptionRow(string Component, string CurrentMonthly, string CurrentAnnual, string CurrentRemarks, string OptionMonthly, string OptionAnnual, string OptionRemarks, bool IsDifference = false);
}
