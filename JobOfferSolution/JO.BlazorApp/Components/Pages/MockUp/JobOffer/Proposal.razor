@page "/mockup/job-offer/proposal"

<div class="job-offer-analysis">
    <main class="joa-page">
        <header class="joa-header">
            <div>
                <div class="joa-eyebrow">JOB OFFER · ANALYSIS</div>
                <h1>Job Offer Analysis</h1>
                <p>Review the candidate package, internal alignment, and benefits before endorsement.</p>
            </div>
            <span class="joa-status"><span aria-hidden="true">●</span> FOR REVIEW</span>
        </header>

        <section class="joa-panel joa-candidate-panel">
            <div class="joa-candidate">
                <div class="joa-label">CANDIDATE</div>
                <h2>First Name Last Name 1</h2>
                <p>Laboratory Manager <span aria-hidden="true">·</span> Metadiagnostics Inc.</p>
                <a href="#compensation-analysis">Applying for&nbsp; R&amp;D</a>
            </div>

            <div class="joa-kpis">
                <article class="joa-kpi joa-kpi-blue">
                    <div class="joa-label">CURRENT MONTHLY</div>
                    <strong>₱83,530</strong>
                    <small>13 months pay</small>
                </article>
                <article class="joa-kpi joa-kpi-green">
                    <div class="joa-label">PROPOSED MONTHLY</div>
                    <strong>₱96,000</strong>
                    <small>15 months pay</small>
                </article>
                <article class="joa-kpi joa-kpi-amber">
                    <div class="joa-label">PACKAGE CHANGE</div>
                    <strong>+14.9%</strong>
                    <small>Within salary band</small>
                </article>
            </div>
        </section>

        <section id="compensation-analysis" class="joa-panel joa-compensation">
            <div class="joa-section-heading">
                <h2>Compensation Analysis</h2>
                <p>Current package compared with the recommended offer</p>
            </div>

            <div class="joa-snapshot">
                <div><span>ANNUAL GUARANTEED</span><strong>₱1.44M</strong></div>
                <div><span>ANNUAL VARIABLE</span><strong>₱144K</strong></div>
                <div><span>TOTAL CASH</span><strong>₱1.58M</strong></div>
                <div><span>MARKET POSITION</span><strong>Mid–Max</strong></div>
            </div>

            <div class="joa-table-label">PACKAGE BREAKDOWN</div>
            <div class="table-responsive">
                <table class="table joa-table mb-0">
                    <thead>
                        <tr>
                            <th>Component</th>
                            <th>Current / Mo.</th>
                            <th>Proposed / Mo.</th>
                            <th>Proposed / Yr.</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Monthly Basic Salary</td><td>₱83,530</td><td class="joa-proposed">₱96,000</td><td>₱1,152,000</td><td>Core pay</td></tr>
                        <tr><td>13th Month Pay</td><td>₱6,961</td><td class="joa-proposed">₱8,000</td><td>₱96,000</td><td>Guaranteed</td></tr>
                        <tr><td>Other Guaranteed Bonuses</td><td>₱13,922</td><td class="joa-proposed">₱16,000</td><td>₱192,000</td><td>14th &amp; 15th</td></tr>
                        <tr><td>Allowances</td><td>₱2,000</td><td class="joa-proposed">₱2,000</td><td>₱24,000</td><td>Rice allowance</td></tr>
                        <tr><td>Variable Pay</td><td>₱12,000</td><td class="joa-proposed">₱12,000</td><td>₱144,000</td><td>Profit share</td></tr>
                    </tbody>
                    <tfoot>
                        <tr><td>TOTAL CASH COMPENSATION</td><td>₱118,413</td><td class="joa-proposed">₱134,000</td><td>₱1,608,000</td><td></td></tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <section class="joa-panel joa-details">
            <div class="joa-section-heading">
                <h2>Benefits &amp; Employment Details</h2>
                <p>Key entitlements and setup from the compensation and benefits form</p>
            </div>

            <div class="joa-detail-grid">
                <article class="joa-subpanel">
                    <h3>CORE BENEFITS</h3>
                    <dl class="joa-benefits">
                        <div><dt><i class="joa-dot joa-dot-blue"></i>Health coverage</dt><dd>₱150,000 annual limit</dd></div>
                        <div><dt><i class="joa-dot joa-dot-blue"></i>Medicine reimbursement</dt><dd>₱5,000 / year</dd></div>
                        <div><dt><i class="joa-dot joa-dot-green"></i>Leave credits</dt><dd>7 vacation · 7 sick</dd></div>
                        <div><dt><i class="joa-dot joa-dot-green"></i>Life insurance</dt><dd>₱500,000 coverage</dd></div>
                    </dl>
                </article>

                <article class="joa-subpanel">
                    <h3>EMPLOYMENT SETUP</h3>
                    <dl class="joa-employment">
                        <div><dt>STATUS</dt><dd>Probationary</dd></div>
                        <div><dt>WORK AREA</dt><dd>Office Provincial</dd></div>
                        <div><dt>SCHEDULE</dt><dd>Compressed</dd></div>
                        <div><dt>SHIFT</dt><dd>NPO · Non-punching</dd></div>
                        <div><dt>JOB CLASS</dt><dd>Supervisory</dd></div>
                        <div><dt>FREQUENCY</dt><dd>15 months</dd></div>
                    </dl>
                </article>
            </div>
        </section>

        <section class="joa-panel joa-decision">
            <div>
                <div class="joa-label">Recommendation</div>
                <h2>Proceed at ₱96,000 monthly basic salary</h2>
                <p>Package is within the target band and improves guaranteed cash without changing core allowances.</p>
            </div>
            <div class="joa-actions">
                <button type="button" class="btn btn-outline-secondary">Save draft</button>
                <button type="button" class="btn btn-primary">Endorse offer</button>
            </div>
        </section>
    </main>
</div>
<link href="css/job-offer.css" rel="stylesheet" />
