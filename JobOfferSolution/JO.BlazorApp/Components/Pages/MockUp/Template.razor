@page "/mockup/template"

<div class="jo-content-page">
    <main class="jo-main">
        <header class="jo-header">
            <div>
                <span class="jo-eyebrow">JOB OFFER DESIGN SYSTEM</span>
                <h1>Content page theme</h1>
                <p>A showcase of the shared layout, data, form, and action classes.</p>
            </div>
            <div class="jo-actions">
                <button type="button" class="btn btn-outline-secondary">Export</button>
                <button type="button" class="btn btn-primary">Create offer</button>
            </div>
        </header>

        <section class="jo-kpi-grid" aria-label="Offer metrics">
            <article class="jo-kpi">
                <span class="jo-kpi-label">TOTAL OFFERS</span>
                <strong class="jo-kpi-value">128</strong>
                <small>12 created this month</small>
            </article>
            <article class="jo-kpi jo-kpi-green">
                <span class="jo-kpi-label">ACCEPTED</span>
                <strong class="jo-kpi-value">84</strong>
                <small>65.6% acceptance rate</small>
            </article>
            <article class="jo-kpi jo-kpi-amber">
                <span class="jo-kpi-label">PENDING</span>
                <strong class="jo-kpi-value">31</strong>
                <small>Awaiting candidate response</small>
            </article>
            <article class="jo-kpi jo-kpi-red">
                <span class="jo-kpi-label">EXPIRING SOON</span>
                <strong class="jo-kpi-value">13</strong>
                <small>Within the next seven days</small>
            </article>
        </section>

        <section class="jo-panel">
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <span class="jo-pill jo-pill-green mr-2">APPROVED</span>
                    <span class="jo-pill jo-pill-blue">ACTIVE</span>
                    <h4 class="jo-title mt-3 mb-1">Corporate Professional</h4>
                    <div class="jo-code">CORP-PRO-2026</div>
                    <div class="mt-3">
                        <span class="jo-pill jo-pill-amber mr-2">PENDING</span>
                        <span class="jo-pill jo-pill-red mr-2">EXPIRED</span>
                        <span class="jo-pill jo-pill-gray">INACTIVE</span>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <div class="jo-meta-label">Company</div>
                            <div class="jo-meta-value">Acme Global</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="jo-meta-label">Currency</div>
                            <div class="jo-meta-value">PHP</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="jo-meta-label">Approved by</div>
                            <div class="jo-meta-value">Maya Chen</div>
                        </div>
                        <div class="col-sm-4 mb-3 mb-sm-0">
                            <div class="jo-meta-label">Division</div>
                            <div class="jo-meta-value">Corporate</div>
                        </div>
                        <div class="col-sm-4 mb-3 mb-sm-0">
                            <div class="jo-meta-label">Effective period</div>
                            <div class="jo-meta-value">01 Jan – 31 Dec 2026</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="jo-meta-label">Approved at</div>
                            <div class="jo-meta-value">30 Dec 2025, 16:42</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">CURRENT PROPOSAL</span>
                    <h2>Compensation snapshot</h2>
                    <p>Key figures for the selected candidate and position.</p>
                </div>
                <button type="button" class="btn btn-outline-primary">View details</button>
            </div>

            <div class="jo-snapshot">
                <div class="jo-snapshot-item">
                    <span class="jo-snapshot-label">BASE SALARY</span>
                    <strong class="jo-snapshot-value">₱85,000</strong>
                </div>
                <div class="jo-snapshot-item">
                    <span class="jo-snapshot-label">ALLOWANCES</span>
                    <strong class="jo-snapshot-value">₱12,500</strong>
                </div>
                <div class="jo-snapshot-item">
                    <span class="jo-snapshot-label">ANNUAL BONUS</span>
                    <strong class="jo-snapshot-value">15%</strong>
                </div>
                <div class="jo-snapshot-item">
                    <span class="jo-snapshot-label">TOTAL PACKAGE</span>
                    <strong class="jo-snapshot-value">₱1.35M</strong>
                </div>
            </div>

            <div class="table-responsive">
                <table class="jo-table">
                    <thead>
                        <tr>
                            <th scope="col">Component</th>
                            <th scope="col">Current</th>
                            <th scope="col">Proposed</th>
                            <th scope="col">Difference</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Monthly base salary</td>
                            <td>₱72,000</td>
                            <td>₱85,000</td>
                            <td>+18.1%</td>
                        </tr>
                        <tr>
                            <td>Monthly allowances</td>
                            <td>₱10,000</td>
                            <td>₱12,500</td>
                            <td>+25.0%</td>
                        </tr>
                        <tr>
                            <td>Annual performance bonus</td>
                            <td>10%</td>
                            <td>15%</td>
                            <td>+5 pts</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Total annual package</td>
                            <td>₱1.08M</td>
                            <td>₱1.35M</td>
                            <td>+25.0%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">FORM CONTROLS</span>
                    <h2>Offer information</h2>
                    <p>Standard text inputs and custom select controls in a responsive grid.</p>
                </div>
            </div>

            <div class="jo-form-grid">
                <label>
                    CANDIDATE NAME
                    <input class="form-control" value="Alex Rivera" />
                </label>
                <label>
                    POSITION
                    <input class="form-control" value="Senior Product Manager" />
                </label>
                <label>
                    EMPLOYMENT TYPE
                    <select class="custom-select">
                        <option>Regular</option>
                        <option>Contractual</option>
                        <option>Probationary</option>
                    </select>
                </label>
                <label>
                    WORK ARRANGEMENT
                    <select class="custom-select">
                        <option>Hybrid</option>
                        <option>On-site</option>
                        <option>Remote</option>
                    </select>
                </label>
            </div>

            <div class="jo-section-heading mt-5">
                <div>
                    <span class="jo-label">TOGGLE CONTROLS</span>
                    <h2>Benefits and eligibility</h2>
                    <p>Responsive toggle controls for selecting offer inclusions.</p>
                </div>
            </div>

            <div class="jo-toggle-grid">
                <label class="jo-toggle"><input type="checkbox" checked /><span class="jo-toggle-control"></span>Company car / motorized</label>
                <label class="jo-toggle"><input type="checkbox" checked /><span class="jo-toggle-control"></span>Incentive program</label>
                <label class="jo-toggle"><input type="checkbox" /><span class="jo-toggle-control"></span>Transportation allowance</label>
                <label class="jo-toggle"><input type="checkbox" /><span class="jo-toggle-control"></span>Annual bonus</label>
                <label class="jo-toggle"><input type="checkbox" /><span class="jo-toggle-control"></span>Special allowance</label>
                <label class="jo-toggle"><input type="checkbox" checked /><span class="jo-toggle-control"></span>Non-swiping eligibility</label>
            </div>
        </section>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">12-COLUMN GRID</span>
                    <h2>Responsive layout</h2>
                    <p>Combine column spans for desktop layouts. Every column stacks on mobile.</p>
                </div>
            </div>

            <div class="jo-grid">
                <label class="jo-col-4">
                    FIRST NAME — 4 COLUMNS
                    <input class="form-control" value="Alex" />
                </label>
                <label class="jo-col-8">
                    LAST NAME — 8 COLUMNS
                    <input class="form-control" value="Rivera" />
                </label>
                <label class="jo-col-3">
                    COUNTRY — 3 COLUMNS
                    <select class="custom-select">
                        <option>Philippines</option>
                    </select>
                </label>
                <label class="jo-col-6">
                    EMAIL ADDRESS — 6 COLUMNS
                    <input class="form-control" value="alex.rivera@example.com" />
                </label>
                <label class="jo-col-3">
                    START DATE — 3 COLUMNS
                    <input type="date" class="form-control" value="2026-08-24" />
                </label>
                <label class="jo-col-12">
                    NOTES — 12 COLUMNS
                    <input class="form-control" value="Full-width content can span all twelve columns." />
                </label>
            </div>
        </section>

        <section class="jo-section">
            <div class="jo-actions jo-actions-between">
                <p class="mb-0">Last saved on 7 August 2026 at 10:30 AM</p>
                <div class="jo-actions">
                    <button type="button" class="btn btn-outline-secondary">Cancel</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </section>
    </main>
</div>
