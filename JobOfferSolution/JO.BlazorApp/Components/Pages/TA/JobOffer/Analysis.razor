@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.Analysis + "/{jobOfferId:int}")]

<ul class="nav nav-tabs flex-column flex-md-row mb-4" role="tablist">
    @foreach (var tab in tabs)
    {
        <li class="nav-item px-1" role="presentation">
            <button type="button"
                    class="nav-link @(activeTab == tab.Key ? "active" : string.Empty)"
                    role="tab"
                    aria-selected="@(activeTab == tab.Key)"
                    @onclick="() => activeTab = tab.Key">
                <i class="@tab.Icon fa-fw mr-1"></i>
                @tab.Label
            </button>
        </li>
    }
</ul>

<div>
    @if (activeTab == "candidate")
    {
        <div class="card shadow mb-4 small">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 m-0 font-weight-bold text-primary">Details</h2>
            </div>

            <CandidateSummary Candidate="candidate" />
        </div>

        <CandidateCompensation Candidate="candidate" />

        <CandidateBenefits Candidate="candidate" />
    }
    else if (activeTab == "analysis")
    {
        <div class="row">
            <div class="col-sm-8">
                <CandidateBasicDetails Candidate="candidate" />
            </div>

            <div class="col-sm-4 small">
                <div class="card shadow mb-4">
                    <div class="card-header">
                        <h2 class="h6 m-0 font-weight-bold text-primary mb-2">Compensation Template</h2>
                        <select class="custom-select custom-select-sm"
                                @bind="templateId"
                                @bind:after="OnSelectTemplate">
                            <option value="0">- Please select -</option>
                            @foreach (var item in pckgTemp)
                            {
                                <option value="@item.Id">@item.TempName</option>
                            }
                        </select>
                    </div>

                    <div class="card-body">
                        @foreach (var item in tempItems.Where(jo => jo.IsEnabled == true))
                        {
                            <div class="custom-control">
                                <label class="font-weight-bold text-gray-800">@item.ItemName</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4 small">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 m-0 font-weight-bold text-primary">@jobOffer.RefNum</h2>
            </div>

            <div class="card-body">
                <div class="jo-analysis-option-tabs" role="tablist">
                    @foreach (var option in optionDto)
                    {
                        <div role="tab"
                             tabindex="0"
                             aria-selected="@(selectedOption == option.OptionNum)"
                             class="jo-analysis-option-tab @(selectedOption == option.OptionNum ? "active" : null)"
                             @onclick="() => ClickOptionTab(option)">
                            <button type="button"
                                    class="jo-analysis-option-remove"
                                    aria-label="Remove option @option.OptionNum"
                                    title="Remove option"
                                    @onclick="() => RemoveProposalDto(option)"
                                    @onclick:stopPropagation="true">
                                <span aria-hidden="true">&times;</span>
                            </button>

                            <span class="jo-analysis-option-title">Option @option.OptionNum</span>

                            <label class="mb-1" for="increase-@option.OptionNum">
                                % Increase
                            </label>

                            <!--CHECK-->
                            <input id="increase-@option.OptionNum"
                               type="text"
                               inputmode="decimal"
                               pattern="[0-9]*([.][0-9]*)?"
                               class="form-control form-control-sm w-100"
                               @bind="option.IncreaseStr"
                               @bind:event="oninput"
                               @bind:after="() => DebounceIncreasePercentage(option)"
                               @onclick:stopPropagation="true"
                               onkeydown="if (!/^[0-9.]$/.test(event.key) ||
                                  (event.key === '.' && event.target.value.includes('.'))) {
                                   if (!['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab'].includes(event.key) &&
                                       !(event.ctrlKey || event.metaKey)) event.preventDefault();
                               }"
                               onpaste="const text = event.clipboardData.getData('text'); if (!/^\d*\.?\d*$/.test(text) || (event.target.value.includes('.') && text.includes('.'))) event.preventDefault();"
                               ondrop="event.preventDefault();" />
                            <!--CHECK-->
                        </div>
                    }

                    <button type="button" class="jo-analysis-option-add"
                            @onclick="AddProposalDto">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>Add Option</span>
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="jo-table jo-analysis-option-table">
                        <thead>
                            <tr>
                                <th scope="col" rowspan="2">Compensation</th>
                                <th scope="colgroup" colspan="2" class="text-center">Current</th>
                                <th scope="colgroup" colspan="2" class="is-option text-center">Option @selectedOption</th>
                            </tr>
                            <tr>
                                <th scope="col">Monthly</th>
                                <th scope="col">Annual</th>
                                <th scope="col" class="is-option">Monthly</th>
                                <th scope="col" class="is-option">Annual</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in comparisonDto)
                            {
                                <tr>
                                    <td>@item.Compensation</td>
                                    <td>@UtilitiesService.ToPeso(item.CurMonthy)</td>
                                    <td>@UtilitiesService.ToPeso(item.CurAnnual)</td>
                                    <td>@UtilitiesService.ToPeso(item.OptMonthy)</td>
                                    <td>
                                        @if (item.Id == 6)
                                        {
                                            <input type="text"
                                                   inputmode="numeric"
                                                   pattern="[0-9]*"
                                                   class="form-control form-control-sm w-100"
                                                   @bind="item.OptAnnual"
                                                   @bind:event="oninput"
                                                   @bind:after="() => DebounceInputIncentive(item)"
                                                   @onclick:stopPropagation="true"
                                                   onkeydown="if (!/^[0-9]$/.test(event.key) &&
                                                    !['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab'].includes(event.key) &&
                                                    !(event.ctrlKey || event.metaKey)) event.preventDefault();"
                                                   onpaste="if (!/^[0-9]+$/.test(event.clipboardData.getData('text'))) event.preventDefault();"
                                                   ondrop="event.preventDefault();" />
                                        }
                                        else
                                        {
                                            @UtilitiesService.ToPeso(item.OptAnnual)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Gross compensation</td>
                                <td>@UtilitiesService.ToPeso(comparisonDto.Sum(jo => jo.CurMonthy))</td>
                                <td>@UtilitiesService.ToPeso(comparisonDto.Sum(jo => jo.CurAnnual))</td>
                                <td>
                                    @UtilitiesService.ToPeso(optionDto
                                        .Where(jo => jo.OptionNum == selectedOption)
                                        .Sum(jo => jo.MbsMonthly
                                            + jo.AllowanceMonthly))
                                </td>
                                <td>
                                    @UtilitiesService.ToPeso(optionDto
                                        .Where(jo => jo.OptionNum == selectedOption)
                                        .Sum(jo => jo.MbsAnnualy
                                            + jo.Month13Annualy
                                            + jo.Month14Annualy
                                            + jo.AllowanceAnnualy
                                            + jo.PSAnnualy
                                            + jo.IncentiveAnnualy
                                            + jo.PerformanceAnnualy))
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4 small">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 m-0 font-weight-bold text-primary">% Difference in Pay</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="jo-table">
                        <thead>
                            <tr>
                                @foreach (var option in optionDto)
                                {
                                    <th scope="colgroup"
                                        colspan="2"
                                        class="text-center">
                                        Option @option.OptionNum
                                    </th>
                                }
                            </tr>

                            <tr>
                                @foreach (var option in optionDto)
                                {
                                    <th scope="col" class="text-center">Monthly</th>
                                    <th scope="col" class="text-center">Annual</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                @foreach (var option in optionDto)
                                {
                                    <td class="text-center">@ComputeMonthDiffPay(option)</td>
                                    <td class="text-center">@ComputeAnnualDiffPay(option)</td>
                                }
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <div class="card shadow mb-4 small">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 m-0 font-weight-bold text-primary">Analysis Notes</h2>
            </div>

            <div class="card-body">
                <textarea class="form-control form-control-sm"
                          rows="3"
                          @bind="analysisNotes"
                          @bind:event="oninput"></textarea>
            </div>
        </div>

        <div class="jo-actions mb-4">
            <button type="button" class="btn btn-outline-secondary">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveOptions">Save</button>
            <button type="button" class="btn btn-primary">Submit for approval</button>
        </div>
    }
</div>

@inject IAccountService AccountService
@inject IJODetailsService JODetailsService
@inject ICandidateService CandidateService
@inject IBenefitsService BenefitsService
@inject IUtilitiesService UtilitiesService
@inject IAlertService AlertService
@inject IDraftAnalysisService DraftAnalysisService

@code {
    [Parameter] public int jobOfferId { get; set; }

    List<JOTabs> tabs = new();
    private string activeTab = "analysis";

    private int userId = 1;

    private VwDboxCandidates candidate = new();

    private JobOffers jobOffer = new();

    private List<VwPckgTemp> pckgTemp = new();
    private List<VwPckgTempHasItms> tempItems = new();
    private List<PckgItemsDto> pckgItemsDto = new();
    private List<ComparisonDto> comparisonDto = new();
    private List<OptionDto> optionDto = new();
    private int templateId = 0;
    private int selectedOption = 1;
    private string analysisNotes = "";
    private CancellationTokenSource? increaseDebounceCts;

    protected override async Task OnInitializedAsync()
    {
        userId = await AccountService.GetJobOfferUserId();
        jobOffer = await JODetailsService.GetJobOffer(jobOfferId);
        candidate = await CandidateService.GetVwDboxCandidate(jobOffer.CandidateId.GetValueOrDefault());

        pckgTemp = await BenefitsService.GetVwPckgTemp();
        pckgItemsDto = await BenefitsService.GetPckgItemsDto();

        tabs.AddRange(
            new JOTabs { Key = "candidate", Label = "Candidate", Icon = "fas fa-user", Show = true },
            new JOTabs { Key = "analysis", Label = "Analysis", Icon = "fa-solid fa-chart-line", Show = true }
        );

        DraftAnalysisService.InitProposalDto(optionDto, jobOffer.Options.GetValueOrDefault(), candidate);
        DraftAnalysisService.FillComparisonDto(comparisonDto, candidate, optionDto);
    }

    private async Task SaveOptions()
    {
        List<string> errors = new();
        errors = CollectErrors(errors);

        if (errors.Any())
        {
            await AlertService.Errors(errors); return;
        }

        if (!await AlertService.Confirm()) return;
    }

    private List<string> CollectErrors(List<string> errors)
    {
        if (!optionDto.Any())
        {
            errors.Add("At least one option is required.");
            return errors;
        }

        if (templateId == 0)
        {
            errors.Add("Compensation Template is required.");
        }

        foreach (var option in optionDto)
        {
            var missingFields = new List<string>();

            if (option.Id <= 0)
                missingFields.Add("Id");

            if (option.OptionNum <= 0)
                missingFields.Add("Option Number");

            if (option.Increase <= 0)
                missingFields.Add("Increase");

            if (option.MbsMonthly <= 0)
                missingFields.Add("MBS Monthly");

            if (option.MbsAnnualy <= 0)
                missingFields.Add("MBS Annual");

            if (option.Month13Annualy <= 0)
                missingFields.Add("13th Month Annual");

            if (option.Month14Annualy <= 0)
                missingFields.Add("14th Month Annual");

            if (option.AllowanceMonthly <= 0)
                missingFields.Add("Allowance Monthly");

            if (option.AllowanceAnnualy <= 0)
                missingFields.Add("Allowance Annual");

            if (option.PSAnnualy <= 0)
                missingFields.Add("Profit Share Annual");

            if (option.IncentiveAnnualy <= 0)
                missingFields.Add("Incentive Annual");

            if (option.PerformanceAnnualy <= 0)
                missingFields.Add("Performance Annual");

            if (missingFields.Any())
            {
                errors.Add($"Option {option.OptionNum}: {string.Join(", ", missingFields)} is required.");
            }
        }

        return errors;
    }

    private string ComputeAnnualDiffPay(OptionDto dto)
    {
        return DraftAnalysisService.ComputeAnnualDiffPay(optionDto, comparisonDto, dto.OptionNum);
    }

    private string ComputeMonthDiffPay(OptionDto dto)
    {
        return DraftAnalysisService.ComputeMonthDiffPay(optionDto, comparisonDto, dto.OptionNum);
    }

    private async Task DebounceInputIncentive(ComparisonDto dto)
    {
        increaseDebounceCts?.Cancel();
        increaseDebounceCts?.Dispose();
        increaseDebounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, increaseDebounceCts.Token);
            InputIncentive(dto);
        }
        catch (OperationCanceledException)
        {
            // A newer value replaced the pending computation.
        }
    }

    private void InputIncentive(ComparisonDto dto)
    {
        var option = optionDto.FirstOrDefault(jo => jo.OptionNum == selectedOption);
        option.IncentiveAnnualy = dto.OptAnnual.GetValueOrDefault();
    }

    private async Task DebounceIncreasePercentage(OptionDto option)
    {
        increaseDebounceCts?.Cancel();
        increaseDebounceCts?.Dispose();
        increaseDebounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, increaseDebounceCts.Token);
            DraftAnalysisService.IncreasePercentage(option, candidate, comparisonDto);
        }
        catch (OperationCanceledException)
        {
            // A newer value replaced the pending computation.
        }
    }

    private void ClickOptionTab(OptionDto option)
    {
        selectedOption = option.OptionNum;

        comparisonDto[0].OptMonthy = option.MbsMonthly;
        comparisonDto[0].OptAnnual = option.MbsAnnualy;
        comparisonDto[1].OptAnnual = option.Month13Annualy;
        comparisonDto[2].OptAnnual = option.Month14Annualy;
        comparisonDto[3].OptMonthy = option.AllowanceMonthly;
        comparisonDto[3].OptAnnual = option.AllowanceAnnualy;
        comparisonDto[4].OptAnnual = option.PSAnnualy;
        comparisonDto[5].OptAnnual = option.IncentiveAnnualy;
        comparisonDto[6].OptAnnual = option.PerformanceAnnualy;
    }

    private void AddProposalDto()
    {
        DraftAnalysisService.AddProposalDto(optionDto, tempItems, candidate);
    }

    private async Task RemoveProposalDto(OptionDto remove)
    {
        if (!await AlertService.Confirm()) return;

        DraftAnalysisService.RemoveProposalDto(optionDto, remove);
    }

    private async Task OnSelectTemplate()
    {
        tempItems = await DraftAnalysisService.GetVwPckgTempHasItms(templateId);
        DraftAnalysisService.OnSelectTemplate(tempItems, comparisonDto, optionDto);
    }
}
