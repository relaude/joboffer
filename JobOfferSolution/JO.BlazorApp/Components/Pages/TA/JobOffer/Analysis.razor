@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.Analysis + "/{jobOfferId:int}")]

@inject IJOAnalysisService JOAnalysisService
@inject ISalaryMatrixService SalaryMatrixService
@inject IAccountService AccountService
@inject IUtilitiesService UtilitiesService
@inject IAlertService AlertService
@inject IDropDownListService DropDownListService
@inject IJODetailsService JODetailsService

@inject NavigationManager Navigation

<div class="card shadow mb-4 border-left-primary small">
    <div class="card-header py-3 bg-white">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between">
            <div>
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-chart-line fa-fw mr-2"></i>Job Offer Analysis
                </h6>
                <small class="text-muted">@jobOffer.RefNum</small>
            </div>
        </div>
    </div>

    <div class="card-body">
        <!--Workflow-->
        <div class="row text-center mb-4">
            @foreach (var step in workFlow.Where(jo => jo.ActionId != JOStatus.Action.Open))
            {
                <div class="col-xl col-md-4 col-6 mb-2">
                    <div class="border rounded bg-light px-2 py-2 h-100">
                        <div class="text-@step.ActionClass mb-1"><i class="@step.Icon"></i></div>
                        <div class="text-xs font-weight-bold text-gray-800">@step.ShortName</div>
                        <span class="badge badge-@step.ActionClass mt-1">@step.ActionName</span>
                    </div>
                </div>
            }
        </div>

        <!--Tabs-->
        <ul class="nav nav-tabs flex-column flex-md-row mb-4" role="tablist">
            @foreach (var tab in tabs)
            {
                if (tab.Show)
                {
                    <li class="nav-item px-1" role="presentation">
                        <button type="button"
                                class="nav-link @(activeTab == tab.Key ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(activeTab == tab.Key)"
                                @onclick="() => activeTab = tab.Key">
                            <i class="@tab.Icon fa-fw mr-1"></i>
                            @tab.Label
                        </button>
                    </li>
                }
            }
        </ul>

        <!--Content-->
        <div>
            @if (activeTab == "candidate")
            {
                <div role="tabpanel">
                    <!-- Candidate Info -->
                    <div class="row">
                        <div class="col-lg-4 mb-3">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body text-center">
                                    <div class="text-primary mb-2"><i class="fas fa-user-circle fa-4x"></i></div>
                                    <h6 class="font-weight-bold text-gray-900 mb-1">@($"{candidate.FName} {candidate.LName}")</h6>
                                    <div class="text-muted">@candidate.LstPosition</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8 mb-3">
                            <div class="row">
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Email Address</small><span class="font-weight-bold text-gray-800">@candidate.Email</span></div>
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Mobile Number</small><span class="font-weight-bold text-gray-800">@candidate.Contact</span></div>
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Applying For</small><span class="font-weight-bold text-gray-800">@candidate.ApplyFor</span></div>
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Employer</small><span class="font-weight-bold text-gray-800">@candidate.Employer</span></div>
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Current Salary</small><span class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(candidate.Salary)</span></div>
                                <div class="col-md-6 mb-3"><small class="text-muted d-block">Expected Salary</small><span class="font-weight-bold text-gray-800">@UtilitiesService.ToPeso(candidate.Expected)</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "email")
            {
                <div role="tabpanel">
                    <div class="row">
                        <!-- Email -->
                        <div class="col-lg-6 mb-3">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <div class="border-bottom pb-3 mb-3">
                                        <div><span class="text-muted">To:</span> @candidate.Email</div>
                                        <div><span class="text-muted">Subject:</span> @request.Subject</div>
                                    </div>

                                    <div class="text-muted mb-2">Message:</div>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            @((MarkupString)request.Message)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-3">
                            <div class="row">
                                <!-- First Row: Email Schedule -->
                                <div class="col-12 mb-3">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="font-weight-bold text-gray-800 border-bottom pb-3 mb-3">
                                                <i class="fas fa-calendar-alt text-primary fa-fw mr-2"></i>
                                                Email Schedule
                                            </h6>

                                            <div class="row">
                                                <div class="col-md-6 border-bottom pb-3 mb-3">
                                                    <i class="fas fa-paper-plane text-success fa-fw mr-2"></i>
                                                    <span class="text-muted">Sent on</span>
                                                    <div class="font-weight-bold text-gray-800 ml-4">
                                                        @UtilitiesService.FormatDate(request.SentAt, CommonConstant.DefaultDateFormat)
                                                    </div>
                                                </div>

                                                <div class="col-md-6 border-bottom pb-3 mb-3">
                                                    <i class="fas fa-calendar-check text-danger fa-fw mr-2"></i>
                                                    <span class="text-muted">Response due</span>
                                                    <div class="font-weight-bold text-gray-800 ml-4">
                                                        @UtilitiesService.FormatDate(request.DueAt, CommonConstant.DefaultDateFormat)
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <i class="fas fa-bell text-warning fa-fw mr-2"></i>
                                                    <span class="text-muted">First reminder</span>
                                                    <div class="font-weight-bold text-gray-800 ml-4">
                                                        @UtilitiesService.FormatDate(request.Reminder1, CommonConstant.DefaultDateFormat)
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <i class="fas fa-bell text-warning fa-fw mr-2"></i>
                                                    <span class="text-muted">Final reminder</span>
                                                    <div class="font-weight-bold text-gray-800 ml-4">
                                                        @UtilitiesService.FormatDate(request.Reminder2, CommonConstant.DefaultDateFormat)
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
            else if (activeTab == "docs")
            {
                <div role="tabpanel">
                    <div class="card h-100">
                        <div class="card-header py-2 bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            <h6 class="m-0 font-weight-bold text-primary text-uppercase text-xs">
                                Submitted Documents
                            </h6>
                            <span class="small text-gray-500 mt-1 mt-md-0">
                                Mock data based on submitted document records
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="thead-light">
                                        <tr>
                                            <th class="border-0 pl-3">File Name</th>
                                            <th class="border-0">File Type</th>
                                            <th class="border-0 pr-3">Uploaded Date</th>
                                            <th class="border-0 pr-3">Verified</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="pl-3">
                                                <div class="font-weight-bold text-gray-800">compensation-and-benefits-form.pdf</div>
                                            </td>
                                            <td>
                                                <span class="badge badge-primary">Submitted Compensation and Benefits Form</span>
                                            </td>
                                            <td class="pr-3">Jun 24, 2026 09:15 AM</td>
                                            <td class="pr-3">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" checked />
                                                    <label class="custom-control-label" for="verified-comp-ben">Verified</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="pl-3">
                                                <div class="font-weight-bold text-gray-800">updated-resume.pdf</div>
                                            </td>
                                            <td>
                                                <span class="badge badge-info">Resume</span>
                                            </td>
                                            <td class="pr-3">Jun 25, 2026 02:40 PM</td>
                                            <td class="pr-3">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" checked />
                                                    <label class="custom-control-label" for="verified-resume">Verified</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="pl-3">
                                                <div class="font-weight-bold text-gray-800">latest-payslip.pdf</div>
                                            </td>
                                            <td>
                                                <span class="badge badge-success">Payslip</span>
                                            </td>
                                            <td class="pr-3">Jun 26, 2026 11:05 AM</td>
                                            <td class="pr-3">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" checked />
                                                    <label class="custom-control-label" for="verified-payslip">Verified</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="pl-3">
                                                <div class="font-weight-bold text-gray-800">candidate-profile.pdf</div>
                                            </td>
                                            <td><span class="badge badge-success">Profile</span></td>
                                            <td class="pr-3">Jun 26, 2026 01:20 PM</td>
                                            <td class="pr-3">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" checked />
                                                    <label class="custom-control-label" for="verified-candidate-profile">Verified</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="pl-3">
                                                <div class="font-weight-bold text-gray-800">requisition-profile.pdf</div>
                                            </td>
                                            <td>
                                                <span class="badge badge-secondary">Requisition Profile</span>
                                            </td>
                                            <td class="pr-3">Jun 26, 2026 03:45 PM</td>
                                            <td class="pr-3">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" checked />
                                                    <label class="custom-control-label" for="verified-requisition-profile">Verified</label>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "legal")
            {
                <div role="tabpanel">
                    <div class="row">
                        <div class="col-lg-6 mb-3">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h6 class="m-0 font-weight-bold text-gray-800">
                                        <i class="fas fa-sitemap fa-fw text-primary mr-2"></i>
                                        Division Assignment
                                    </h6>
                                    <small class="text-muted">Company and Division</small>
                                </div>
                                <div class="card-body">
                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold text-gray-800">Company</label>
                                        <input class="form-control form-control-sm" value="@vwLegal.CompanyCodeName" readonly />
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold text-gray-800">Division</label>
                                        <input class="form-control form-control-sm" value="@vwLegal.DivisionCodeName" readonly />
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold text-gray-800">Salary Matrix</label>
                                        <input class="form-control form-control-sm" value="@vwLegal.MatrixCodeName" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-3">
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h6 class="m-0 font-weight-bold text-gray-800">
                                        <i class="fas fa-table fa-fw text-primary mr-2"></i>
                                        Salary Matrix
                                    </h6>
                                    <small class="text-muted">Salary ranges based on SalaryMatrix and SalaryMatrixBand references.</small>
                                </div>

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm text-nowrap mb-0">
                                            <thead class="thead-light text-center">
                                                <tr>
                                                    <th>Job Level</th>
                                                    <th>Job Family</th>
                                                    <th>Position Grade</th>
                                                    <th>Minimum</th>
                                                    <th>Midpoint</th>
                                                    <th>Maximum</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var band in salaryBands)
                                                {
                                                    <tr>
                                                        <td>@band.JobLevelName</td>
                                                        <td>@band.JobFamilyName</td>
                                                        <td>@band.PositionGrade</td>
                                                        <td class="text-right">@band.BandMinimum</td>
                                                        <td class="text-right font-weight-bold text-gray-900">@band.BandMidpoint</td>
                                                        <td class="text-right">@band.BandMaximum</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4">
                                <div class="card-body">
                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold text-gray-800">Position Applied For</label>
                                        <input class="form-control form-control-sm" value="@vwLegal.PositionName" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "offers")
            {
                <div role="tabpanel">
                    <!-- Proposals -->
                    <div class="row">
                        @foreach (var option in joProposals)
                        {
                            <div class="col-xl-4 mb-3">
                                <div class="card shadow-sm h-100 @(IsRecommended(option.OptionNum) ? "border-primary" : "border")">
                                    <div class="card-header px-3 py-3 @(IsRecommended(option.OptionNum) ? "bg-primary text-white" : "bg-light")">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="d-flex align-items-center font-weight-bold">
                                                    <input class="mr-2"
                                                           type="checkbox"
                                                           name="recommend"
                                                           value="@option.OptionNum"
                                                           checked="@(selectedOptionNumber == option.OptionNum)"
                                                           @onchange="@(() => OnRecommendChange(option.OptionNum))" />

                                                    @if (IsRecommended(option.OptionNum))
                                                    {
                                                        <i class="fas fa-star mr-1"></i>
                                                    }

                                                    <span>@($"Option {option.OptionNum}")</span>
                                                </div>

                                                @if (IsRecommended(option.OptionNum))
                                                {
                                                    <small class="text-white-50">TA Recommended</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Other Offer</small>
                                                }
                                            </div>

                                            <span class="badge @(IsRecommended(option.OptionNum) ? "badge-light" : "badge-success")">
                                                @BandStatusName(option.StatusId)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="card-body p-3">

                                        <div class="d-flex justify-content-between align-items-end mb-3">
                                            <div>
                                                <div class="text-xs text-muted text-uppercase">Monthly base</div>
                                                <div class="h5 font-weight-bold text-gray-900 mb-0">
                                                    <input class="form-control form-control-sm form-ctrl-sml" type="number" step="1000" @bind="option.ProposeSalary" />
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <div class="text-xs text-muted">Annual + Packages</div>
                                                <strong>@UtilitiesService.ToPeso(option.Annual)</strong>
                                            </div>
                                        </div>

                                        <div class="row text-center no-gutters border rounded mb-3">
                                            <div class="col-6 py-2 border-right"><small class="text-muted d-block">Increase</small><strong class="text-success">@option.Increase%</strong></div>
                                            <div class="col-6 py-2 border-right"><small class="text-muted d-block">Compa-ratio</small><strong>@option.CompaRatio</strong></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-xl-6 mb-3">
                            <!-- Job Level -->
                            <div class="card border shadow-sm w-100 mb-3">
                                <div class="card-header bg-white py-2">
                                    <h6 class="m-0 font-weight-bold text-primary text-uppercase text-xs">
                                        <i class="fas fa-check-double fa-fw text-primary mr-2"></i>
                                        Job Level
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    <div class="list-group list-group-flush">
                                        @foreach (var band in salaryBands)
                                        {
                                            <label class="list-group-item d-flex align-items-center px-0 py-2 mb-0">
                                                <input class="mr-3" type="radio" name="salaryBand"
                                                       value="@band.Id"
                                                       checked="@(selectedBandId == band.Id)"
                                                       @onchange="@(() => OnSalaryBandChange(band.Id))" />
                                                <span class="font-weight-bold text-gray-900">
                                                    @band.JobLevelName
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 mb-3">
                            <!-- Compensation & Benefits -->
                            <div class="card border shadow-sm w-100">
                                <div class="card-header bg-white py-2">
                                    <h6 class="m-0 font-weight-bold text-primary text-uppercase text-xs">
                                        <i class="fas fa-gift fa-fw text-primary mr-2"></i>
                                        Compensation & Benefits
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    <div class="form-group row align-items-center mb-3">
                                        <div class="col-sm-10 col-md-6 col-lg-4">
                                            <select class="form-control form-control-sm"
                                                    @bind="selectedPackageId"
                                                    @bind:after="OnPackageChange">
                                                @foreach (var package in ddPackages)
                                                {
                                                    <option value="@package.Id">@package.Value</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm mb-0">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>Item</th>
                                                    <th>Value</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in compensationItems)
                                                {
                                                    <tr>
                                                        <td>@item.ItemName</td>
                                                        <td class="font-weight-bold text-gray-900">@SetCompBenItemValue(item)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card-footer text-right">
        <a href="@JORoutes.TA.JobOfferTracker"
           class="btn btn-outline-secondary btn-sm mr-2">
            <i class="fas fa-arrow-left fa-fw mr-1"></i>Back to Tracker
        </a>

        <button type="button"
                class="btn btn-outline-info btn-sm mr-2"
                @onclick="ReComputeProposalAnalysis">
            <i class="fas fa-calculator fa-fw mr-1"></i>
            Recompute Analysis
        </button>

        <button type="button"
                class="btn btn-primary btn-sm"
                @onclick="SaveAllProposals">
            <i class="fas fa-paper-plane fa-fw mr-1"></i>
            Submit For Approval
        </button>
    </div>
</div>

@code {
    [Parameter] public int jobOfferId { get; set; }

    private VwSalaryMatrixBand selectedBand = new();
    private LegalEntities legal = new();
    private JobOffers jobOffer = new();
    private Candidates candidate = new();
    private VwLegalEntities vwLegal = new();
    private Requests request = new();

    private List<VwJobOfferWorkFlow> workFlow = new();
    private List<JOTabs> tabs = new();

    private List<VwSalaryMatrixBand> salaryBands = new();
    private List<Proposal> joProposals = new();
    private List<SalaryBandStatus> bandStatus = new();
    private List<VwCompensationBenefits> compensationItems = new();
    private List<DropdownDto> ddPackages = new();

    private string activeTab = "offers";
    private int userId = 0;
    private int selectedBandId = 0;
    private int selectedOptionNumber = 0;
    private int selectedPackageId = 0;

    protected override async Task OnInitializedAsync()
    {
        userId = await AccountService.GetJobOfferUserId();

        workFlow = await JODetailsService.GetJobOfferWorkFlow(jobOfferId);
        tabs = JODetailsService.SetTabs(workFlow);
        tabs[3].Show = true;

        jobOffer = await JODetailsService.GetJobOffer(jobOfferId);
        candidate = await JODetailsService.GetCandidate(jobOffer.CandidateId.GetValueOrDefault());
        request = await JODetailsService.GetRequest(jobOffer.RequestId.GetValueOrDefault());
        vwLegal = await JODetailsService.GetLegalEntity(jobOfferId);

        bandStatus = await JOAnalysisService.GetValidationStatus();
        ddPackages = await DropDownListService.GetCompBenPackages();
        salaryBands = await SalaryMatrixService.GetSalaryBandsByJOId(jobOfferId);
        selectedPackageId = ddPackages.FirstOrDefault()?.Id ?? 0;

        await OnPackageChange();

        var firstBand = salaryBands.FirstOrDefault();
        if (firstBand is not null)
            await OnSalaryBandChange(firstBand.Id);

        if (joProposals.Any())
            OnRecommendChange(joProposals.FirstOrDefault()?.OptionNum ?? 0);
    }

    private async Task SaveAllProposals()
    {
        if (!await AlertService.Confirm()) return;

        joProposals = JOAnalysisService.ReComputeAnalysis(joProposals, selectedBand, compensationItems);

        foreach (var item in joProposals)
        {
            item.Recommend = selectedOptionNumber == item.OptionNum;
            item.PackageId = selectedPackageId;
            item.Escalate = item.ProposeSalary > selectedBand.BandMaximum;
            item.CreatedBy = userId;
            item.CreatedAt = DateTime.Now;
        }

        await JOAnalysisService.SaveProposal(joProposals);

        Navigation.NavigateTo($"{JORoutes.Transaction.JobOffer}/{jobOfferId}");
    }

    private async Task OnPackageChange()
    {
        compensationItems = await JOAnalysisService.GetCompensationBenefits(selectedPackageId) ?? new();
    }

    private string SetCompBenItemValue(VwCompensationBenefits item)
    {
        if (item.Amount.HasValue)
            return UtilitiesService.ToCurrency(item.Amount, item.Currency);

        return item.ItemDescription ?? "";
    }

    private async Task OnSalaryBandChange(int bandId)
    {
        selectedBandId = bandId;
        selectedBand = salaryBands.FirstOrDefault(x => x.Id == selectedBandId);

        joProposals = JOAnalysisService.InitializeProposal(
            jobOfferId,
            selectedBandId,
            candidate.Salary.GetValueOrDefault(),
            selectedBand,
            compensationItems
        );
    }

    private void OnRecommendChange(int? optionNumber)
    {
        selectedOptionNumber = optionNumber.GetValueOrDefault();
    }

    private Proposal? GetSelectedProposal()
    {
        return joProposals.FirstOrDefault(jo => jo.OptionNum.GetValueOrDefault() == selectedOptionNumber);
    }

    private async Task ReComputeProposalAnalysis()
    {
        joProposals = JOAnalysisService.ReComputeAnalysis(joProposals, selectedBand, compensationItems);
        await AlertService.Success("Analysis recomputed successfully.");
    }

    private string BandStatusName(int? statusId)
    {
        return bandStatus.FirstOrDefault(jo => jo.Id == statusId)?.StatusName ?? "";
    }

    private bool IsRecommended(int? optionNumber)
    {
        return optionNumber.GetValueOrDefault() == selectedOptionNumber;
    }
}
