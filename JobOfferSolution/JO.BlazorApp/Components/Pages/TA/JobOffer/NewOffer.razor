@* @attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.NewOffer + "/{responseId:int}/{numProposal:int}")] *@

<div class="jo-content-page jo-analysis-page">
    <main class="jo-main">
        <header class="jo-analysis-card jo-analysis-header">
            <div>
                <span class="jo-eyebrow">TALENT ACQUISITIONS</span>
                <h1>Job Offer Analysis</h1>
                <p>Configure employment rules and compare job offer compensation options.</p>
            </div>
            <div class="jo-actions">
                
            </div>
        </header>

        <section class="jo-section">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">CANDIDATE</span>
                    <h2>Basic information</h2>
                    <p>Candidate, assignment, and reporting information.</p>
                </div>
            </div>

            <div class="jo-form-grid">
                <label>CANDIDATE NAME<input class="form-control" value="@candidate.CandidateFullName" /></label>
                <label>
                    DIVISION / DEPARTMENT
                    @* <select class="custom-select"><option>Consumer Health</option><option>Corporate Services</option></select> *@
                    <input class="form-control" value="@candidate.UnilabDivision" />
                </label>
                <label>
                    POSITION TITLE
                    @* <select class="custom-select"><option>Senior Product Manager</option><option>Product Manager</option></select> *@
                    <input class="form-control" value="@candidate.PositionAppliedFor" />
                </label>
                <label>
                    SALARY GRADE
                    <select class="custom-select"><option>SG 14</option><option>SG 13</option></select>
                </label>
                <label>
                    COMPANY
                    <select class="custom-select"><option>Unilab, Inc.</option><option>UL Skin Sciences, Inc.</option></select>
                </label>
                <label>IMMEDIATE SUPERIOR<input class="form-control" value="Maria Santos" /></label>
            </div>
        </section>

        <section class="jo-section jo-analysis-compensation">
            <div class="jo-section-heading">
                <div>
                    <span class="jo-label">CASH COMPENSATION</span>
                    <h2>Compensation comparison</h2>
                    <p>Monthly and annual values across the current package and proposed options.</p>
                </div>
                <label>
                    Compensation Template
                    <select class="custom-select">
                        @foreach (var item in pckgTemp)
                        {
                            <option value="@item.Id">@item.TempName</option>
                        }
                    </select>
                </label>
            </div>
        </section>
    </main>
</div>

@inject ICandidateService CandidateService
@inject IBenefitsService BenefitsService

@code {
    [Parameter] public int responseId { get; set; }
    [Parameter] public int numProposal { get; set; }

    private CandidateResponses candidate = new();
    private List<VwPckgTemp> pckgTemp = new();

    private sealed record CompensationRow(
        string Component, 
        string Current, 
        string Option1, 
        string Option2, 
        string Option3);

    protected override async Task OnInitializedAsync()
    {
        candidate = await CandidateService.GetCandidateResponse(responseId);
        pckgTemp = await BenefitsService.GetVwPckgTemp();
    }
}
