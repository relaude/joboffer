@attribute [Authorize(Roles = JOUserRole.TA)]
@attribute [Route(JORoutes.TA.JobOfferTracker)]

@inject IJODetailsService JODetailsService
@inject NavigationManager Navigation

<div class="card shadow mb-4 border-left-primary small">
    <div class="card-header py-3 bg-white">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between">
            <div>
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-table mr-2"></i>
                    Job Offers
                </h6>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-sm text-nowrap mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Reference Number</th>
                        <th>Candidate Name</th>
                        <th>Email</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jobOffer in jobOffers)
                    {
                        <tr>
                            <td>@jobOffer.RefNum</td>
                            <td>@jobOffer.CandidateName</td>
                            <td>@jobOffer.Email</td>
                            <td class="text-center">
                                <span class="badge badge-@jobOffer.BootstrapClass">@jobOffer.StatusName</span>
                            </td>
                            <td class="text-center">
                                <a href="@($"{JORoutes.Transaction.JobOffer}/{jobOffer.Id}")"
                                   class="btn btn-outline-primary btn-sm mr-1"
                                   title="Details">
                                    <i class="fas fa-eye fa-fw mr-1"></i>Details
                                </a>

                                <button class="btn btn-outline-info btn-sm mr-1"
                                        disabled="@(!(jobOffer.StatusId == JOStatus.Application.New))"
                                        @onclick="() => GoToPage(jobOffer.StatusId, jobOffer.Id)">
                                    <i class="fas fa-chart-line fa-fw mr-1"></i>New
                                </button>

                                <button class="btn btn-outline-info btn-sm mr-1"
                                        disabled="@(!(jobOffer.StatusId == JOStatus.Application.Approved))"
                                        @onclick="() => GoToPage(jobOffer.StatusId, jobOffer.Id)">
                                    <i class="fas fa-comments fa-fw mr-1"></i>Discussions
                                </button>

                                <button class="btn btn-outline-info btn-sm mr-1"
                                        disabled="@(!(jobOffer.StatusId == JOStatus.Application.Accepted))"
                                        @onclick="() => GoToPage(jobOffer.StatusId, jobOffer.Id)">
                                    <i class="fas fa-file-signature fa-fw mr-1"></i>Letter
                                </button>

                                @* @if (jobOffer.StatusId == JOStatus.Application.New)
                                {
                                    <a href="@($"{JORoutes.TA.NewOffer}/{jobOffer.Id}")"
                                       class="btn btn-outline-info btn-sm mr-1"
                                       title="New Offer">
                                        <i class="fas fa-chart-line fa-fw"></i>
                                    </a>
                                }

                                @if (jobOffer.StatusId == JOStatus.Application.Approved)
                                {
                                    <a href="@($"{JORoutes.TA.Discussion}/{jobOffer.Id}")"
                                       class="btn btn-outline-info btn-sm mr-1"
                                       title="Discussions">
                                        <i class="fas fa-comments fa-fw"></i>
                                    </a>
                                }

                                @if (jobOffer.StatusId == JOStatus.Application.Accepted)
                                {
                                    <a href="@($"{JORoutes.TA.Letter}/{jobOffer.Id}")"
                                       class="btn btn-outline-info btn-sm mr-1"
                                       title="Letter">
                                        <i class="fas fa-file-signature  fa-fw"></i>
                                    </a>
                                } *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<VwJobOffers> jobOffers = new();

    protected override async Task OnInitializedAsync()
    {
        jobOffers = await JODetailsService.GetJobOffers();
    }

    private void GoToPage(int? statusId, int id)
    {
        if (statusId == JOStatus.Application.New)
            Navigation.NavigateTo($"{JORoutes.TA.NewOffer}/{id}");

        if (statusId == JOStatus.Application.Approved)
            Navigation.NavigateTo($"{JORoutes.TA.Discussion}/{id}");

        if (statusId == JOStatus.Application.Accepted)
            Navigation.NavigateTo($"{JORoutes.TA.Letter}/{id}");
    }
}
